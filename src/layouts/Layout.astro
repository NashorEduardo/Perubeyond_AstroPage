---
import '../styles/global.css';
import { ui } from '../i18n/ui';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: 'es' | 'en' | 'pt';
  langAlternates?: { es?: string; en?: string; pt?: string };
}

const {
  title = 'Peru Beyond — Agencia de Tours en Cusco | Machu Picchu, Valle Sagrado y todo Perú',
  description = 'Agencia de viajes en Cusco con guías locales certificados. Tours a Machu Picchu, Valle Sagrado, Camino Inca y paquetes por todo Perú. Reserva segura y atención personalizada en español, inglés y portugués.',
  ogImage = '/images/PeruBeyond/Logo.png',
  lang = 'es',
  langAlternates,
} = Astro.props;

const siteBase = Astro.site ?? new URL('https://www.perubeyond.com');
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const ogImageAbs = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteBase).href;

// Si la página no provee alternates explícitos, los derivamos reemplazando
// solo el segmento de idioma dentro de Astro.url.pathname (mismo patrón que
// LanguageSwitcher.astro), así heredamos la barra final tal cual la sirve
// Astro y coincide byte a byte con canonicalURL. No aplica a páginas fuera
// del esquema /es|en|pt/... (ej. /landing).
const pathParts = Astro.url.pathname.split('/');
const isLocalized = pathParts[1] === 'es' || pathParts[1] === 'en' || pathParts[1] === 'pt';
const buildAlternate = (code: string) => {
  const parts = [...pathParts];
  parts[1] = code;
  return `${siteBase.origin}${parts.join('/')}`;
};
const resolvedAlternates = langAlternates ?? (isLocalized ? {
  es: buildAlternate('es'),
  en: buildAlternate('en'),
  pt: buildAlternate('pt'),
} : undefined);
const htmlLang = lang === 'pt' ? 'pt-BR' : lang;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Peru Beyond" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <!-- hreflang para el sitio multilingüe -->
    {resolvedAlternates?.es && <link rel="alternate" hreflang="es" href={resolvedAlternates.es} />}
    {resolvedAlternates?.en && <link rel="alternate" hreflang="en" href={resolvedAlternates.en} />}
    {resolvedAlternates?.pt && <link rel="alternate" hreflang="pt-BR" href={resolvedAlternates.pt} />}
    {resolvedAlternates && <link rel="alternate" hreflang="x-default" href={resolvedAlternates.es ?? canonicalURL.href} />}
    <link rel="icon" href="/images/PeruBeyond/Gallito_PeruBeyond_nobg.webp" type="image/webp" />
    <link rel="apple-touch-icon" href="/images/PeruBeyond/Gallito_PeruBeyond_nobg.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Satisfy&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Satisfy&display=swap" /></noscript>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" /></noscript>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" /></noscript>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" /></noscript>
    <!-- Schema.org: Organization + LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["TravelAgency", "LocalBusiness"],
      "name": "Peru Beyond",
      "alternateName": "MOTOANDES PERU E.I.R.L.",
      "url": "https://www.perubeyond.com",
      "logo": "https://www.perubeyond.com/images/PeruBeyond/Logo.webp",
      "image": "https://www.perubeyond.com/images/PeruBeyond/Logo.webp",
      "description": "Agencia de viajes en Cusco especializada en tours a Machu Picchu, Valle Sagrado, trekking y paquetes por todo el Perú. Guías locales certificados y experiencias personalizadas.",
      "telephone": "+51943491959",
      "email": "info@perubeyond.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Calle Zetas 109",
        "addressLocality": "Cusco",
        "postalCode": "08002",
        "addressCountry": "PE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -13.516,
        "longitude": -71.978
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "08:00",
        "closes": "20:00"
      },
      "priceRange": "$$",
      "sameAs": [
        "https://www.facebook.com/perubeyond",
        "https://www.instagram.com/perubeyond/",
        "https://www.tiktok.com/@perubeyond_agency",
        "https://www.youtube.com/@perubeyond",
        "https://www.tripadvisor.com.pe/Attraction_Review-g294314-d33404487-Reviews-Peru_Beyond-Cusco_Cusco_Region.html"
      ]
    })} />
    <slot name="head" />
    <!-- i18n: embed translations & apply on load -->
    <script define:vars={{ i18nData: ui, currentLang: lang }} is:inline>
      window.__pb_i18n = i18nData;
      window.__pb_lang = currentLang;

      window.__pb_applyLang = function (lang) {
        var t = window.__pb_i18n[lang] || window.__pb_i18n['es'];
        document.querySelectorAll('[data-i18n]').forEach(function (el) {
          var key = el.getAttribute('data-i18n');
          if (t[key] !== undefined) el.textContent = t[key];
        });
        var flagEl = document.getElementById('lang-flag');
        var codeEl = document.getElementById('lang-code');
        var map = { es: { flag: '🇵🇪', code: 'ES' }, en: { flag: '🇺🇸', code: 'EN' }, pt: { flag: '🇧🇷', code: 'PT' } };
        if (flagEl && map[lang]) flagEl.textContent = map[lang].flag;
        if (codeEl && map[lang]) codeEl.textContent = map[lang].code;
      };

      document.addEventListener('DOMContentLoaded', function () {
        // El idioma ya viene fijado por la URL (/es|en|pt/...), lo persistimos
        // solo para que el selector recuerde la preferencia en /landing.
        localStorage.setItem('pb_lang', currentLang);
        window.__pb_applyLang(currentLang);
      });
    </script>
  </head>
  <body class="bg-white">
    <slot />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
  </body>
</html>
