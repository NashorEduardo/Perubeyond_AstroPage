---
import '../styles/global.css';
import { getStorageStatus } from '../lib/cms-storage';

export interface Props {
  title?: string;
  activeTab?: 'dashboard' | 'tours' | 'blogs' | 'settings';
}

const { title = 'Panel de Administración', activeTab = 'dashboard' } = Astro.props;
const storage = getStorageStatus();
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Peru Beyond CMS Admin</title>
    <link rel="icon" href="/images/PeruBeyond/Gallito_PeruBeyond_nobg.webp" type="image/webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  </head>
  <body class="bg-[#0B1320] text-slate-100 font-['Jost',sans-serif] min-h-screen flex flex-col md:flex-row antialiased selection:bg-[#c9a84c] selection:text-slate-900">
    
    <!-- Mobile Header -->
    <header class="md:hidden bg-[#0D1B2E] border-b border-slate-800 px-4 py-3 flex items-center justify-between sticky top-0 z-40">
      <div class="flex items-center gap-3">
        <img src="/images/PeruBeyond/Logo.png" alt="Peru Beyond" class="h-8 w-auto object-contain" />
        <span class="text-xs font-semibold px-2 py-0.5 rounded bg-[#c9a84c]/20 text-[#f6d06a] border border-[#c9a84c]/40">CMS Admin</span>
      </div>
      <button id="mobile-menu-btn" class="text-slate-300 hover:text-white p-2 rounded-lg bg-slate-800" aria-label="Abrir menú">
        <i class="bi bi-list text-2xl"></i>
      </button>
    </header>

    <!-- Sidebar Backdrop for Mobile -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-black/60 z-40 hidden md:hidden transition-opacity"></div>

    <!-- Sidebar Navigation -->
    <aside id="admin-sidebar" class="fixed inset-y-0 left-0 w-64 bg-[#0D1B2E] border-r border-slate-800 flex flex-col z-50 transform -translate-x-full md:translate-x-0 transition-transform duration-200 ease-in-out md:static md:h-screen md:sticky md:top-0">
      
      <!-- Brand Header -->
      <div class="p-5 border-b border-slate-800/80 flex items-center justify-between">
        <a href="/admin" class="flex items-center gap-3 group">
          <img src="/images/PeruBeyond/Logo.png" alt="Peru Beyond" class="h-9 w-auto object-contain group-hover:scale-105 transition-transform" />
          <div>
            <div class="font-bold text-base tracking-wide text-white">Peru Beyond</div>
            <div class="text-[11px] font-medium tracking-wider text-[#c9a84c] uppercase">Admin CMS</div>
          </div>
        </a>
        <button id="close-sidebar-btn" class="md:hidden text-slate-400 hover:text-white p-1">
          <i class="bi bi-x-lg text-lg"></i>
        </button>
      </div>

      <!-- Navigation Links -->
      <nav class="flex-1 px-3 py-5 space-y-1.5 overflow-y-auto">
        <div class="px-3 pb-2 text-[11px] font-semibold tracking-wider text-slate-400 uppercase">Gestión de Contenido</div>

        <a
          href="/admin"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all ${
            activeTab === 'dashboard'
              ? 'bg-[#c9a84c] text-slate-950 font-semibold shadow-lg shadow-[#c9a84c]/20'
              : 'text-slate-300 hover:bg-slate-800/80 hover:text-white'
          }`}
        >
          <i class="bi bi-speedometer2 text-lg"></i>
          <span>Dashboard</span>
        </a>

        <a
          href="/admin/tours"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all ${
            activeTab === 'tours'
              ? 'bg-[#c9a84c] text-slate-950 font-semibold shadow-lg shadow-[#c9a84c]/20'
              : 'text-slate-300 hover:bg-slate-800/80 hover:text-white'
          }`}
        >
          <i class="bi bi-compass text-lg"></i>
          <span>Tours & Paquetes</span>
        </a>

        <a
          href="/admin/blogs"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all ${
            activeTab === 'blogs'
              ? 'bg-[#c9a84c] text-slate-950 font-semibold shadow-lg shadow-[#c9a84c]/20'
              : 'text-slate-300 hover:bg-slate-800/80 hover:text-white'
          }`}
        >
          <i class="bi bi-newspaper text-lg"></i>
          <span>Artículos de Blog</span>
        </a>

        <div class="pt-5 pb-2 px-3 text-[11px] font-semibold tracking-wider text-slate-400 uppercase">Enlaces & Cuenta</div>

        <a
          href="/es"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800/80 hover:text-white transition-all group"
        >
          <div class="flex items-center gap-3">
            <i class="bi bi-globe text-lg text-emerald-400"></i>
            <span>Ver Sitio Web</span>
          </div>
          <i class="bi bi-arrow-up-right text-xs text-slate-500 group-hover:text-slate-300"></i>
        </a>

        <button
          id="logout-btn"
          type="button"
          class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-red-400 hover:bg-red-500/10 hover:text-red-300 transition-all text-left"
        >
          <i class="bi bi-box-arrow-right text-lg"></i>
          <span>Cerrar Sesión</span>
        </button>
      </nav>

      <!-- Storage Status Footer -->
      <div class="p-4 border-t border-slate-800 bg-[#0A1422]/60">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-2">Persistencia</div>
        {storage.mode === 'github' ? (
          <div class="flex items-start gap-2 text-xs text-amber-300 bg-amber-500/10 border border-amber-500/20 p-2.5 rounded-lg">
            <i class="bi bi-github text-base mt-0.5"></i>
            <div class="overflow-hidden">
              <div class="font-semibold text-white">GitHub API</div>
              <div class="truncate text-[11px] text-amber-300/80" title={`${storage.owner}/${storage.repo} (${storage.branch})`}>
                {storage.repo}:{storage.branch}
              </div>
            </div>
          </div>
        ) : (
          <div class="flex items-start gap-2 text-xs text-emerald-300 bg-emerald-500/10 border border-emerald-500/20 p-2.5 rounded-lg">
            <i class="bi bi-hdd-fill text-base mt-0.5"></i>
            <div>
              <div class="font-semibold text-white">Modo Local</div>
              <div class="text-[11px] text-emerald-300/80">Archivos locales en disco</div>
            </div>
          </div>
        )}
      </div>
    </aside>

    <!-- Main Content Container -->
    <div class="flex-1 flex flex-col min-w-0">
      
      <!-- Topbar Header -->
      <header class="bg-[#0D1B2E]/80 backdrop-blur border-b border-slate-800 px-6 py-3.5 flex items-center justify-between sticky top-0 z-30">
        <div class="flex items-center gap-3">
          <h1 class="text-lg font-semibold text-white tracking-wide">{title}</h1>
        </div>

        <div class="flex items-center gap-3">
          <!-- Persistence Pill -->
          <span class={`hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border ${
            storage.mode === 'github'
              ? 'bg-amber-500/10 text-amber-300 border-amber-500/30'
              : 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30'
          }`}>
            <span class={`w-1.5 h-1.5 rounded-full ${storage.mode === 'github' ? 'bg-amber-400 animate-pulse' : 'bg-emerald-400'}`}></span>
            {storage.mode === 'github' ? 'GitHub Cloud' : 'Disco Local'}
          </span>

          <!-- Admin Avatar Pill -->
          <div class="flex items-center gap-2 pl-3 border-l border-slate-800">
            <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#c9a84c] to-[#f6d06a] text-slate-950 font-bold flex items-center justify-center text-xs shadow">
              PB
            </div>
            <div class="hidden lg:block text-left">
              <div class="text-xs font-semibold text-white leading-tight">Admin</div>
              <div class="text-[10px] text-slate-400 leading-tight">Peru Beyond</div>
            </div>
          </div>
        </div>
      </header>

      <!-- Page Body -->
      <main class="flex-1 p-4 md:p-8 max-w-7xl w-full mx-auto">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="border-t border-slate-800/80 px-6 py-4 text-center text-xs text-slate-500">
        Peru Beyond CMS &bull; Desarrollado para gestión ágil y alto rendimiento &bull; Vercel Serverless
      </footer>
    </div>

    <!-- Toast Notifications Container -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none max-w-sm w-full"></div>

    <!-- Scripts -->
    <script is:inline>
      // Toast notification helper
      window.showToast = function(message, type = 'success', duration = 3500) {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl shadow-xl border text-sm transition-all transform duration-300 translate-y-3 opacity-0 ${
          type === 'error'
            ? 'bg-red-950/90 border-red-500/40 text-red-200 shadow-red-950/40'
            : type === 'info'
            ? 'bg-blue-950/90 border-blue-500/40 text-blue-200 shadow-blue-950/40'
            : 'bg-emerald-950/90 border-emerald-500/40 text-emerald-200 shadow-emerald-950/40'
        }`;

        const iconClass = type === 'error' ? 'bi-x-circle-fill text-red-400' : type === 'info' ? 'bi-info-circle-fill text-blue-400' : 'bi-check-circle-fill text-emerald-400';

        toast.innerHTML = `
          <i class="bi ${iconClass} text-lg"></i>
          <span class="flex-1 leading-snug">${message}</span>
          <button type="button" class="text-slate-400 hover:text-white p-1 ml-2 text-xs">&times;</button>
        `;

        container.appendChild(toast);

        // Animate in
        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-3', 'opacity-0');
          toast.classList.add('translate-y-0', 'opacity-100');
        });

        const closeBtn = toast.querySelector('button');
        const dismiss = () => {
          toast.classList.add('opacity-0', 'translate-y-2');
          setTimeout(() => toast.remove(), 300);
        };

        if (closeBtn) closeBtn.onclick = dismiss;
        setTimeout(dismiss, duration);
      };

      // Logout handler
      const logoutBtn = document.getElementById('logout-btn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          if (!confirm('¿Deseas cerrar tu sesión como administrador?')) return;
          try {
            const res = await fetch('/api/admin/auth', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'logout' }),
            });
            window.location.href = '/admin/login';
          } catch (e) {
            window.location.href = '/admin/login';
          }
        });
      }

      // Mobile drawer toggle
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const closeSidebarBtn = document.getElementById('close-sidebar-btn');
      const sidebar = document.getElementById('admin-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');

      function openDrawer() {
        sidebar?.classList.remove('-translate-x-full');
        backdrop?.classList.remove('hidden');
      }

      function closeDrawer() {
        sidebar?.classList.add('-translate-x-full');
        backdrop?.classList.add('hidden');
      }

      mobileBtn?.addEventListener('click', openDrawer);
      closeSidebarBtn?.addEventListener('click', closeDrawer);
      backdrop?.addEventListener('click', closeDrawer);
    </script>
  </body>
</html>
