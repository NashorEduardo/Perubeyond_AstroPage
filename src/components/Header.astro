---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-transparent">
  <div class="w-full max-w-[1560px] mx-auto px-5 xl:px-8 2xl:px-10 flex items-center justify-between py-6 relative">

    <!-- Logo -->
    <a href={`/${lang}`} class="flex items-center flex-shrink-0">
      <img id="header-logo"
           src="/images/PeruBeyond/Logo.webp"
           alt="Peru Beyond"
           width="160"
           class="transition-all duration-300" />
    </a>

    <!-- Nav Desktop -->
    <nav class="hidden lg:flex items-center h-full" aria-label="Menú principal">
      {menu.map(m => (
        <div class="group h-full flex items-center relative">
          <a href={m.href}
             class="header-link font-bold text-[13px] tracking-wider px-5 py-2 transition-all duration-300 text-white hover:text-gold flex items-center gap-1.5 rounded-lg hover:bg-white/10"
             aria-haspopup="true">
            <span data-i18n={m.navKey}>{m.label}</span>
            <i class="bi bi-chevron-down text-[9px] transition-transform duration-300 group-hover:rotate-180 opacity-60" aria-hidden="true"></i>
          </a>

          <div class={`mega-dropdown pt-1
            opacity-0 invisible pointer-events-none
            group-hover:opacity-100 group-hover:visible group-hover:pointer-events-auto
            group-focus-within:opacity-100 group-focus-within:visible group-focus-within:pointer-events-auto
            transition-all duration-300 ease-out
            translate-y-2 group-hover:translate-y-0 group-focus-within:translate-y-0
            ${(m.type === 'mega-peru' || m.type === 'mega-activities')
              ? 'fixed top-[50px] left-1/2 -translate-x-1/2 w-[980px]'
              : 'absolute top-[100%] left-1/2 -translate-x-1/2'}`}>

            <!-- ══════════════════════════════
                    TOURS PERÚ 
            ══════════════════════════════ -->
            {m.type === 'mega-peru' && (
              <div class="w-[860px] bg-white rounded-[28px] shadow-2xl border border-gray-100 overflow-hidden">
                <div class="grid grid-cols-5 gap-0">
                  
                  <div class="col-span-2 relative h-full min-h-[340px] group/feat overflow-hidden">
                    {/* Tomamos la primera imagen del array para el fondo */}
                    {m.details.images && m.details.images.length > 0 && (
                      <img
                        src={m.details.images[0].src}
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover/feat:scale-105"
                        alt={imageAlts.toursInCity[lang](m.details.images[0].label)}
                        loading="lazy"
                      />
                    )}
                    
                    {/* Degradado oscuro para que el texto sea legible */}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
                    
                    {/* Contenido de texto alineado abajo */}
                    <div class="absolute inset-0 flex flex-col justify-end p-7 z-10">
                      <span class="text-gold text-[10px] font-bold uppercase tracking-widest mb-2 block" data-i18n="mega.peru.badge">
                        Paquetes Perú
                      </span>
                      
                      <h3 class="text-white text-xl font-extrabold mb-2 leading-tight" data-i18n="mega.peru.title">
                        {m.details.title}
                      </h3>
                      
                      <p class="text-white/70 text-xs leading-relaxed mb-4" data-i18n="mega.peru.desc">
                        {m.details.desc}
                      </p>

                      <a href={`/${lang}/tours`} class="inline-flex items-center gap-2 text-gold text-xs font-bold hover:gap-4 transition-all">
                        <span data-i18n="mega.peru.discover">Descubrir</span>
                        <i class="bi bi-arrow-right"></i>
                      </a>
                    </div>
                  </div>

                  <div class="col-span-3 p-7 flex flex-col bg-white">
                    <p class="text-gray-400 text-xs uppercase tracking-widest font-semibold mb-5" data-i18n="mega.peru.featured">
                      Destinos destacados
                    </p>

                    <div class="overflow-y-auto max-h-[340px] space-y-2 pr-2 scrollbar-thin scrollbar-thumb-gray-200 scrollbar-track-transparent hover:scrollbar-thumb-gray-300">
                      {m.details.links.map((link, index) => {
                        const text = link.n || "";
                        const match = text.match(/(.+?)(\d+\s*días?[\s\/]*\d+\s*noches?.*)$/i);
                        const name = match ? match[1].trim().replace(/[-–]\s*$/, "") : text;
                        const duration = match ? match[2].trim() : "";
                        
                        const thumbnailImg = m.details.images && m.details.images.length > 0 
                          ? m.details.images[index % m.details.images.length].src 
                          : "";

                        return (
                          <a 
                            href={link.h || "#"} 
                            class="flex items-center gap-4 p-3 rounded-2xl hover:bg-gray-50 transition-colors group/tour border border-transparent hover:border-gray-100"
                          >
                            <div class="relative w-14 h-14 rounded-xl overflow-hidden flex-shrink-0 bg-gray-100">
                              {thumbnailImg && (
                                <img 
                                  src={thumbnailImg} 
                                  class="w-full h-full object-cover transition-transform duration-500 group-hover/tour:scale-110" 
                                  alt={name} 
                                  loading="lazy" 
                                />
                              )}
                            </div>
                            
                            <div class="flex-1 min-w-0">
                              <p class="text-navy font-bold text-sm group-hover/tour:text-gold transition-colors truncate">
                                {name}
                              </p>
                              {duration && (
                                <p class="text-gray-400 text-xs mt-0.5 flex items-center gap-1">
                                  <i class="bi bi-calendar3 text-gold"></i> {duration}
                                </p>
                              )}
                            </div>
                            
                            <i class="bi bi-arrow-right text-gray-300 group-hover/tour:text-gold group-hover/tour:translate-x-1 transition-all flex-shrink-0"></i>
                          </a>
                        );
                      })}
                    </div>

                    <div class="mt-4 pt-4 border-t border-gray-100">
                      <a
                        href={`/${lang}/tours`}
                        class="flex items-center justify-between text-sm text-gray-500 hover:text-gold transition-colors font-medium group"
                      >
                        <span data-i18n="mega.peru.cta">Ver todos los paquetes a Perú</span>
                        <i class="bi bi-arrow-right transition-transform group-hover:translate-x-1"></i>
                      </a>
                    </div>
                  </div>

                </div>
              </div>
            )}






            <!-- ══════════════════════════════
                 ACTIVIDADES
            ══════════════════════════════ -->
            {m.type === 'mega-activities' && (
              <div class="w-[820px] bg-white rounded-[28px] shadow-2xl border border-gray-100 overflow-hidden">

                <!-- Header bar navy -->
                <div class="bg-navy px-8 py-5 flex items-center justify-between">
                  <div>
                    <span class="text-gold text-[10px] font-bold uppercase tracking-widest block mb-1">
                      {m.details.badge}
                    </span>
                    <h3 class="text-white text-xl font-extrabold leading-tight">{m.details.title}</h3>
                    <p class="text-white/55 text-xs mt-0.5">{m.details.desc}</p>
                  </div>
                  <a href={`/${lang}/actividades`}
                     class="bg-gold/15 border border-gold/40 text-gold text-xs font-bold px-4 py-2 rounded-full hover:bg-gold hover:text-navy transition-all whitespace-nowrap">
                    VER TODAS →
                  </a>
                </div>

                <!-- 3 image cards -->
                <div class="grid grid-cols-3 gap-0">
                  {m.details.categories.map((cat, i) => (
                    <a href={cat.href || `/${lang}/actividades`}
                       class={`relative h-[250px] overflow-hidden group/card cursor-pointer ${i < 2 ? 'border-r border-white/20' : ''}`}>
                      {cat.img && (
                        <img src={cat.img}
                             class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover/card:scale-110"
                             alt={cat.label}
                             loading="lazy" />
                      )}
                      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/5"></div>
                      <div class="absolute inset-0 bg-gold/0 group-hover/card:bg-gold/10 transition-colors duration-500"></div>
                      <div class="absolute inset-0 flex flex-col justify-end p-5">
                        <span class="text-gold text-[9px] font-bold uppercase tracking-widest mb-1.5 flex items-center gap-1">
                          <i class={`bi ${cat.icon} text-xs`}></i> {cat.label}
                        </span>
                        <h4 class="text-white text-sm font-bold leading-snug mb-1.5 drop-shadow-lg">
                          {cat.activities[0]?.name}
                        </h4>
                        <p class="text-white/65 text-[10px] flex items-center gap-1">
                          <i class="bi bi-clock text-gold text-xs"></i> {cat.activities[0]?.price}
                        </p>
                        <div class="w-6 h-0.5 bg-gold mt-2.5 group-hover/card:w-10 transition-all duration-500"></div>
                      </div>
                    </a>
                  ))}
                </div>

                <!-- Footer bar -->
                <div class="px-8 py-3.5 border-t border-gray-100 bg-gray-50 flex items-center justify-between">
                  <span class="text-gray-400 text-xs flex items-center gap-1.5">
                    <i class="bi bi-geo-alt text-gold text-sm"></i>
                    Todas las actividades disponibles en Lima, Perú
                  </span>
                  <a href={`/${lang}/actividades`}
                     class="text-gold text-xs font-bold flex items-center gap-1 hover:gap-2.5 transition-all">
                    VER TODAS <i class="bi bi-arrow-right"></i>
                  </a>
                </div>

              </div>
            )}

            <!-- ══════════════════════════════
                 TOUR CUSCO
            ══════════════════════════════ -->
            {m.type === 'mega-cusco' && (
              <div class="w-[860px] bg-white rounded-[28px] shadow-2xl overflow-hidden border border-gray-100">

                <div class="px-8 pt-7 pb-5 flex items-end justify-between border-b border-gray-100">
                  <div>
                    <span class="text-gold text-[10px] font-bold uppercase tracking-widest block mb-1" data-i18n="mega.cusco.badge">
                      Destinos
                    </span>
                    <h3 class="text-navy text-xl font-extrabold leading-tight" data-i18n="mega.cusco.title">
                      Explora Cusco
                    </h3>
                  </div>
                  <a href={`/${lang}/tours/cusco`}
                    class="text-gray-400 hover:text-gold text-xs font-semibold flex items-center gap-1.5 transition-colors">
                    <span data-i18n="mega.cusco.see_all">Ver todos</span>
                    <i class="bi bi-arrow-right"></i>
                  </a>
                </div>

                <div class="grid grid-cols-3 gap-0">
                  {m.details.categories.map((cat, i) => (
                    <div class={`relative h-[360px] overflow-hidden group/card cursor-pointer
                                ${i < 2 ? 'border-r border-white/20' : ''}`}>

                      <img src={cat.img}
                          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover/card:scale-110"
                          alt={cat.title}
                          loading="lazy" />

