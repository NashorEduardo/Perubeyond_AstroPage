</header>

<!-- ══════════════════════════════
     MENÚ MÓVIL
══════════════════════════════ -->
<div id="mobile-menu"
     class="fixed inset-0 bg-navy z-[60] flex flex-col transition-all duration-500 translate-x-full lg:hidden overflow-y-auto">

  <div class="flex justify-between items-center px-8 py-6 border-b border-white/10">
    <img src="/images/PeruBeyond/Logo.webp"
         alt="Peru Beyond" width="120" class="brightness-0 invert" />
    <button id="close-menu-btn" class="text-white text-3xl p-1" aria-label="Cerrar menú">
      <i class="bi bi-x" aria-hidden="true"></i>
    </button>
  </div>

  <nav class="flex-1 px-6 py-6 space-y-1" aria-label="Menú móvil">
    {menu.map((m, i) => (
      <div class="mobile-item border-b border-white/10">
        <button
          class="mobile-trigger w-full flex items-center justify-between py-4 text-white text-base font-black uppercase tracking-tight hover:text-gold transition-colors"
          data-index={String(i)}
          aria-expanded="false">
          <span data-i18n={m.navKey}>{m.label}</span>
          <i class="bi bi-chevron-down text-xs text-white/40 transition-transform duration-300" aria-hidden="true"></i>
        </button>
        <div class="mobile-submenu overflow-hidden max-h-0 transition-all duration-400">
          <div class="pb-4 pl-2 space-y-2">
            {m.type === 'mega-peru' && m.details.links.map(l => (
              <a href={l.h || "#"} class="block text-white/60 hover:text-gold text-sm py-1.5 transition-colors">{l.n}</a>
            ))}
            {m.type === 'mega-machu' && m.details.tours.map(t => (
              <a href={t.href} class="flex items-center justify-between text-white/60 hover:text-gold text-sm py-1.5 transition-colors">
                {t.name} <span class="text-xs text-white/30">{t.duration}</span>
              </a>
            ))}
            {m.type === 'mega-cusco' && m.details.categories.map(cat => (
              <div class="mb-3">
                <p class="text-gold text-[10px] uppercase tracking-widest font-bold mb-1">{cat.title}</p>
                {cat.tours.map(t => (
                  <a href={t.href} class="block text-white/60 hover:text-gold text-sm py-1 pl-2 transition-colors">{t.name}</a>
                ))}
              </div>
            ))}
            {m.type === 'mega-activities' && m.details.categories.map((cat: ActivityCategory) => (
              <a href={cat.href || `/${lang}/actividades`} class="flex items-center gap-3 text-white/60 hover:text-gold text-sm py-2 pl-2 transition-colors">
                <i class={`bi ${cat.icon} text-xs text-gold`}></i>
                <span class="flex-1">{cat.activities[0]?.name}</span>
                <span class="text-xs text-white/30">{cat.activities[0]?.price}</span>
              </a>
            ))}
            {m.type === 'mega-brand' && m.details.links.map(l => (
              <a href={l.h} class="flex items-center gap-2 text-white/60 hover:text-gold text-sm py-1.5 transition-colors">
                <i class={`bi ${l.icon} text-xs`}></i>
                <span data-i18n={l.i18n}>{l.n}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    ))}
  </nav>

  <div class="px-8 py-6 border-t border-white/10 space-y-3">
    <p class="text-gold font-bold uppercase text-[10px] tracking-widest" data-i18n="cta.contact_us">Contáctanos</p>
    <a href="tel:+51943491959" class="flex items-center gap-2 text-white font-bold text-lg">
      <i class="bi bi-telephone-fill text-gold text-sm"></i> +51 943 491 959
    </a>
    <a href="https://wa.me/51943491959" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp"
       class="flex items-center gap-2 bg-green-700 hover:bg-green-800 text-white font-bold px-5 py-3 rounded-xl text-sm justify-center transition-colors">
      <i class="bi bi-whatsapp" aria-hidden="true"></i>
      <span data-i18n="cta.whatsapp">WhatsApp directo</span>
    </a>
  </div>
</div>

<script is:inline>
  const header     = document.getElementById('main-header');
  const links      = document.querySelectorAll('.header-link');
  const phone      = document.querySelector('.header-phone');
  const burger     = document.querySelector('.header-burger');
  const logo       = document.getElementById('header-logo');
  const mobileMenu = document.getElementById('mobile-menu');
  const openBtn    = document.getElementById('mobile-menu-btn');
  const closeBtn   = document.getElementById('close-menu-btn');

  function onScroll() {
    const scrolled = window.scrollY > 60;
    header.classList.toggle('bg-white',       scrolled);
    header.classList.toggle('shadow-md',      scrolled);
    header.classList.toggle('bg-transparent', !scrolled);
    links.forEach(l => {
      l.classList.toggle('text-white', !scrolled);
      l.classList.toggle('text-navy',   scrolled);
    });
    if (phone)  { phone.classList.toggle('text-white',  !scrolled); phone.classList.toggle('text-navy',  scrolled); }
    if (burger) { burger.classList.toggle('text-white', !scrolled); burger.classList.toggle('text-navy', scrolled); }
    if (logo)   { logo.classList.toggle('brightness-0', !scrolled); logo.classList.toggle('invert', !scrolled); }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  openBtn?.addEventListener('click', () => {
    mobileMenu?.classList.remove('translate-x-full');
    openBtn.setAttribute('aria-expanded', 'true');
    openBtn.setAttribute('aria-label', 'Cerrar menú');
  });
  closeBtn?.addEventListener('click', () => {
    mobileMenu?.classList.add('translate-x-full');
    openBtn?.setAttribute('aria-expanded', 'false');
    openBtn?.setAttribute('aria-label', 'Abrir menú');
  });

  document.querySelectorAll('.mobile-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const item    = btn.closest('.mobile-item');
      const submenu = item?.querySelector('.mobile-submenu');
      const icon    = btn.querySelector('i');
      const isOpen  = submenu?.style.maxHeight && submenu.style.maxHeight !== '0px';

      document.querySelectorAll('.mobile-submenu').forEach(s => s.style.maxHeight = '0px');
      document.querySelectorAll('.mobile-trigger i').forEach(i => i.style.transform = '');
      document.querySelectorAll('.mobile-trigger').forEach(b => b.setAttribute('aria-expanded', 'false'));

      if (!isOpen && submenu) {
        submenu.style.maxHeight = submenu.scrollHeight + 'px';
        if (icon) icon.style.transform = 'rotate(180deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
