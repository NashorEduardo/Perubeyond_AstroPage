---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { imageAlts } from '../i18n/imageAlts';

interface Props {
  lang?: 'es' | 'en' | 'pt';
}
const { lang = 'es' } = Astro.props;

// Prefija con /{lang} cualquier href/h interno (que empiece con "/" y no sea un asset)
// dentro de una estructura de datos anidada (arrays/objetos), en el lugar.
function localizeLinks(node: unknown, lang: string): void {
  if (Array.isArray(node)) {
    node.forEach((item) => localizeLinks(item, lang));
  } else if (node && typeof node === 'object') {
    const obj = node as Record<string, unknown>;
    for (const key of Object.keys(obj)) {
      const val = obj[key];
      if ((key === 'href' || key === 'h') && typeof val === 'string' && val.startsWith('/') && !val.startsWith('/images')) {
        obj[key] = val === '/' ? `/${lang}` : `/${lang}${val}`;
      } else if (val && typeof val === 'object') {
        localizeLinks(val, lang);
      }
    }
  }
}

interface PeruLink  { n: string; h: string }
interface MachuTour { name: string; duration: string; img: string; href: string }
interface CuscoTour { name: string; href: string }
interface BrandLink { n: string; h: string; icon: string; i18n: string }
interface ActivityItem { name: string; difficulty: 'EXTREMO' | 'MODERADO' | 'SUAVE'; price: string; href: string }
interface ActivityCategory { label: string; icon: string; img?: string; href?: string; count: string; activities: ActivityItem[] }

interface MegaActivitiesItem {
  label: string; navKey: string; href: string; type: 'mega-activities';
  details: { badge: string; title: string; desc: string; totalActivities: string; destinations: string; categories: ActivityCategory[] };
}

interface MegaPeruItem {
  label: string; navKey: string; href: string; type: 'mega-peru';
  details: { title: string; desc: string; links: PeruLink[]; images: { src: string; label: string }[] };
}
interface MegaMachuItem {
  label: string; navKey: string; href: string; type: 'mega-machu';
  details: { featured: { title: string; desc: string; img: string; href: string }; tours: MachuTour[] };
}
interface MegaCuscoItem {
  label: string; navKey: string; href: string; type: 'mega-cusco';
  details: { categories: { title: string; img: string; tours: CuscoTour[] }[] };
}
interface MegaBrandItem {
  label: string; navKey: string; href: string; type: 'mega-brand';
  details: { links: BrandLink[]; contact: { phone: string; email: string; whatsapp: string }; image: string; tagline: string };
