---
const PLACE_ID = 'ChIJK_vMJWBfiioRH9_2oYWbNhY';

const reviews = [
  {
    name: 'Daniela Britsia',
    initials: 'DB',
    color: '#8B7355',
    time: 'Hace 2 días',
    text: 'Reservamos nuestros tours con esta agencia y fue la mejor decisión. Todo estuvo perfectamente organizado, las guías fueron muy profesionales y conocedoras. Machu Picchu superó todas nuestras expectativas. ¡Definitivamente volveremos con Peru Beyond!',
    photo: null,
  },
  {
    name: 'Gaby Caso',
    initials: 'GC',
    color: '#5B8A6F',
    time: 'Hace 3 días',
    text: 'Tuve una experiencia excelente con Peru Beyond. La gira al Lago Titicaca estuvo muy bien organizada, fue interesante y muy agradable. El guía habló perfecto inglés y español, explicando cada detalle histórico con gran pasión.',
    photo: null,
  },
  {
    name: 'Carlos Deza',
    initials: 'CD',
    color: '#2E7D6B',
    time: 'Hace 1 semana',
    text: '¡Una joya culinaria en Cusco! Nos llevaron a los mejores restaurantes locales y mercados tradicionales. La experiencia gastronómica fue increíble, combinada perfectamente con el tour cultural. Superó todas nuestras expectativas.',
    photo: null,
  },
  {
    name: 'María Rodríguez',
    initials: 'MR',
    color: '#C0392B',
    time: 'Hace 2 semanas',
    text: 'El tour por el Valle Sagrado fue simplemente mágico. Los paisajes son impresionantes y la guía nos contó historias fascinantes sobre la civilización inca. El transporte fue cómodo y puntual en todo momento. Altamente recomendado.',
    photo: null,
  },
  {
    name: 'Javier Morales',
    initials: 'JM',
    color: '#1A5276',
    time: 'Hace 3 semanas',
    text: 'Elegimos Peru Beyond para nuestra aventura en la Amazonía y fue una elección perfecta. El lodge fue cómodo, la fauna increíble y nuestro guía, Carlos, un experto apasionado. Una experiencia transformadora que no olvidaremos nunca.',
    photo: null,
  },
  {
    name: 'Sofía Fernández',
    initials: 'SF',
    color: '#6C3483',
    time: 'Hace 1 mes',
    text: 'Peru Beyond organizó nuestro tour de 10 días por todo el país y fue impecable. Desde Lima hasta Cusco, cada detalle fue cuidado. Los hoteles seleccionados fueron excelentes y las experiencias culturales únicas. ¡Gracias por el viaje de nuestras vidas!',
    photo: null,
  },
];

const totalReviews = 128;
---

<section class="section white">
  <div class="container-pb">

    <div class="text-center mb-3">
      <span class="script-title" data-i18n="test.badge">Reseñas</span>
      <h2 class="text-3xl md:text-4xl font-bold mt-2 mb-10" data-i18n="test.title">Lo Que Dicen Nuestros Viajeros</h2>
    </div>

    <!-- Widget Google Reviews -->
    <div class="grev-widget">

      <!-- Panel izquierdo -->
      <div class="grev-left">
        <div class="grev-logo-row">
          <img src="/images/PeruBeyond/Logo.webp" alt="Peru Beyond" class="grev-logo" onerror="this.style.display='none'" />
          <span class="grev-biz-name">Perú más allá</span>
        </div>
        <div class="grev-stars-row">
          {Array.from({ length: 5 }).map(() => (
            <svg viewBox="0 0 24 24" class="grev-star-icon"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          ))}
        </div>
        <p class="grev-count">{totalReviews} reseñas de Google</p>
        <a
          href={`https://search.google.com/local/writereview?placeid=${PLACE_ID}`}
          target="_blank"
          rel="noopener noreferrer"
          class="grev-write-btn"
          data-i18n="test.write"
        >
          Escribe una reseña
        </a>
      </div>

      <!-- Carrusel -->
      <div class="grev-carousel-wrap">
        <button class="grev-nav grev-nav-prev" aria-label="Anterior">
          <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
        </button>

        <div class="grev-track-outer">
          <div class="grev-track" id="grevTrack">
            {reviews.map((r) => (
              <div class="grev-card">
                <div class="grev-card-top">
                  <div class="grev-avatar" style={`background:${r.color}`}>
                    {r.photo
                      ? <img src={r.photo} alt={r.name} class="grev-avatar-img" />
                      : <span>{r.initials}</span>
                    }
                  </div>
                  <div class="grev-meta">
                    <span class="grev-name">{r.name}</span>
                    <span class="grev-time">{r.time}</span>
                  </div>
                  <svg class="grev-g-logo" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                  </svg>
                </div>

                <div class="grev-rating-row">
                  {Array.from({ length: 5 }).map(() => (
                    <svg viewBox="0 0 24 24" class="grev-star-sm"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  ))}
                  <svg class="grev-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#4285F4"/><path d="M9 12l2 2 4-4" stroke="white" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>

                <p class="grev-text" data-full={r.text}>
                  {r.text.length > 130 ? r.text.slice(0, 130) + '…' : r.text}
                </p>
                {r.text.length > 130 && (
                  <button class="grev-readmore" data-i18n="test.read_more">Leer más</button>
                )}
              </div>
            ))}
          </div>
        </div>

        <button class="grev-nav grev-nav-next" aria-label="Siguiente">
          <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <!-- CTA ver todas -->
    <div class="text-center mt-10">
      <a
        href={`https://search.google.com/local/reviews?placeid=${PLACE_ID}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-gray-300 rounded-full px-6 py-2.5 text-sm font-semibold hover:bg-white hover:shadow transition"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <span data-i18n="test.see_all">Ver todas las reseñas en Google</span>
      </a>
    </div>

  </div>
</section>

<style>
/* ── Widget layout ─────────────────────────────────────────────── */
.grev-widget {
  display: flex;
  align-items: flex-start;
  gap: 2rem;
  background: #f8f9fa;
  border-radius: 16px;
  padding: 2rem;
  box-shadow: 0 2px 12px rgba(0,0,0,.06);
}

/* ── Left panel ────────────────────────────────────────────────── */
.grev-left {
  flex-shrink: 0;
  width: 200px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .75rem;
  text-align: center;
}
.grev-logo-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .5rem;
}
.grev-logo {
  width: 140px;
  height: 140px;
  object-fit: contain;
}
.grev-biz-name {
  font-weight: 700;
  font-size: .95rem;
  color: #0D1B2E;
}
.grev-stars-row {
  display: flex;
  gap: 2px;
}
.grev-star-icon {
  width: 22px;
  height: 22px;
  fill: #FFBC00;
}
.grev-count {
  font-size: .82rem;
  color: #555;
  font-weight: 600;
}
.grev-write-btn {
  display: inline-block;
  border: 1.5px solid #333;
  border-radius: 9999px;
  padding: .5rem 1.1rem;
  font-size: .82rem;
  font-weight: 700;
  color: #0D1B2E;
  text-decoration: none;
  transition: background .2s, color .2s;
  cursor: pointer;
  background: transparent;
}
.grev-write-btn:hover { background: #0D1B2E; color: #fff; }

/* ── Carousel ──────────────────────────────────────────────────── */
.grev-carousel-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: .5rem;
}
.grev-track-outer {
  flex: 1;
  overflow: hidden;
  border-radius: 12px;
}
.grev-track {
  display: flex;
  gap: 1rem;
  transition: transform .2s cubic-bezier(.4,0,.2,1);
  will-change: transform;
}

/* ── Card ──────────────────────────────────────────────────────── */
.grev-card {
  flex: 0 0 calc(33.333% - .67rem);
  background: #fff;
  border-radius: 12px;
  padding: 1.1rem 1.2rem 1rem;
  box-shadow: 0 1px 6px rgba(0,0,0,.08);
  display: flex;
  flex-direction: column;
  gap: .6rem;
  min-height: 200px;
}
.grev-card-top {
  display: flex;
  align-items: center;
  gap: .7rem;
}
.grev-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 700;
  font-size: .95rem;
  flex-shrink: 0;
  overflow: hidden;
}
.grev-avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.grev-meta {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.grev-name {
  font-weight: 700;
  font-size: .88rem;
  color: #0D1B2E;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.grev-time {
  font-size: .75rem;
  color: #888;
}
.grev-g-logo {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
}
.grev-rating-row {
  display: flex;
  align-items: center;
  gap: 2px;
}
.grev-star-sm {
  width: 16px;
  height: 16px;
  fill: #FFBC00;
}
.grev-check {
  width: 17px;
  height: 17px;
  margin-left: 4px;
}
.grev-text {
  font-size: .82rem;
  color: #444;
  line-height: 1.55;
  flex: 1;
}
.grev-readmore {
  background: none;
  border: none;
  padding: 0;
  font-size: .82rem;
  color: #555;
  cursor: pointer;
  text-align: left;
  font-family: inherit;
  text-decoration: underline;
}
.grev-readmore:hover { color: #0D1B2E; }

/* ── Nav buttons ───────────────────────────────────────────────── */
.grev-nav {
  background: #fff;
  border: 1.5px solid #ddd;
  border-radius: 50%;
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background .2s, border-color .2s;
}
.grev-nav:hover { background: #0D1B2E; border-color: #0D1B2E; }
.grev-nav:hover svg { stroke: #fff; }
.grev-nav svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: #333;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* ── Responsive ────────────────────────────────────────────────── */
@media (max-width: 900px) {
  .grev-card { flex: 0 0 calc(50% - .5rem); }
}
@media (max-width: 640px) {
  .grev-widget {
    flex-direction: column;
    align-items: center;
    padding: 1.5rem 1rem;
  }
  .grev-left { width: 100%; }
  .grev-card { flex: 0 0 90vw; }
}
</style>

<script>
  const track   = document.getElementById('grevTrack') as HTMLElement;
  const prevBtn = document.querySelector('.grev-nav-prev') as HTMLButtonElement;
  const nextBtn = document.querySelector('.grev-nav-next') as HTMLButtonElement;

  if (track && prevBtn && nextBtn) {
    let current = 0;

    function visibleCount(): number {
      const w = track.parentElement!.clientWidth;
      if (w < 640)  return 1;
      if (w < 900)  return 2;
      return 3;
    }

    function cardWidth(): number {
      const card = track.querySelector('.grev-card') as HTMLElement;
      if (!card) return 0;
      const gap = 16;
      return card.offsetWidth + gap;
    }

    function maxIndex(): number {
      return Math.max(0, 6 - visibleCount());
    }

    function update() {
      track.style.transform = `translateX(-${current * cardWidth()}px)`;
      prevBtn.style.opacity = current === 0 ? '0.35' : '1';
      nextBtn.style.opacity = current >= maxIndex() ? '0.35' : '1';
    }

    prevBtn.addEventListener('click', () => {
      if (current > 0) { current--; update(); }
    });
    nextBtn.addEventListener('click', () => {
      if (current < maxIndex()) { current++; update(); }
    });

    window.addEventListener('resize', () => {
      current = Math.min(current, maxIndex());
      update();
    });

    update();

    // Leer más
    document.querySelectorAll('.grev-readmore').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card  = btn.closest('.grev-card')!;
        const p     = card.querySelector('.grev-text') as HTMLElement;
        const full  = p.dataset.full ?? '';
        p.textContent = full;
        (btn as HTMLElement).style.display = 'none';
      });
    });
  }
</script>
