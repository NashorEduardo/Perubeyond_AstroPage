<section class="relative h-screen flex items-center overflow-hidden">

  <!-- Video de fondo -->
  <div class="absolute inset-0 w-full h-full pointer-events-none">
    <!-- Poster fallback: visible hasta que el video carga -->
    <img
      id="hero-poster"
      src="/images/Lima/pexels-icarus-7357663.webp"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <video
      id="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/images/Lima/pexels-icarus-7357663.webp"
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full object-cover opacity-0 transition-opacity duration-1000"
    >
      <source src="/images/PeruBeyond/Peru_beyond_01.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- Overlays -->
  <div class="absolute inset-0 bg-black/45"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/20"></div>

  <!-- Contenido -->
  <div class="container-pb text-white py-24 relative z-10 text-center">

    <!-- Tagline -->
    <span
      class="script-title block mb-5"
      data-i18n="hero.tagline"
    >
      Explora, vive y disfruta
    </span>

    <!-- Título -->
    <h1 class="text-white text-5xl md:text-7xl font-bold leading-tight max-w-4xl mx-auto drop-shadow-2xl">
      Peru Beyond <br/>

      <span
        class="text-gold"
        data-i18n="hero.title"
      >
        Más de lo que Imaginas
      </span>
    </h1>

    <!-- Tripadvisor -->
    <a
      href="https://www.tripadvisor.com.pe/Attraction_Review-g294314-d33404487-Reviews-Peru_Beyond-Cusco_Cusco_Region.html"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-4 mt-8"
    >
      <img
        src="https://upload.wikimedia.org/wikipedia/commons/0/02/TripAdvisor_Logo.svg"
        alt="Tripadvisor"
        width="170"
        height="70"
        class="h-16 object-contain drop-shadow-[0_0_6px_rgba(255,255,255,0.9)]"
        fetchpriority="low"
      />

      <div>
        <div class="flex text-gold text-xl justify-start">
          {Array.from({length:5}).map(()=> <i class="bi bi-star-fill"></i>)}
        </div>

        <span
          class="text-sm md:text-base text-white drop-shadow-lg"
          data-i18n="hero.reviews"
        >
          5.0 · 4 reseñas en TripAdvisor
        </span>
      </div>
    </a>

  </div>
</section>

<style>
  .script-title{
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 600;
    letter-spacing: 1px;
    font-size: 1.4rem;
    color: #d4a017;
    text-shadow: 0 2px 10px rgba(0,0,0,.6);
  }
</style>

<script is:inline>
  (function () {
    var video  = document.getElementById('hero-video');
    var poster = document.getElementById('hero-poster');
    if (!video) return;

    function showVideo() {
      video.style.opacity = '1';
      if (poster) poster.style.opacity = '0';
    }

    // Cuando tiene suficientes datos para reproducir → mostrar
    video.addEventListener('canplay', function () {
      var p = video.play();
      if (p !== undefined) {
        p.then(showVideo).catch(function () {
          // Autoplay bloqueado o error de carga → el poster se queda visible
        });
      } else {
        showVideo();
      }
    }, { once: true });

    // Si el video falla (error de red, servidor sin Range support, etc.)
    video.addEventListener('error', function () {
      video.style.display = 'none';
    });

    // Tiempo máximo de espera: si en 4s no cargó, el poster se queda
    setTimeout(function () {
      if (video.readyState < 3) {
        video.style.display = 'none';
      }
    }, 4000);
  })();
</script>