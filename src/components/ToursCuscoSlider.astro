---
const campaigns = [
  {
    icon: 'bi-tree-fill',
    tag: 'Campañas de Reforestación con especies nativas',
    title: 'Raíces que vuelven al suelo',
    text: 'Los Andes son un ecosistema vivo que las comunidades andinas han cuidado durante siglos, hoy amenazado por la deforestación y el cambio climático. En Peru Beyond creemos que viajar tiene consecuencias — y que esas consecuencias pueden ser buenas. Junto a comunidades campesinas del entorno de Cusco, plantamos especies nativas como queuñas, alisos y queñoales: árboles que protegen las fuentes de agua, fijan el suelo de las laderas y devuelven refugio a la fauna silvestre.',
    highlight: 'Viajando con nosotros colaboras con 2 árboles plantados en comunidades altoandinas.',
    images: [
      { src: 'https://upload.wikimedia.org/wikipedia/commons/6/6a/Suttoc_Paccha_Private_Conservation_Area_%28PCA%29_01.jpg', alt: 'Bosque de queuñas nativas en Cusco' },
      { src: 'https://upload.wikimedia.org/wikipedia/commons/5/5a/Suttoc_Paccha_Private_Conservation_Area_%28PCA%29_02.jpg', alt: 'Bosque andino nativo en Cusco' },
      { src: 'https://upload.wikimedia.org/wikipedia/commons/c/cb/Suttoc_pacchac_%28PCA%29_15.jpg', alt: 'Sendero entre queuñales en los Andes' },
    ],
  },
  {
    icon: 'bi-heart-pulse-fill',
    tag: 'Campañas de salud para comunidades',
    title: 'Salud que llega donde más se necesita',
    text: 'En las comunidades altoandinas de Cusco, la distancia al centro de salud más cercano puede significar horas de camino. Para los niños y adolescentes que crecen por encima de los 3,500 metros, esa distancia se traduce en diagnósticos que llegan tarde o simplemente no llegan. Peru Beyond lleva campañas médicas directamente a estas comunidades: controles de crecimiento, atención odontológica, tamizaje visual y orientación nutricional, sin costo y sin que nadie tenga que bajar a la ciudad para ser atendido.',
    highlight: 'Porque un viaje que no deja nada es solo turismo. El nuestro deja salud.',
    images: [
      { src: 'https://upload.wikimedia.org/wikipedia/commons/1/17/Quechua_Children%2C_Cuzco_%286974675076%29.jpg', alt: 'Niños de comunidades altoandinas de Cusco' },
      { src: 'https://upload.wikimedia.org/wikipedia/commons/1/1c/Quechua_children_in_traditional_dress_Andes_Peru.jpg', alt: 'Niños quechua de los Andes peruanos' },
      { src: 'https://upload.wikimedia.org/wikipedia/commons/3/3f/Ni%C3%B1os_del_Cuzco.JPG', alt: 'Niños del Cusco' },
    ],
  },
];
---
<section id="proyectos-sociales" class="section cusco-slider-bg">
  <span class="deco-line-top"></span>
  <span class="deco-line-bottom"></span>
  <span class="deco-circle"></span>
  <div class="container-pb" style="position:relative;z-index:1;">
    <div class="text-center mb-12">
      <span class="script-title" data-i18n="social.badge">Proyectos sociales</span>
      <h2 class="text-3xl md:text-4xl font-bold mt-2" style="color:#0d1b2e;" data-i18n="social.title">Al viajar con nosotros, contribuyes así</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-10">
      {campaigns.map((c) => (
        <div class="social-card">
          <div class="social-card__gallery">
            {c.images.map((img, i) => (
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                class={`social-card__img ${i === 0 ? 'social-card__img--main' : ''}`}
              />
            ))}
          </div>
          <div class="social-card__body">
            <div class="social-card__icon"><i class={`bi ${c.icon}`}></i></div>
            <p class="social-card__tag">{c.tag}</p>
            <h3 class="social-card__title">{c.title}</h3>
            <p class="social-card__text">{c.text}</p>
            <p class="social-card__highlight">{c.highlight}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Fondo claro elegante ── */
  .cusco-slider-bg {
    position: relative;
    overflow: hidden;

    /* Base crema cálida */
    background-color: #fdf9f1;

    /* Patrón de puntos dorados */
    background-image:
      radial-gradient(circle, rgba(201,168,76,0.18) 1.5px, transparent 1.5px);
    background-size: 26px 26px;
  }

  /* Degradados que suavizan los bordes del patrón */
  .cusco-slider-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 0% 0%,   rgba(253,249,241,0.92) 0%, transparent 45%),
      radial-gradient(ellipse at 100% 0%,  rgba(253,249,241,0.92) 0%, transparent 45%),
      radial-gradient(ellipse at 0% 100%,  rgba(253,249,241,0.92) 0%, transparent 45%),
      radial-gradient(ellipse at 100% 100%,rgba(253,249,241,0.92) 0%, transparent 45%),
      radial-gradient(ellipse at 50% 50%,  rgba(253,249,241,0.40) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  /* Círculo decorativo — esquina superior derecha */
  .cusco-slider-bg::after {
    content: '';
    position: absolute;
    top: -140px;
    right: -140px;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    border: 1px solid rgba(201,168,76,0.14);
    box-shadow:
      0 0 0 44px  rgba(201,168,76,0.05),
      0 0 0 90px  rgba(201,168,76,0.03),
      0 0 0 138px rgba(201,168,76,0.015);
    pointer-events: none;
    z-index: 0;
  }

  /* Círculo decorativo — esquina inferior izquierda (via span) */
  .cusco-slider-bg .deco-circle {
    position: absolute;
    bottom: -120px;
    left: -120px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    border: 1px solid rgba(201,168,76,0.12);
    box-shadow:
      0 0 0 38px rgba(201,168,76,0.04),
      0 0 0 78px rgba(201,168,76,0.02);
    pointer-events: none;
    z-index: 0;
  }

  /* Línea decorativa dorada superior */
  .cusco-slider-bg .deco-line-top {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(to right, transparent 0%, rgba(201,168,76,0.5) 30%, rgba(246,208,106,0.7) 50%, rgba(201,168,76,0.5) 70%, transparent 100%);
    z-index: 1;
  }

  /* Línea decorativa dorada inferior */
  .cusco-slider-bg .deco-line-bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(to right, transparent 0%, rgba(201,168,76,0.5) 30%, rgba(246,208,106,0.7) 50%, rgba(201,168,76,0.5) 70%, transparent 100%);
    z-index: 1;
  }

  /* ── Tarjetas de proyectos sociales ── */
  .social-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #ece7de;
  }
  .social-card__gallery {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 4px;
    aspect-ratio: 16 / 9;
  }
  .social-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .social-card__img--main {
    grid-row: 1 / 3;
  }
  .social-card__body {
    padding: 1.75rem;
  }
  .social-card__icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(231,76,60,0.1);
    color: #e74c3c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    margin-bottom: 0.85rem;
  }
  .social-card__tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #c9a84c;
    margin-bottom: 0.35rem;
  }
  .social-card__title {
    font-family: 'Raleway', sans-serif;
    font-size: 1.4rem;
    font-weight: 800;
    color: #0d1b2e;
    margin-bottom: 0.85rem;
  }
  .social-card__text {
    color: #6b7280;
    font-size: 0.92rem;
    line-height: 1.7;
    margin-bottom: 1.1rem;
  }
  .social-card__highlight {
    font-weight: 700;
    color: #0d1b2e;
    font-size: 0.9rem;
    line-height: 1.5;
    border-left: 3px solid #e74c3c;
    padding: 0.6rem 0.9rem;
    background: rgba(231,76,60,0.06);
    border-radius: 0 8px 8px 0;
  }

  @media (max-width: 640px) {
    .social-card__body { padding: 1.25rem; }
    .social-card__title { font-size: 1.2rem; }
  }
</style>
