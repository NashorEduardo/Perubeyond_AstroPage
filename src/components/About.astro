---
const certLogos = [
  { src: 'https://gercetur.com.pe/wp-content/uploads/2025/11/LOGO-POSITIVO-scaled-e1763582114614.png', alt: 'Gercetur' },
  { src: 'https://pirka.pe/wp-content/uploads/2025/07/Logo-Marca-Peru-jpeg.jpg', alt: 'Marca Perú' },
  { src: 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRfG9ZFoYjpvD34XX1veRJ3nEbPqrMrCPI1Aw&s', alt: 'TripAdvisor' },
  { src: 'https://mocatravelperu.com/wp-content/uploads/2021/09/protegeme.png', alt: 'Protegeme' },
  { src: 'https://www.wayraqperu.com/wp-content/uploads/mincetur.png', alt: 'Mincetur' },
];
---

<section id="about" class="section bg-white">
  <div class="container-pb">
    <div class="grid md:grid-cols-2 gap-12 items-start mb-10">
      <!-- Columna izquierda: Post Instagram simulado -->
      <div class="flex justify-center">
        <div class="ig-card">
          <!-- Header -->
          <div class="ig-header">
            <div class="ig-avatar">
              <img src="/images/PeruBeyond/Logo.png" alt="perubeyond" />
            </div>
            <div class="ig-user">
              <span class="ig-username">perubeyond</span>
              <span class="ig-location">Huacachina, Ica — Perú</span>
            </div>
            <svg class="ig-dots" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/>
            </svg>
          </div>

          <!-- Imagen -->
          <div class="ig-image-wrap">
            <img
              src="/images/Huacachina/pexels-romero-gonzales-miocid-king-piero-2152488445-32543951.webp"
              alt="Huacachina oasis, Ica - Peru Beyond"
              loading="lazy"
            />
          </div>

          <!-- Acciones -->
          <div class="ig-actions">
            <div class="ig-left-actions">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          </div>

          <!-- Info -->
          <div class="ig-info">
            <p class="ig-likes">248 Me gusta</p>
            <p class="ig-caption">
              <span class="ig-username">perubeyond</span>
              El oasis escondido de Huacachina 🌊🏜️ Una de las maravillas naturales más impresionantes del Perú. ¿Te atreves a deslizarte por sus dunas?
            </p>
            <a
              href="https://www.instagram.com/perubeyond/"
              target="_blank"
              rel="noopener noreferrer"
              class="ig-ver-mas"
            >Ver más en Instagram →</a>
          </div>
        </div>
      </div>

      <!-- Columna derecha -->
      <div>
        <span class="script-title" data-i18n="about.badge">Sobre Nosotros</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-2 mb-4" style="font-family:'Times New Roman',Times,serif;" data-i18n="about.title">Tu Puerta de Entrada a un Perú Auténtico y Exclusivo</h2>
        <p class="text-gray-600 mb-6" data-i18n="about.desc">En Peru Beyond, creamos rutas únicas y significativas que van mucho más allá de lo convencional. Nos especializamos en conectar a viajeros exigentes con la esencia viva de los Andes, la Amazonía y nuestras costas, permitiéndoles descubrir el Perú desde una perspectiva auténtica, profunda y memorable. Cada experiencia es cuidadosamente diseñada para integrar cultura, naturaleza y confort, combinando tradiciones ancestrales con paisajes extraordinarios y servicios de alta calidad. Nuestro compromiso es ofrecer un servicio personalizado, cuidando cada detalle de tu aventura para que vivas un viaje exclusivo, inspirador y lleno de momentos inolvidables.</p>

        <a
          href="https://www.tripadvisor.com.pe/Attraction_Review-g294314-d33404487-Reviews-Peru_Beyond-Cusco_Cusco_Region.html"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 mt-2 p-4 bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow"
        >
          <img
            src="https://upload.wikimedia.org/wikipedia/commons/thumb/7/73/Tripadvisor_2025_Logo.svg/500px-Tripadvisor_2025_Logo.svg.png"
            alt="Tripadvisor"
            class="h-8 object-contain"
          />
          <div>
            <div class="flex text-[#34E0A1] text-lg">★★★★★</div>
            <span class="text-xs text-gray-600" data-i18n="about.reviews">5.0 · 4 reseñas en TripAdvisor</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Logos de certificaciones -->
    <div class="flex flex-wrap justify-center items-center gap-8 pt-6 border-t border-gray-200">
      {certLogos.map((c, i) => (
        <div class={`flex items-center justify-center ${i >= 1 && i <= 3 ? 'w-36 h-28' : 'w-28 h-20'}`}>
          <img src={c.src} alt={c.alt} class="max-w-full max-h-full object-contain" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ig-card {
    width: 100%;
    max-width: 340px;
    border: 1px solid #dbdbdb;
    border-radius: 12px;
    background: #fff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }

  .ig-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid #f0f0f0;
  }

  .ig-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    padding: 2px;
    background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    flex-shrink: 0;
  }

  .ig-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
    border: 2px solid #fff;
    box-sizing: border-box;
    display: block;
    background: #fff;
  }

  .ig-user {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .ig-username {
    font-size: 13px;
    font-weight: 600;
    color: #000;
  }

  .ig-location {
    font-size: 11px;
    color: #6b6b6b;
  }

  .ig-dots {
    color: #262626;
    cursor: pointer;
    flex-shrink: 0;
  }

  .ig-image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .ig-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ig-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px 6px;
  }

  .ig-left-actions {
    display: flex;
    gap: 14px;
  }

  .ig-actions svg {
    cursor: pointer;
    color: #262626;
    transition: color 0.2s;
  }

  .ig-actions svg:hover { color: #8e8e8e; }

  .ig-info {
    padding: 0 14px 14px;
  }

  .ig-likes {
    font-size: 13px;
    font-weight: 600;
    color: #000;
    margin-bottom: 4px;
  }

  .ig-caption {
    font-size: 13px;
    color: #262626;
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .ig-caption .ig-username {
    margin-right: 4px;
  }

  .ig-ver-mas {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    color: #0095f6;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .ig-ver-mas:hover { opacity: 0.75; }
</style>
