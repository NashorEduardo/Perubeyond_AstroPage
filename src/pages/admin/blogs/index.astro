---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listAllBlogs } from '../../../lib/blogs';
import { blogCategories } from '../../../data/blogCategories';

export const prerender = false;

const blogs = await listAllBlogs();
---

<AdminLayout title="Gestor de Artículos de Blog" activeTab="blogs">
  
  <!-- Header / Action bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h2 class="text-2xl font-bold text-white tracking-wide">Artículos de Blog</h2>
      <p class="text-xs text-slate-400 mt-1">
        Gestiona las <span id="total-count" class="font-bold text-slate-200">{blogs.length}</span> publicaciones del blog en español, inglés y portugués
      </p>
    </div>

    <a
      href="/admin/blogs/editor?new=1"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#c9a84c] to-[#f6d06a] hover:from-[#d8b556] hover:to-[#fae086] text-slate-950 font-bold text-xs tracking-wide shadow-lg shadow-[#c9a84c]/20 transition-all self-start sm:self-auto cursor-pointer"
    >
      <i class="bi bi-plus-circle-fill text-sm"></i>
      <span>Nuevo Artículo</span>
    </a>
  </div>

  <!-- Filters & Search Bar -->
  <div class="bg-[#0D1B2E] border border-slate-800 rounded-2xl p-4 mb-6 space-y-4">
    <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
      
      <!-- Search Input -->
      <div class="relative flex-1">
        <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
        <input
          type="text"
          id="search-input"
          placeholder="Buscar artículo por título, slug o autor..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
        />
      </div>

      <!-- Category Filter -->
      <div class="flex items-center gap-3">
        <select
          id="category-filter"
          class="px-3 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-slate-300 text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
        >
          <option value="all">Todas las categorías</option>
          {blogCategories.map((cat) => (
            <option value={cat.label.es}>{cat.label.es}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Language Filter Tabs -->
    <div class="flex items-center gap-2 pt-2 border-t border-slate-800/80 overflow-x-auto text-xs">
      <span class="text-slate-400 font-semibold mr-1">Idioma:</span>
      <button
        type="button"
        data-lang="all"
        class="lang-tab px-3 py-1.5 rounded-lg font-semibold bg-[#c9a84c] text-slate-950 transition-colors"
      >
        Todos ({blogs.length})
      </button>
      <button
        type="button"
        data-lang="es"
        class="lang-tab px-3 py-1.5 rounded-lg font-semibold bg-[#09111C] text-slate-300 hover:bg-slate-800 transition-colors"
      >
        Español ({blogs.filter((b) => b.lang === 'es').length})
      </button>
      <button
        type="button"
        data-lang="en"
        class="lang-tab px-3 py-1.5 rounded-lg font-semibold bg-[#09111C] text-slate-300 hover:bg-slate-800 transition-colors"
      >
        Inglés ({blogs.filter((b) => b.lang === 'en').length})
      </button>
      <button
        type="button"
        data-lang="pt"
        class="lang-tab px-3 py-1.5 rounded-lg font-semibold bg-[#09111C] text-slate-300 hover:bg-slate-800 transition-colors"
      >
        Portugués ({blogs.filter((b) => b.lang === 'pt').length})
      </button>
    </div>
  </div>

  <!-- Blogs Table -->
  <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs sm:text-sm text-slate-300">
        <thead class="bg-[#09111C]/90 text-slate-400 uppercase text-[11px] font-semibold tracking-wider border-b border-slate-800">
          <tr>
            <th scope="col" class="py-4 px-4 sm:px-6">Artículo / Publicación</th>
            <th scope="col" class="py-4 px-3 text-center">Idioma</th>
            <th scope="col" class="py-4 px-3">Categoría</th>
            <th scope="col" class="py-4 px-3">Autor & Fecha</th>
            <th scope="col" class="py-4 px-3">Lectura</th>
            <th scope="col" class="py-4 px-4 sm:px-6 text-right">Acciones</th>
          </tr>
        </thead>
        <tbody id="blogs-table-body" class="divide-y divide-slate-800/60 font-medium">
          {blogs.map((b) => (
            <tr
              class="blog-row hover:bg-slate-800/40 transition-colors"
              data-id={b.id}
              data-title={b.data.title.toLowerCase()}
              data-slug={b.slug.toLowerCase()}
              data-category={b.data.category.toLowerCase()}
              data-lang={b.lang}
              data-author={b.data.author.toLowerCase()}
            >
              <!-- Thumbnail & Title -->
              <td class="py-3.5 px-4 sm:px-6">
                <div class="flex items-center gap-3">
                  <img
                    src={b.data.heroImage || '/images/PeruBeyond/Logo.png'}
                    alt={b.data.title}
                    class="w-12 h-12 rounded-xl object-cover bg-slate-900 border border-slate-800 flex-shrink-0"
                    loading="lazy"
                  />
                  <div class="min-w-0 max-w-xs sm:max-w-md">
                    <a
                      href={`/admin/blogs/editor?id=${b.id}`}
                      class="font-semibold text-white hover:text-[#c9a84c] transition-colors truncate block text-sm"
                      title={b.data.title}
                    >
                      {b.data.title}
                    </a>
                    <div class="flex items-center gap-2 mt-0.5">
                      <span class="text-[11px] font-mono text-slate-400 truncate" title={b.id}>
                        {b.id}
                      </span>
                      {b.isCustom ? (
                        <span class="px-1.5 py-0.2 rounded bg-[#c9a84c]/20 text-[#f6d06a] border border-[#c9a84c]/40 text-[9px] font-bold">
                          CMS
                        </span>
                      ) : (
                        <span class="px-1.5 py-0.2 rounded bg-slate-800 text-slate-400 text-[9px] font-semibold">
                          Integrado
                        </span>
                      )}
                    </div>
                  </div>
                </div>
              </td>

              <!-- Lang Badge -->
              <td class="py-3.5 px-3 text-center">
                <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${
                  b.lang === 'es' ? 'bg-blue-500/10 text-blue-400 border border-blue-500/30' :
                  b.lang === 'en' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/30' :
                  'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30'
                }`}>
                  {b.lang}
                </span>
              </td>

              <!-- Category -->
              <td class="py-3.5 px-3">
                <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-800/80 text-slate-300 text-xs">
                  {b.data.category}
                </span>
              </td>

              <!-- Author & Date -->
              <td class="py-3.5 px-3 text-xs text-slate-300">
                <div class="font-semibold text-white truncate max-w-[140px]">{b.data.author}</div>
                <div class="text-[11px] text-slate-400">{b.data.date}</div>
              </td>

              <!-- Read time -->
              <td class="py-3.5 px-3 text-slate-400 text-xs">
                {b.data.readTime || '—'}
              </td>

              <!-- Actions -->
              <td class="py-3.5 px-4 sm:px-6 text-right">
                <div class="flex items-center justify-end gap-1.5">
                  <a
                    href={`/admin/blogs/editor?id=${b.id}`}
                    class="p-2 rounded-lg bg-slate-800 hover:bg-[#c9a84c] hover:text-slate-950 text-slate-200 transition-colors"
                    title="Editar Artículo"
                  >
                    <i class="bi bi-pencil-square"></i>
                  </a>

                  <a
                    href={`/${b.lang}/blog/${b.slug}`}
                    target="_blank"
                    rel="noopener"
                    class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-colors"
                    title="Ver en el sitio web"
                  >
                    <i class="bi bi-box-arrow-up-right"></i>
                  </a>

                  <button
                    type="button"
                    class="delete-blog-btn p-2 rounded-lg bg-slate-800 hover:bg-red-500/20 text-slate-400 hover:text-red-400 transition-colors"
                    data-id={b.id}
                    data-title={b.data.title}
                    title="Eliminar Artículo"
                  >
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden p-12 text-center text-slate-400">
      <i class="bi bi-newspaper text-4xl mb-3 block text-slate-600"></i>
      <p class="text-base font-semibold text-white">No se encontraron artículos</p>
      <p class="text-xs mt-1">Prueba cambiando los filtros o el texto de búsqueda.</p>
    </div>
  </div>

  <script is:inline>
    // Filtering logic
    const searchInput = document.getElementById('search-input');
    const categoryFilter = document.getElementById('category-filter');
    const langTabs = document.querySelectorAll('.lang-tab');
    const rows = document.querySelectorAll('.blog-row');
    const emptyState = document.getElementById('empty-state');
    const totalCount = document.getElementById('total-count');

    let currentLang = 'all';
    let currentCategory = 'all';
    let currentQuery = '';

    function filterRows() {
      let visible = 0;

      rows.forEach((row) => {
        const title = row.getAttribute('data-title') || '';
        const slug = row.getAttribute('data-slug') || '';
        const category = row.getAttribute('data-category') || '';
        const lang = row.getAttribute('data-lang') || '';
        const author = row.getAttribute('data-author') || '';

        const matchLang = currentLang === 'all' || lang === currentLang;
        const matchCategory = currentCategory === 'all' || category.includes(currentCategory.toLowerCase());
        const matchQuery =
          !currentQuery ||
          title.includes(currentQuery) ||
          slug.includes(currentQuery) ||
          category.includes(currentQuery) ||
          author.includes(currentQuery);

        if (matchLang && matchCategory && matchQuery) {
          row.classList.remove('hidden');
          visible++;
        } else {
          row.classList.add('hidden');
        }
      });

      if (totalCount) totalCount.textContent = visible;
      if (emptyState) {
        if (visible === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', (e) => {
      currentQuery = e.target.value.toLowerCase().trim();
      filterRows();
    });

    categoryFilter?.addEventListener('change', (e) => {
      currentCategory = e.target.value;
      filterRows();
    });

    langTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        langTabs.forEach((t) => {
          t.className = 'lang-tab px-3 py-1.5 rounded-lg font-semibold bg-[#09111C] text-slate-300 hover:bg-slate-800 transition-colors';
        });
        tab.className = 'lang-tab px-3 py-1.5 rounded-lg font-semibold bg-[#c9a84c] text-slate-950 transition-colors';
        currentLang = tab.getAttribute('data-lang') || 'all';
        filterRows();
      });
    });

    // Delete handling
    document.querySelectorAll('.delete-blog-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title');
        if (!id) return;

        if (!confirm(`¿Estás seguro de que deseas eliminar el artículo:\n"${title}" (${id})?`)) {
          return;
        }

        try {
          const res = await fetch(`/api/admin/blogs?id=${encodeURIComponent(id)}`, {
            method: 'DELETE',
          });
          const data = await res.json();

          if (res.ok && data.success) {
            window.showToast?.('Artículo eliminado exitosamente.', 'success');
            const row = btn.closest('.blog-row');
            if (row) {
              row.style.opacity = '0';
              setTimeout(() => {
                row.remove();
                filterRows();
              }, 300);
            }
          } else {
            window.showToast?.(data.error || 'No se pudo eliminar el artículo.', 'error');
          }
        } catch (err) {
          window.showToast?.('Error al conectar con el servidor.', 'error');
        }
      });
    });
  </script>

</AdminLayout>
