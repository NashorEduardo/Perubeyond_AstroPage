---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getBlogById } from '../../../lib/blogs';
import { blogCategories } from '../../../data/blogCategories';

export const prerender = false;

const url = new URL(Astro.request.url);
const blogId = url.searchParams.get('id');
const isNew = url.searchParams.get('new') === '1' || !blogId;

let blog = null;
if (!isNew && blogId) {
  blog = await getBlogById(blogId);
}

const todayFormatted = new Date().toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const initialData = blog
  ? {
      id: blog.id,
      lang: blog.lang || 'es',
      slug: blog.slug || '',
      title: blog.data.title || '',
      date: blog.data.date || todayFormatted,
      readTime: blog.data.readTime || '5 min de lectura',
      views: blog.data.views || '1.1k',
      author: blog.data.author || 'Equipo Peru Beyond',
      category: blog.data.category || 'Destinos Imperdibles',
      heroImage: blog.data.heroImage || '',
      heroPosition: blog.data.heroPosition || 'center',
      excerpt: blog.data.excerpt || '',
      sections: blog.data.sections || [],
      tips: blog.data.tips || [],
      conclusion: blog.data.conclusion || '',
      metaTitle: blog.data.metaTitle || '',
      metaDescription: blog.data.metaDescription || '',
      keywords: blog.data.keywords || '',
      isCustom: blog.isCustom,
    }
  : {
      id: '',
      lang: 'es',
      slug: '',
      title: '',
      date: todayFormatted,
      readTime: '5 min de lectura',
      views: '850',
      author: 'Equipo Peru Beyond',
      category: 'Destinos Imperdibles',
      heroImage: '',
      heroPosition: 'center',
      excerpt: '',
      sections: [
        {
          heading: 'Introducción y contexto histórico',
          paragraphs: [
            'Explora este fascinante destino lleno de riqueza cultural, arquitectura milenaria y paisajes andinos incomparables.',
          ],
          image: '',
          imageCaption: '',
          highlight: 'Un testimonio vivo de la grandeza de la civilización incaica.',
        },
      ],
      tips: [
        'Llevar agua y protector solar.',
        'Aclimatarse al menos 1 día antes en la ciudad de Cusco.',
      ],
      conclusion:
        'Visitar este lugar es una experiencia enriquecedora que transformará tu visión de los Andes.',
      metaTitle: '',
      metaDescription: '',
      keywords: '',
      isCustom: true,
    };
---

<AdminLayout title={isNew ? 'Nuevo Artículo de Blog' : `Editar: ${initialData.title}`} activeTab="blogs">
  
  <!-- Top Navigation & Action bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-3">
      <a
        href="/admin/blogs"
        class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors"
        title="Volver al listado"
      >
        <i class="bi bi-arrow-left text-lg"></i>
      </a>
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-white tracking-wide">
          {isNew ? 'Publicar Nuevo Artículo' : 'Editar Artículo de Blog'}
        </h2>
        <div class="text-xs text-slate-400 mt-0.5">
          {isNew ? 'Crea contenido con secciones dinámicas, optimización WebP y metadatos SEO' : `ID: ${initialData.id}`}
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-3">
      {!isNew && (
        <a
          href={`/${initialData.lang}/blog/${initialData.slug}`}
          target="_blank"
          rel="noopener"
          class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-semibold inline-flex items-center gap-1.5 transition-colors"
        >
          <i class="bi bi-box-arrow-up-right"></i>
          <span class="hidden sm:inline">Ver en web</span>
        </a>
      )}

      <button
        type="button"
        id="save-blog-btn-top"
        class="px-5 py-2 rounded-xl bg-gradient-to-r from-[#c9a84c] to-[#f6d06a] hover:from-[#d8b556] hover:to-[#fae086] text-slate-950 font-bold text-xs tracking-wide shadow-lg shadow-[#c9a84c]/20 transition-all inline-flex items-center gap-2 cursor-pointer"
      >
        <i class="bi bi-floppy-fill"></i>
        <span>Guardar Artículo</span>
      </button>
    </div>
  </div>

  <!-- Form -->
  <form id="blog-form" class="space-y-8">
    <input type="hidden" id="blog-original-id" value={initialData.id} />
    <input type="hidden" id="is-new" value={isNew ? 'true' : 'false'} />

    <!-- SECCIÓN 1: DATOS PRINCIPALES -->
    <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl">
      <div class="flex items-center gap-2.5 pb-4 border-b border-slate-800 mb-6">
        <i class="bi bi-journal-text text-[#c9a84c] text-xl"></i>
        <h3 class="text-base font-bold text-white">1. Información del Artículo y URL</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <!-- Título -->
        <div class="md:col-span-8">
          <label for="blog-title" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Título del Artículo *
          </label>
          <input
            type="text"
            id="blog-title"
            required
            value={initialData.title}
            placeholder="Ej: Guía Completa de Sacsayhuamán: Historia y Cómo Llegar"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c9a84c]"
          />
        </div>

        <!-- Idioma -->
        <div class="md:col-span-4">
          <label for="blog-lang" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Idioma *
          </label>
          <select
            id="blog-lang"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-sm focus:outline-none focus:border-[#c9a84c]"
          >
            <option value="es" selected={initialData.lang === 'es'}>Español (es)</option>
            <option value="en" selected={initialData.lang === 'en'}>Inglés (en)</option>
            <option value="pt" selected={initialData.lang === 'pt'}>Portugués (pt)</option>
          </select>
        </div>

        <!-- Slug -->
        <div class="md:col-span-6">
          <label for="blog-slug" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Slug de la URL *
          </label>
          <input
            type="text"
            id="blog-slug"
            required
            value={initialData.slug}
            placeholder="guia-sacsayhuaman-cusco"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 font-mono text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c9a84c]"
          />
        </div>

        <!-- Categoría -->
        <div class="md:col-span-6">
          <label for="blog-category" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Categoría *
          </label>
          <select
            id="blog-category"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-sm focus:outline-none focus:border-[#c9a84c]"
          >
            {blogCategories.map((c) => (
              <option value={c.label.es} selected={initialData.category === c.label.es || initialData.category === c.label.en || initialData.category === c.label.pt}>
                {c.label.es}
              </option>
            ))}
          </select>
        </div>

        <!-- Autor -->
        <div class="md:col-span-4">
          <label for="blog-author" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Autor
          </label>
          <input
            type="text"
            id="blog-author"
            value={initialData.author}
            placeholder="Equipo Peru Beyond"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-sm focus:outline-none focus:border-[#c9a84c]"
          />
        </div>

        <!-- Fecha -->
        <div class="md:col-span-4">
          <label for="blog-date" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Fecha de Publicación
          </label>
          <input
            type="text"
            id="blog-date"
            value={initialData.date}
            placeholder="15 de Mayo, 2025"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-sm focus:outline-none focus:border-[#c9a84c]"
          />
        </div>

        <!-- Tiempo de Lectura -->
        <div class="md:col-span-4">
          <label for="blog-read-time" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Tiempo de Lectura
          </label>
          <input
            type="text"
            id="blog-read-time"
            value={initialData.readTime}
            placeholder="6 min de lectura"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-sm focus:outline-none focus:border-[#c9a84c]"
          />
        </div>

        <!-- URL Preview -->
        <div class="md:col-span-12 p-3 rounded-xl bg-[#09111C]/60 border border-slate-800 text-xs font-mono text-slate-400 flex items-center gap-2">
          <i class="bi bi-link-45deg text-base text-[#c9a84c]"></i>
          <span>Ruta web pública:</span>
          <span id="url-preview" class="text-white font-semibold">
            /{initialData.lang}/blog/{initialData.slug || '[slug]'}
          </span>
        </div>
      </div>
    </div>

    <!-- SECCIÓN 2: IMAGEN HERO & RESUMEN -->
    <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl">
      <div class="flex items-center gap-2.5 pb-4 border-b border-slate-800 mb-6">
        <i class="bi bi-image text-[#c9a84c] text-xl"></i>
        <h3 class="text-base font-bold text-white">2. Imagen de Cabecera y Resumen</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-5">
        <!-- Hero Preview & Upload -->
        <div class="md:col-span-12">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Imagen Destacada (Hero) *
          </label>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <div class="relative w-28 h-20 rounded-2xl overflow-hidden bg-slate-900 border border-slate-700 flex-shrink-0 flex items-center justify-center">
              <img
                id="hero-preview"
                src={initialData.heroImage || '/images/PeruBeyond/Logo.webp'}
                alt="Preview"
                class="w-full h-full object-cover"
                onerror="this.src='/images/PeruBeyond/Logo.webp'"
              />
            </div>
            <div class="flex-1 space-y-2">
              <div class="flex gap-2">
                <input
                  type="text"
                  id="blog-hero-image"
                  required
                  value={initialData.heroImage}
                  placeholder="/images/Blog/[slug]/portada.webp"
                  class="flex-1 px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 font-mono text-white text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
                />
                <label class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-[#f6d06a] border border-slate-700 text-xs font-bold flex items-center gap-1.5 cursor-pointer flex-shrink-0">
                  <i class="bi bi-cloud-arrow-up-fill text-sm"></i>
                  <span>Subir WebP</span>
                  <input type="file" id="hero-upload-input" accept="image/*" class="hidden" />
                </label>
              </div>
              <p class="text-[11px] text-slate-400">
                Guarda en <code>public/images/Blog/[slug]/</code> optimizada a WebP.
              </p>
            </div>
          </div>
        </div>

        <!-- Extracto / Resumen -->
        <div class="md:col-span-12">
          <label for="blog-excerpt" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Extracto o Resumen Breve
          </label>
          <textarea
            id="blog-excerpt"
            rows="2"
            placeholder="Breve resumen del artículo para las tarjetas de previsualización..."
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
          >{initialData.excerpt}</textarea>
        </div>
      </div>
    </div>

    <!-- SECCIÓN 3: CONSTRUCTOR DE SECCIONES -->
    <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-6">
        <div class="flex items-center gap-2.5">
          <i class="bi bi-card-list text-[#c9a84c] text-xl"></i>
          <div>
            <h3 class="text-base font-bold text-white">3. Secciones de Contenido</h3>
            <p class="text-xs text-slate-400">Estructura el cuerpo del artículo en bloques con subtítulos, imágenes y citas</p>
          </div>
        </div>

        <button
          type="button"
          id="add-section-btn"
          class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-[#f6d06a] border border-slate-700 text-xs font-bold flex items-center gap-1.5 cursor-pointer"
        >
          <i class="bi bi-plus-lg"></i>
          <span>Agregar Sección</span>
        </button>
      </div>

      <div id="sections-container" class="space-y-6">
        {initialData.sections.map((section, idx) => (
          <div class="section-card bg-[#09111C] border border-slate-800 rounded-2xl p-5 relative group">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg bg-[#c9a84c]/20 text-[#f6d06a] border border-[#c9a84c]/40">
                Sección {idx + 1}
              </span>
              <button
                type="button"
                class="remove-section-btn text-slate-400 hover:text-red-400 p-1 text-sm transition-colors"
                title="Eliminar sección"
              >
                <i class="bi bi-trash"></i>
              </button>
            </div>

            <div class="space-y-4">
              <div>
                <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Subtítulo de la Sección</label>
                <input
                  type="text"
                  class="section-heading-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-white font-semibold text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
                  placeholder="Ej: Historia y arquitectura del complejo"
                  value={section.heading || ''}
                />
              </div>

              <div>
                <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Párrafos (separa cada párrafo con una línea en blanco)</label>
                <textarea
                  rows="4"
                  class="section-paragraphs-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-slate-200 text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
                  placeholder="Escribe el contenido detallado de esta sección..."
                >{(section.paragraphs || []).join('\n\n')}</textarea>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                <div>
                  <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Imagen de la Sección (opcional)</label>
                  <input
                    type="text"
                    class="section-image-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-slate-300 font-mono text-xs focus:outline-none focus:border-[#c9a84c]"
                    placeholder="/images/Blog/seccion.webp"
                    value={section.image || ''}
                  />
                </div>
                <div>
                  <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Cita Destacada / Resaltado (opcional)</label>
                  <input
                    type="text"
                    class="section-highlight-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-slate-300 text-xs focus:outline-none focus:border-[#c9a84c]"
                    placeholder="Frase inspiradora o dato curioso"
                    value={section.highlight || ''}
                  />
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- SECCIÓN 4: CONSEJOS Y CONCLUSIÓN -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Tips -->
      <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 shadow-xl">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
          <div class="flex items-center gap-2">
            <i class="bi bi-lightbulb-fill text-amber-400 text-lg"></i>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider">Consejos para el Viajero</h3>
          </div>
          <button
            type="button"
            id="add-tip-btn"
            class="text-xs text-[#c9a84c] hover:text-[#f6d06a] font-semibold flex items-center gap-1 cursor-pointer"
          >
            <i class="bi bi-plus-lg"></i> Agregar Tip
          </button>
        </div>

        <div id="tips-list" class="space-y-2">
          {initialData.tips.map((tip) => (
            <div class="tip-item flex items-center gap-2">
              <i class="bi bi-check2-circle text-amber-400 text-sm"></i>
              <input
                type="text"
                class="tip-input flex-1 px-3 py-1.5 rounded-lg bg-[#09111C] border border-slate-700/80 text-white text-xs focus:outline-none focus:border-[#c9a84c]"
                value={tip}
              />
              <button type="button" class="remove-tip-btn text-slate-500 hover:text-red-400 p-1 text-xs">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
          ))}
        </div>
      </div>

      <!-- Conclusión -->
      <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 shadow-xl flex flex-col">
        <div class="flex items-center gap-2 pb-4 border-b border-slate-800 mb-4">
          <i class="bi bi-flag-fill text-emerald-400 text-lg"></i>
          <h3 class="text-sm font-bold text-white uppercase tracking-wider">Conclusión / Cierre</h3>
        </div>

        <textarea
          id="blog-conclusion"
          rows="6"
          placeholder="Reflexión final, invitación a viajar o llamado a la acción..."
          class="flex-1 w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
        >{initialData.conclusion}</textarea>
      </div>

    </div>

    <!-- SECCIÓN 5: METADATOS SEO Y VISTA PREVIA -->
    <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl">
      <div class="flex items-center gap-2.5 pb-4 border-b border-slate-800 mb-6">
        <i class="bi bi-google text-[#c9a84c] text-xl"></i>
        <h3 class="text-base font-bold text-white">5. Optimización SEO para Motores de Búsqueda</h3>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Inputs SEO -->
        <div class="lg:col-span-7 space-y-4">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="blog-meta-title" class="text-xs font-semibold uppercase tracking-wider text-slate-300">
                Meta Title
              </label>
              <span id="meta-title-count" class="text-[11px] text-slate-400 font-mono">0 / 60</span>
            </div>
            <input
              type="text"
              id="blog-meta-title"
              value={initialData.metaTitle}
              placeholder="Ej: Guía de Viaje a Cusco 2025 | Blog Peru Beyond"
              class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="blog-meta-desc" class="text-xs font-semibold uppercase tracking-wider text-slate-300">
                Meta Description
              </label>
              <span id="meta-desc-count" class="text-[11px] text-slate-400 font-mono">0 / 160</span>
            </div>
            <textarea
              id="blog-meta-desc"
              rows="3"
              placeholder="Descripción atractiva para los resultados de Google..."
              class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
            >{initialData.metaDescription}</textarea>
          </div>

          <div>
            <label for="blog-keywords" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
              Palabras Clave (Keywords)
            </label>
            <input
              type="text"
              id="blog-keywords"
              value={initialData.keywords}
              placeholder="cusco, sacsayhuaman, viaje a peru, consejos cusco"
              class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
            />
          </div>
        </div>

        <!-- Google SERP Preview -->
        <div class="lg:col-span-5 flex flex-col justify-center">
          <div class="text-[11px] uppercase font-semibold text-slate-400 mb-2">Simulación de Búsqueda (Google)</div>
          <div class="bg-white rounded-2xl p-4 shadow text-left font-sans">
            <div class="flex items-center gap-2 mb-1">
              <div class="w-4 h-4 rounded-full bg-slate-200 flex items-center justify-center text-[10px] text-slate-700 font-bold">
                P
              </div>
              <div class="text-xs text-[#202124] leading-none">
                perubeyond.com &rsaquo; {initialData.lang} &rsaquo; blog &rsaquo; <span id="serp-slug">{initialData.slug || 'articulo'}</span>
              </div>
            </div>
            <div id="serp-title" class="text-[#1a0dab] text-sm font-medium hover:underline cursor-pointer leading-snug line-clamp-1">
              {initialData.metaTitle || initialData.title || 'Título del artículo en Google'}
            </div>
            <div id="serp-desc" class="text-[#4d5156] text-xs mt-1 leading-relaxed line-clamp-2">
              {initialData.metaDescription || initialData.excerpt || 'Descripción optimizada para motores de búsqueda de Google y redes sociales...'}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Botón de Guardado Inferior -->
    <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
      <a
        href="/admin/blogs"
        class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-semibold transition-colors"
      >
        Cancelar
      </a>
      <button
        type="submit"
        id="save-blog-btn-bottom"
        class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-[#c9a84c] to-[#f6d06a] hover:from-[#d8b556] hover:to-[#fae086] text-slate-950 font-bold text-xs tracking-wide shadow-lg shadow-[#c9a84c]/20 transition-all inline-flex items-center gap-2 cursor-pointer"
      >
        <i class="bi bi-floppy-fill"></i>
        <span>Guardar y Publicar Artículo</span>
      </button>
    </div>

  </form>

  <script is:inline>
    const form = document.getElementById('blog-form');
    const originalIdInput = document.getElementById('blog-original-id');
    const isNewInput = document.getElementById('is-new');
    const titleInput = document.getElementById('blog-title');
    const langSelect = document.getElementById('blog-lang');
    const slugInput = document.getElementById('blog-slug');
    const categorySelect = document.getElementById('blog-category');
    const urlPreview = document.getElementById('url-preview');

    const heroImageInput = document.getElementById('blog-hero-image');
    const heroPreview = document.getElementById('hero-preview');
    const heroUploadInput = document.getElementById('hero-upload-input');

    const metaTitleInput = document.getElementById('blog-meta-title');
    const metaDescInput = document.getElementById('blog-meta-desc');
    const metaTitleCount = document.getElementById('meta-title-count');
    const metaDescCount = document.getElementById('meta-desc-count');
    const serpTitle = document.getElementById('serp-title');
    const serpDesc = document.getElementById('serp-desc');
    const serpSlug = document.getElementById('serp-slug');

    let slugManual = Boolean(slugInput.value);

    function slugify(text) {
      return text
        .toString()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 80);
    }

    // Obtener o autogenerar slug para nombrar la carpeta exclusiva del blog
    function getOrGenerateSlug() {
      let slug = slugInput.value?.trim();
      const title = titleInput.value?.trim();

      if (!slug && title) {
        slug = slugify(title);
        slugInput.value = slug;
        updateUrlPreview();
      }

      if (!slug) {
        const promptTitle = prompt('Para organizar las fotos en su propia carpeta, escribe el título o slug del artículo de blog:');
        if (promptTitle && promptTitle.trim()) {
          titleInput.value = promptTitle.trim();
          slug = slugify(promptTitle);
          slugInput.value = slug;
          updateUrlPreview();
        } else {
          slug = 'blog-' + Date.now().toString(36);
          slugInput.value = slug;
          updateUrlPreview();
        }
      }

      return slug;
    }

    function updateUrlPreview() {
      const lang = langSelect.value || 'es';
      const slug = slugInput.value.trim() || '[slug]';
      urlPreview.textContent = `/${lang}/blog/${slug}`;
      if (serpSlug) serpSlug.textContent = slug;
    }

    titleInput?.addEventListener('input', () => {
      if (!slugManual || isNewInput.value === 'true') {
        slugInput.value = slugify(titleInput.value);
      }
      updateUrlPreview();
      updateSerp();
    });

    slugInput?.addEventListener('input', () => {
      slugManual = true;
      updateUrlPreview();
    });

    langSelect?.addEventListener('change', updateUrlPreview);

    function updateSerp() {
      const title = metaTitleInput.value.trim() || titleInput.value.trim() || 'Título del artículo en Google';
      const desc = metaDescInput.value.trim() || document.getElementById('blog-excerpt')?.value?.trim() || 'Descripción del artículo...';

      serpTitle.textContent = title;
      serpDesc.textContent = desc;

      metaTitleCount.textContent = `${metaTitleInput.value.length} / 60`;
      metaDescCount.textContent = `${metaDescInput.value.length} / 160`;
    }

    metaTitleInput?.addEventListener('input', updateSerp);
    metaDescInput?.addEventListener('input', updateSerp);
    updateSerp();

    // Hero image upload
    heroUploadInput?.addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      const currentSlug = getOrGenerateSlug();

      window.showToast?.('Optimizando y subiendo imagen para Blog...', 'info');

      const formData = new FormData();
      formData.append('file', file);
      formData.append('type', 'blogs');
      formData.append('folder', 'Blog');
      formData.append('slug', currentSlug);

      try {
        const res = await fetch('/api/admin/upload', {
          method: 'POST',
          body: formData,
          credentials: 'same-origin',
        });
        const data = await res.json();
        const imageUrl = data.url || data.path || data.file?.path;

        if (res.ok && (data.success || data.ok) && imageUrl) {
          heroImageInput.value = imageUrl;
          if (heroPreview) {
            heroPreview.src = imageUrl;
          }
          window.showToast?.(`Imagen guardada en /images/Blog/${currentSlug}/`, 'success');
        } else {
          window.showToast?.(data.error || 'Error al subir la imagen.', 'error');
        }
      } catch (err: any) {
        console.error('[BLOG HERO UPLOAD ERROR]:', err);
        window.showToast?.(err?.message || 'Error al conectar con el servidor.', 'error');
      } finally {
        heroUploadInput.value = '';
      }
    });

    // Sections builder
    const sectionsContainer = document.getElementById('sections-container');
    const addSectionBtn = document.getElementById('add-section-btn');

    function bindSectionCard(card) {
      card.querySelector('.remove-section-btn')?.addEventListener('click', () => {
        card.remove();
      });
    }

    sectionsContainer.querySelectorAll('.section-card').forEach(bindSectionCard);

    addSectionBtn?.addEventListener('click', () => {
      const count = sectionsContainer.querySelectorAll('.section-card').length + 1;
      const card = document.createElement('div');
      card.className = 'section-card bg-[#09111C] border border-slate-800 rounded-2xl p-5 relative group';
      card.innerHTML = `
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg bg-[#c9a84c]/20 text-[#f6d06a] border border-[#c9a84c]/40">
            Sección ${count}
          </span>
          <button
            type="button"
            class="remove-section-btn text-slate-400 hover:text-red-400 p-1 text-sm transition-colors"
            title="Eliminar sección"
          >
            <i class="bi bi-trash"></i>
          </button>
        </div>
        <div class="space-y-4">
          <div>
            <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Subtítulo de la Sección</label>
            <input
              type="text"
              class="section-heading-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-white font-semibold text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
              placeholder="Subtítulo de la sección"
            />
          </div>
          <div>
            <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Párrafos (separa párrafos con doble enter)</label>
            <textarea
              rows="4"
              class="section-paragraphs-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-slate-200 text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
              placeholder="Contenido de la sección..."
            ></textarea>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div>
              <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Imagen de la Sección (opcional)</label>
              <input
                type="text"
                class="section-image-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-slate-300 font-mono text-xs focus:outline-none focus:border-[#c9a84c]"
                placeholder="/images/Blog/seccion.webp"
              />
            </div>
            <div>
              <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Cita Destacada / Resaltado (opcional)</label>
              <input
                type="text"
                class="section-highlight-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-slate-300 text-xs focus:outline-none focus:border-[#c9a84c]"
                placeholder="Frase inspiradora o dato curioso"
              />
            </div>
          </div>
        </div>
      `;
      sectionsContainer.appendChild(card);
      bindSectionCard(card);
    });

    // Tips builder
    const tipsList = document.getElementById('tips-list');
    const addTipBtn = document.getElementById('add-tip-btn');

    function bindTipItem(row) {
      row.querySelector('.remove-tip-btn')?.addEventListener('click', () => {
        row.remove();
      });
    }

    tipsList.querySelectorAll('.tip-item').forEach(bindTipItem);

    addTipBtn?.addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'tip-item flex items-center gap-2';
      row.innerHTML = `
        <i class="bi bi-check2-circle text-amber-400 text-sm"></i>
        <input
          type="text"
          class="tip-input flex-1 px-3 py-1.5 rounded-lg bg-[#09111C] border border-slate-700/80 text-white text-xs focus:outline-none focus:border-[#c9a84c]"
          placeholder="Nuevo consejo para el viajero"
        />
        <button type="button" class="remove-tip-btn text-slate-500 hover:text-red-400 p-1 text-xs">
          <i class="bi bi-x-lg"></i>
        </button>
      `;
      tipsList.appendChild(row);
      bindTipItem(row);
      row.querySelector('input')?.focus();
    });

    // Submit blog
    async function submitBlogForm() {
      const isNew = isNewInput.value === 'true';
      const originalId = originalIdInput.value;
      const title = titleInput.value.trim();
      const lang = langSelect.value;
      const slug = (slugInput.value || slugify(title)).trim();

      if (!title) {
        window.showToast?.('Por favor ingresa el título del artículo.', 'error');
        titleInput.focus();
        return;
      }

      if (!slug) {
        window.showToast?.('Por favor define el slug del artículo.', 'error');
        slugInput.focus();
        return;
      }

      // Secciones
      const sections = [];
      document.querySelectorAll('.section-card').forEach((card) => {
        const heading = card.querySelector('.section-heading-input')?.value?.trim() || null;
        const rawParas = card.querySelector('.section-paragraphs-input')?.value || '';
        const paragraphs = rawParas
          .split(/\n\s*\n/)
          .map((p) => p.trim())
          .filter(Boolean);

        const image = card.querySelector('.section-image-input')?.value?.trim() || null;
        const highlight = card.querySelector('.section-highlight-input')?.value?.trim() || null;

        if (heading || paragraphs.length > 0 || image || highlight) {
          sections.push({
            heading,
            paragraphs: paragraphs.length > 0 ? paragraphs : [''],
            image,
            highlight,
          });
        }
      });

      // Tips
      const tips = Array.from(document.querySelectorAll('.tip-input'))
        .map((i) => i.value.trim())
        .filter(Boolean);

      const payload = {
        id: `${lang}/${slug}`,
        lang,
        slug,
        data: {
          title,
          date: document.getElementById('blog-date')?.value?.trim() || '',
          readTime: document.getElementById('blog-read-time')?.value?.trim() || '5 min de lectura',
          views: '1.2k',
          author: document.getElementById('blog-author')?.value?.trim() || 'Equipo Peru Beyond',
          category: categorySelect.value,
          heroImage: heroImageInput.value.trim() || '/images/Blog/sacsayhuaman.webp',
          heroPosition: 'center',
          excerpt: document.getElementById('blog-excerpt')?.value?.trim() || '',
          sections,
          tips,
          conclusion: document.getElementById('blog-conclusion')?.value?.trim() || '',
          metaTitle: metaTitleInput.value.trim() || '',
          metaDescription: metaDescInput.value.trim() || '',
          keywords: document.getElementById('blog-keywords')?.value?.trim() || '',
        },
      };

      if (!isNew && originalId) {
        payload.originalId = originalId;
      }

      window.showToast?.('Guardando artículo en el sistema...', 'info');

      try {
        const method = isNew ? 'POST' : 'PUT';
        const res = await fetch('/api/admin/blogs', {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          window.showToast?.('¡Artículo guardado exitosamente!', 'success');
          setTimeout(() => {
            window.location.href = `/admin/blogs/editor?id=${encodeURIComponent(payload.id)}`;
          }, 800);
        } else {
          window.showToast?.(data.error || 'Error al guardar el artículo.', 'error');
        }
      } catch (err) {
        window.showToast?.('Error al conectar con el servidor.', 'error');
      }
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBlogForm();
    });

    document.getElementById('save-blog-btn-top')?.addEventListener('click', submitBlogForm);
  </script>

</AdminLayout>
