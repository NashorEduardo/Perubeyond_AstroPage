---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getTourById, listAllTours } from '../../../lib/tours';

export const prerender = false;

const url = new URL(Astro.request.url);
const tourId = url.searchParams.get('id');
const isNew = url.searchParams.get('new') === '1' || !tourId;

let tour = null;
if (!isNew && tourId) {
  tour = await getTourById(tourId);
}

// Obtener todas las categorías existentes para sugerencias
const allTours = await listAllTours();
const existingCategories = Array.from(new Set(allTours.map((t) => t.category))).filter(Boolean).sort();

const initialData = tour
  ? {
      id: tour.id,
      lang: tour.lang || 'es',
      category: tour.category || 'cusco',
      slug: tour.slug || '',
      title: tour.data.title || '',
      price: tour.data.price || '',
      duration: tour.data.duration || '',
      image: tour.data.image || '',
      wetravelUuid: tour.data.wetravelUuid || '',
      description: tour.data.description || '',
      availability: tour.data.availability || '',
      frequency: tour.data.frequency || '',
      difficulty: tour.data.difficulty || '',
      includes: tour.data.includes || [],
      excludes: tour.data.excludes || [],
      itinerary: tour.data.itinerary || [],
      gallery: tour.data.gallery || [],
      videoUrl: tour.data.videoUrl || '',
      faq: tour.data.faq || [],
      metaTitle: tour.data.metaTitle || '',
      metaDescription: tour.data.metaDescription || '',
      ogImage: tour.data.ogImage || '',
      body: tour.body || '',
    }
  : {
      id: '',
      lang: 'es',
      category: 'cusco',
      slug: '',
      title: '',
      price: '50',
      duration: '1 Día',
      image: '',
      wetravelUuid: '',
      description: '',
      availability: 'Todos los días',
      frequency: 'Salidas diarias',
      difficulty: 'Grado I – caminata ligera',
      includes: ['Transporte turístico', 'Guía profesional bilingüe'],
      excludes: ['Boleto turístico', 'Gastos personales'],
      itinerary: [
        {
          day: 1,
          title: 'Inicio del recorrido y visita guiada',
          description: 'Recojo en el hotel y traslado para dar inicio a la experiencia con nuestro guía oficial.',
          activities: ['Recojo en hotel', 'Visita guiada'],
          images: [],
        },
      ],
      gallery: [],
      videoUrl: '',
      faq: [],
      metaTitle: '',
      metaDescription: '',
      ogImage: '',
      body: '',
    };
---

<AdminLayout title={isNew ? 'Nuevo Tour' : `Editar: ${initialData.title}`} activeTab="tours">
  
  <!-- Top Navigation & Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-3">
      <a
        href="/admin/tours"
        class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors"
        title="Volver al listado"
      >
        <i class="bi bi-arrow-left text-lg"></i>
      </a>
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-white tracking-wide">
          {isNew ? 'Crear Nuevo Tour' : 'Editar Tour'}
        </h2>
        <div class="text-xs text-slate-400 mt-0.5">
          {isNew ? 'Completa los datos para publicar un nuevo paquete' : `Archivo: src/content/tours/${initialData.id}.md`}
        </div>
      </div>
    </div>

    <!-- Top Action Buttons -->
    <div class="flex items-center gap-3">
      {!isNew && (
        <a
          href={`/${initialData.lang}/tours/${initialData.category}/${initialData.slug}`}
          target="_blank"
          rel="noopener"
          class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-semibold inline-flex items-center gap-1.5 transition-colors"
        >
          <i class="bi bi-box-arrow-up-right"></i>
          <span class="hidden sm:inline">Ver en web</span>
        </a>
      )}

      <button
        type="button"
        id="save-tour-btn-top"
        class="px-5 py-2 rounded-xl bg-gradient-to-r from-[#c9a84c] to-[#f6d06a] hover:from-[#d8b556] hover:to-[#fae086] text-slate-950 font-bold text-xs tracking-wide shadow-lg shadow-[#c9a84c]/20 transition-all inline-flex items-center gap-2 cursor-pointer"
      >
        <i class="bi bi-floppy-fill"></i>
        <span>Guardar Tour</span>
      </button>
    </div>
  </div>

  <!-- Main Tour Editor Form -->
  <form id="tour-form" class="space-y-8">
    <input type="hidden" id="tour-original-id" value={initialData.id} />
    <input type="hidden" id="is-new" value={isNew ? 'true' : 'false'} />

    <!-- SECCIÓN 1: DATOS GENERALES Y RUTA -->
    <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl">
      <div class="flex items-center gap-2.5 pb-4 border-b border-slate-800 mb-6">
        <i class="bi bi-card-heading text-[#c9a84c] text-xl"></i>
        <h3 class="text-base font-bold text-white">1. Información General y Enlace URL</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <!-- Título -->
        <div class="md:col-span-8">
          <label for="tour-title" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Título del Tour *
          </label>
          <input
            type="text"
            id="tour-title"
            required
            value={initialData.title}
            placeholder="Ej: City Tour Cusco + Qoricancha y 4 Ruinas"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c9a84c]"
          />
        </div>

        <!-- Idioma -->
        <div class="md:col-span-4">
          <label for="tour-lang" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Idioma *
          </label>
          <select
            id="tour-lang"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-sm focus:outline-none focus:border-[#c9a84c]"
          >
            <option value="es" selected={initialData.lang === 'es'}>Español (es)</option>
            <option value="en" selected={initialData.lang === 'en'}>Inglés (en)</option>
            <option value="pt" selected={initialData.lang === 'pt'}>Portugués (pt)</option>
          </select>
        </div>

        <!-- Categoría / Destino -->
        <div class="md:col-span-6">
          <label for="tour-category" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Categoría / Destino *
          </label>
          <div class="relative">
            <input
              type="text"
              id="tour-category"
              list="categories-list"
              required
              value={initialData.category}
              placeholder="Ej: cusco, machu-picchu, arequipa"
              class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c9a84c]"
            />
            <datalist id="categories-list">
              {existingCategories.map((c) => (
                <option value={c} />
              ))}
            </datalist>
          </div>
        </div>

        <!-- Slug -->
        <div class="md:col-span-6">
          <label for="tour-slug" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Slug de la URL *
          </label>
          <input
            type="text"
            id="tour-slug"
            required
            value={initialData.slug}
            placeholder="ej-city-tour-cusco"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 font-mono text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c9a84c]"
          />
        </div>

        <!-- URL Preview -->
        <div class="md:col-span-12 p-3 rounded-xl bg-[#09111C]/60 border border-slate-800 text-xs font-mono text-slate-400 flex items-center gap-2">
          <i class="bi bi-link-45deg text-base text-[#c9a84c]"></i>
          <span>Ruta web pública:</span>
          <span id="url-preview" class="text-white font-semibold">
            /{initialData.lang}/tours/{initialData.category}/{initialData.slug || '[slug]'}
          </span>
        </div>
      </div>
    </div>

    <!-- SECCIÓN 2: DATOS OPERATIVOS Y RESERVAS -->
    <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl">
      <div class="flex items-center gap-2.5 pb-4 border-b border-slate-800 mb-6">
        <i class="bi bi-sliders text-[#c9a84c] text-xl"></i>
        <h3 class="text-base font-bold text-white">2. Datos Operativos y Conversión</h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-5">
        <!-- Precio -->
        <div>
          <label for="tour-price" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Precio desde (USD) *
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 font-bold">$</span>
            <input
              type="text"
              id="tour-price"
              required
              value={initialData.price}
              placeholder="45"
              class="w-full pl-8 pr-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white font-semibold text-sm focus:outline-none focus:border-[#c9a84c]"
            />
          </div>
        </div>

        <!-- Duración -->
        <div>
          <label for="tour-duration" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Duración *
          </label>
          <input
            type="text"
            id="tour-duration"
            required
            value={initialData.duration}
            placeholder="1 Día o 1/2 Día"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-sm focus:outline-none focus:border-[#c9a84c]"
          />
        </div>

        <!-- Disponibilidad -->
        <div>
          <label for="tour-availability" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Disponibilidad
          </label>
          <input
            type="text"
            id="tour-availability"
            value={initialData.availability}
            placeholder="Todos los días"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-sm focus:outline-none focus:border-[#c9a84c]"
          />
        </div>

        <!-- Frecuencia -->
        <div>
          <label for="tour-frequency" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Frecuencia
          </label>
          <input
            type="text"
            id="tour-frequency"
            value={initialData.frequency}
            placeholder="Salidas diarias"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-sm focus:outline-none focus:border-[#c9a84c]"
          />
        </div>

        <!-- Dificultad -->
        <div class="sm:col-span-2">
          <label for="tour-difficulty" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Nivel de Dificultad
          </label>
          <input
            type="text"
            id="tour-difficulty"
            value={initialData.difficulty}
            placeholder="Ej: Grado I – caminata ligera / Fácil / Moderado"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-sm focus:outline-none focus:border-[#c9a84c]"
          />
        </div>

        <!-- WeTravel UUID -->
        <div class="sm:col-span-2">
          <label for="tour-wetravel" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            UUID WeTravel (Botón "Book Now")
          </label>
          <input
            type="text"
            id="tour-wetravel"
            value={initialData.wetravelUuid}
            placeholder="ej: 12345678"
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 font-mono text-white text-sm focus:outline-none focus:border-[#c9a84c]"
          />
        </div>
      </div>
    </div>

    <!-- SECCIÓN 3: IMÁGENES Y GALERÍA -->
    <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl">
      <div class="flex items-center gap-2.5 pb-4 border-b border-slate-800 mb-6">
        <i class="bi bi-images text-[#c9a84c] text-xl"></i>
        <h3 class="text-base font-bold text-white">3. Imagen Principal y Galería WebP</h3>
      </div>

      <!-- Imagen Principal -->
      <div class="mb-6">
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
          Foto Principal del Tour (Hero) *
        </label>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <div class="relative w-24 h-24 rounded-2xl overflow-hidden bg-slate-900 border border-slate-700 flex-shrink-0 flex items-center justify-center">
            <img
              id="hero-preview"
              src={initialData.image || '/images/PeruBeyond/Logo.webp'}
              alt="Preview"
              class="w-full h-full object-cover"
              onerror="this.src='/images/PeruBeyond/Logo.webp'"
            />
          </div>
          <div class="flex-1 space-y-2">
            <div class="flex gap-2">
              <input
                type="text"
                id="tour-image"
                required
                value={initialData.image}
                placeholder="/images/Tours/[slug]/portada.webp"
                class="flex-1 px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 font-mono text-white text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
              />
              <label class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-[#f6d06a] border border-slate-700 text-xs font-bold flex items-center gap-1.5 cursor-pointer flex-shrink-0">
                <i class="bi bi-cloud-arrow-up-fill text-sm"></i>
                <span>Subir WebP</span>
                <input type="file" id="hero-upload-input" accept="image/*" class="hidden" />
              </label>
            </div>
            <p class="text-[11px] text-slate-400">
              Al subir cualquier archivo (JPEG, PNG, etc.), se optimizará automáticamente a formato <strong>WebP</strong> (calidad 80).
            </p>
          </div>
        </div>
      </div>

      <!-- Galería de Fotos -->
      <div>
        <div class="flex items-center justify-between mb-3">
          <label class="text-xs font-semibold uppercase tracking-wider text-slate-300">
            Fotos de la Galería
          </label>
          <label class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold flex items-center gap-1.5 cursor-pointer">
            <i class="bi bi-plus-circle text-xs text-[#c9a84c]"></i>
            <span>Subir a Galería</span>
            <input type="file" id="gallery-upload-input" accept="image/*" multiple class="hidden" />
          </label>
        </div>

        <div id="gallery-container" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3">
          {initialData.gallery.map((imgUrl, idx) => (
            <div class="gallery-item relative group rounded-xl overflow-hidden bg-slate-900 border border-slate-800 aspect-video">
              <img src={imgUrl} alt="Galería" class="w-full h-full object-cover" />
              <input type="hidden" class="gallery-url-input" value={imgUrl} />
              <button
                type="button"
                class="remove-gallery-btn absolute top-1 right-1 w-6 h-6 rounded-md bg-red-600/90 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
                title="Quitar foto"
              >
                <i class="bi bi-x text-sm"></i>
              </button>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- SECCIÓN 4: ITINERARIO DINÁMICO -->
    <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-6">
        <div class="flex items-center gap-2.5">
          <i class="bi bi-calendar2-range text-[#c9a84c] text-xl"></i>
          <div>
            <h3 class="text-base font-bold text-white">4. Itinerario Dinámico del Tour</h3>
            <p class="text-xs text-slate-400">Agrega o reordena los días y etapas del recorrido</p>
          </div>
        </div>

        <button
          type="button"
          id="add-itinerary-day-btn"
          class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-[#f6d06a] border border-slate-700 text-xs font-bold flex items-center gap-1.5 cursor-pointer"
        >
          <i class="bi bi-plus-lg"></i>
          <span>Agregar Día</span>
        </button>
      </div>

      <div id="itinerary-list" class="space-y-4">
        {initialData.itinerary.map((day, idx) => (
          <div class="itinerary-day-card bg-[#09111C] border border-slate-800 rounded-2xl p-4 sm:p-5 relative group">
            <div class="flex items-center justify-between mb-3">
              <span class="day-number-badge text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg bg-[#c9a84c]/20 text-[#f6d06a] border border-[#c9a84c]/40">
                Día {day.day || idx + 1}
              </span>
              <button
                type="button"
                class="remove-day-btn text-slate-400 hover:text-red-400 p-1 text-sm transition-colors"
                title="Eliminar este día"
              >
                <i class="bi bi-trash"></i>
              </button>
            </div>

            <div class="space-y-3">
              <input
                type="text"
                class="day-title-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-white font-semibold text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
                placeholder="Título del día o etapa"
                value={day.title}
              />
              <textarea
                rows="3"
                class="day-desc-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-slate-200 text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
                placeholder="Descripción detallada de las actividades de este día..."
              >{day.description || ''}</textarea>
              <input
                type="text"
                class="day-activities-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-slate-400 text-xs focus:outline-none focus:border-[#c9a84c]"
                placeholder="Actividades clave separadas por comas (ej: Recojo en hotel, Visita Qoricancha, Almuerzo)"
                value={(day.activities || []).join(', ')}
              />
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- SECCIÓN 5: QUÉ INCLUYE Y QUÉ NO INCLUYE -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Incluye -->
      <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 shadow-xl">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
          <div class="flex items-center gap-2">
            <i class="bi bi-check-circle-fill text-emerald-400 text-lg"></i>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider">Qué Incluye</h3>
          </div>
          <button
            type="button"
            id="add-include-btn"
            class="text-xs text-[#c9a84c] hover:text-[#f6d06a] font-semibold flex items-center gap-1 cursor-pointer"
          >
            <i class="bi bi-plus-lg"></i> Agregar
          </button>
        </div>

        <div id="includes-list" class="space-y-2">
          {initialData.includes.map((item) => (
            <div class="include-item flex items-center gap-2">
              <i class="bi bi-check2 text-emerald-400 text-sm"></i>
              <input
                type="text"
                class="include-input flex-1 px-3 py-1.5 rounded-lg bg-[#09111C] border border-slate-700/80 text-white text-xs focus:outline-none focus:border-[#c9a84c]"
                value={item}
              />
              <button type="button" class="remove-list-item-btn text-slate-500 hover:text-red-400 p-1 text-xs">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
          ))}
        </div>
      </div>

      <!-- No Incluye -->
      <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 shadow-xl">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
          <div class="flex items-center gap-2">
            <i class="bi bi-x-circle-fill text-red-400 text-lg"></i>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider">Qué No Incluye</h3>
          </div>
          <button
            type="button"
            id="add-exclude-btn"
            class="text-xs text-[#c9a84c] hover:text-[#f6d06a] font-semibold flex items-center gap-1 cursor-pointer"
          >
            <i class="bi bi-plus-lg"></i> Agregar
          </button>
        </div>

        <div id="excludes-list" class="space-y-2">
          {initialData.excludes.map((item) => (
            <div class="exclude-item flex items-center gap-2">
              <i class="bi bi-x text-red-400 text-sm"></i>
              <input
                type="text"
                class="exclude-input flex-1 px-3 py-1.5 rounded-lg bg-[#09111C] border border-slate-700/80 text-white text-xs focus:outline-none focus:border-[#c9a84c]"
                value={item}
              />
              <button type="button" class="remove-list-item-btn text-slate-500 hover:text-red-400 p-1 text-xs">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- SECCIÓN 6: RESUMEN Y CONTENIDO GENERAL -->
    <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl">
      <div class="flex items-center gap-2.5 pb-4 border-b border-slate-800 mb-6">
        <i class="bi bi-file-text text-[#c9a84c] text-xl"></i>
        <h3 class="text-base font-bold text-white">6. Resumen y Contenido Detallado</h3>
      </div>

      <div class="space-y-5">
        <div>
          <label for="tour-description" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Resumen o Cita Destacada
          </label>
          <textarea
            id="tour-description"
            rows="3"
            placeholder="Breve párrafo introductorio o cita inspiracional sobre la experiencia..."
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
          >{initialData.description}</textarea>
        </div>

        <div>
          <label for="tour-body" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
            Contenido Completo en Markdown (opcional)
          </label>
          <textarea
            id="tour-body"
            rows="6"
            placeholder="Escribe detalles adicionales, recomendaciones de viaje o notas en formato Markdown..."
            class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 font-mono text-white text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
          >{initialData.body}</textarea>
        </div>
      </div>
    </div>

    <!-- SECCIÓN 7: METADATOS SEO Y GOOGLE SERP PREVIEW -->
    <div class="bg-[#0D1B2E] border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl">
      <div class="flex items-center gap-2.5 pb-4 border-b border-slate-800 mb-6">
        <i class="bi bi-google text-[#c9a84c] text-xl"></i>
        <h3 class="text-base font-bold text-white">7. Optimización SEO y Vista Previa en Google</h3>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Inputs SEO -->
        <div class="lg:col-span-7 space-y-4">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="tour-meta-title" class="text-xs font-semibold uppercase tracking-wider text-slate-300">
                Meta Title
              </label>
              <span id="meta-title-count" class="text-[11px] text-slate-400 font-mono">0 / 60</span>
            </div>
            <input
              type="text"
              id="tour-meta-title"
              value={initialData.metaTitle}
              placeholder="Ej: Tour a Machu Picchu 1 Día desde Cusco | Peru Beyond"
              class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="tour-meta-desc" class="text-xs font-semibold uppercase tracking-wider text-slate-300">
                Meta Description
              </label>
              <span id="meta-desc-count" class="text-[11px] text-slate-400 font-mono">0 / 160</span>
            </div>
            <textarea
              id="tour-meta-desc"
              rows="3"
              placeholder="Descripción atractiva para los motores de búsqueda..."
              class="w-full px-4 py-2.5 rounded-xl bg-[#09111C] border border-slate-700/80 text-white text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
            >{initialData.metaDescription}</textarea>
          </div>
        </div>

        <!-- Google SERP Simulation -->
        <div class="lg:col-span-5 flex flex-col justify-center">
          <div class="text-[11px] uppercase font-semibold text-slate-400 mb-2">Simulación de Búsqueda (Google)</div>
          <div class="bg-white rounded-2xl p-4 shadow text-left font-sans">
            <div class="flex items-center gap-2 mb-1">
              <div class="w-4 h-4 rounded-full bg-slate-200 flex items-center justify-center text-[10px] text-slate-700 font-bold">
                P
              </div>
              <div class="text-xs text-[#202124] leading-none">
                perubeyond.com &rsaquo; {initialData.lang} &rsaquo; <span id="serp-category">{initialData.category}</span>
              </div>
            </div>
            <div id="serp-title" class="text-[#1a0dab] text-sm font-medium hover:underline cursor-pointer leading-snug line-clamp-1">
              {initialData.metaTitle || initialData.title || 'Título del tour en Google'}
            </div>
            <div id="serp-desc" class="text-[#4d5156] text-xs mt-1 leading-relaxed line-clamp-2">
              {initialData.metaDescription || initialData.description || 'Descripción del tour optimizada para motores de búsqueda de Google y redes sociales...'}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Botón de Guardado Inferior -->
    <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
      <a
        href="/admin/tours"
        class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-semibold transition-colors"
      >
        Cancelar
      </a>
      <button
        type="submit"
        id="save-tour-btn-bottom"
        class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-[#c9a84c] to-[#f6d06a] hover:from-[#d8b556] hover:to-[#fae086] text-slate-950 font-bold text-xs tracking-wide shadow-lg shadow-[#c9a84c]/20 transition-all inline-flex items-center gap-2 cursor-pointer"
      >
        <i class="bi bi-floppy-fill"></i>
        <span>Guardar y Publicar Tour</span>
      </button>
    </div>

  </form>

  <script is:inline>
    // Elements
    const form = document.getElementById('tour-form');
    const originalIdInput = document.getElementById('tour-original-id');
    const isNewInput = document.getElementById('is-new');
    const titleInput = document.getElementById('tour-title');
    const langSelect = document.getElementById('tour-lang');
    const categoryInput = document.getElementById('tour-category');
    const slugInput = document.getElementById('tour-slug');
    const urlPreview = document.getElementById('url-preview');

    const heroImageInput = document.getElementById('tour-image');
    const heroPreview = document.getElementById('hero-preview');
    const heroUploadInput = document.getElementById('hero-upload-input');
    const galleryUploadInput = document.getElementById('gallery-upload-input');
    const galleryContainer = document.getElementById('gallery-container');

    const metaTitleInput = document.getElementById('tour-meta-title');
    const metaDescInput = document.getElementById('tour-meta-desc');
    const metaTitleCount = document.getElementById('meta-title-count');
    const metaDescCount = document.getElementById('meta-desc-count');
    const serpTitle = document.getElementById('serp-title');
    const serpDesc = document.getElementById('serp-desc');
    const serpCategory = document.getElementById('serp-category');

    let slugManual = Boolean(slugInput.value);

    // Auto slugify helper
    function slugify(text) {
      return text
        .toString()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 80);
    }

    // Obtener o autogenerar slug para nombrar la carpeta exclusiva del tour
    function getOrGenerateSlug() {
      let slug = slugInput.value?.trim();
      const title = titleInput.value?.trim();

      if (!slug && title) {
        slug = slugify(title);
        slugInput.value = slug;
        updateUrlPreview();
      }

      if (!slug) {
        const promptTitle = prompt('Para organizar las fotos en su propia carpeta, escribe el título o slug del tour:');
        if (promptTitle && promptTitle.trim()) {
          titleInput.value = promptTitle.trim();
          slug = slugify(promptTitle);
          slugInput.value = slug;
          updateUrlPreview();
        } else {
          slug = 'tour-' + Date.now().toString(36);
          slugInput.value = slug;
          updateUrlPreview();
        }
      }

      return slug;
    }

    function updateUrlPreview() {
      const lang = langSelect.value || 'es';
      const cat = (categoryInput.value || 'cusco').toLowerCase().trim();
      const slug = slugInput.value.trim() || '[slug]';
      urlPreview.textContent = `/${lang}/tours/${cat}/${slug}`;
      if (serpCategory) serpCategory.textContent = cat;
    }

    titleInput?.addEventListener('input', () => {
      if (!slugManual || isNewInput.value === 'true') {
        slugInput.value = slugify(titleInput.value);
      }
      updateUrlPreview();
      updateSerp();
    });

    slugInput?.addEventListener('input', () => {
      slugManual = true;
      updateUrlPreview();
    });

    langSelect?.addEventListener('change', updateUrlPreview);
    categoryInput?.addEventListener('input', updateUrlPreview);

    // SEO counters and SERP update
    function updateSerp() {
      const title = metaTitleInput.value.trim() || titleInput.value.trim() || 'Título del tour en Google';
      const desc = metaDescInput.value.trim() || 'Descripción del tour optimizada para motores de búsqueda de Google y redes sociales...';

      serpTitle.textContent = title;
      serpDesc.textContent = desc;

      metaTitleCount.textContent = `${metaTitleInput.value.length} / 60`;
      metaDescCount.textContent = `${metaDescInput.value.length} / 160`;
    }

    metaTitleInput?.addEventListener('input', updateSerp);
    metaDescInput?.addEventListener('input', updateSerp);
    updateSerp();

    // Image Upload (Hero)
    heroUploadInput?.addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      const currentSlug = getOrGenerateSlug();

      window.showToast?.('Optimizando y subiendo imagen...', 'info');

      const formData = new FormData();
      formData.append('file', file);
      formData.append('type', 'tours');
      formData.append('folder', 'Tours');
      formData.append('slug', currentSlug);

      try {
        const res = await fetch('/api/admin/upload', {
          method: 'POST',
          body: formData,
          credentials: 'same-origin',
        });
        const data = await res.json();
        const imageUrl = data.url || data.path || data.file?.path;

        if (res.ok && (data.success || data.ok) && imageUrl) {
          heroImageInput.value = imageUrl;
          if (heroPreview) {
            heroPreview.src = imageUrl;
          }
          window.showToast?.(`Imagen guardada en /images/Tours/${currentSlug}/`, 'success');
        } else {
          window.showToast?.(data.error || 'Error al subir la imagen.', 'error');
        }
      } catch (err) {
        console.error('[HERO UPLOAD ERROR]:', err);
        window.showToast?.(err?.message || 'Error al conectar con el servidor.', 'error');
      } finally {
        heroUploadInput.value = '';
      }
    });

    // Gallery Upload
    galleryUploadInput?.addEventListener('change', async (e) => {
      const files = Array.from(e.target.files || []);
      if (files.length === 0) return;

      const currentSlug = getOrGenerateSlug();

      window.showToast?.(`Subiendo ${files.length} foto(s) a /images/Tours/${currentSlug}/...`, 'info');

      let successCount = 0;
      for (const file of files) {
        const formData = new FormData();
        formData.append('file', file);
        formData.append('type', 'tours');
        formData.append('folder', 'Tours');
        formData.append('slug', currentSlug);

        try {
          const res = await fetch('/api/admin/upload', {
            method: 'POST',
            body: formData,
            credentials: 'same-origin',
          });
          const data = await res.json();
          const imageUrl = data.url || data.path || data.file?.path;

          if (res.ok && (data.success || data.ok) && imageUrl) {
            addGalleryItem(imageUrl);
            successCount++;
          } else {
            window.showToast?.(data.error || `Error al subir ${file.name}`, 'error');
          }
        } catch (err) {
          console.error('[GALLERY UPLOAD ERROR]:', err);
          window.showToast?.(`Error al subir ${file.name}`, 'error');
        }
      }

      if (successCount > 0) {
        window.showToast?.(`${successCount} foto(s) agregadas a /images/Tours/${currentSlug}/`, 'success');
      }
      galleryUploadInput.value = '';
    });

    function addGalleryItem(url) {
      const item = document.createElement('div');
      item.className = 'gallery-item relative group rounded-xl overflow-hidden bg-slate-900 border border-slate-800 aspect-video';
      item.innerHTML = `
        <img src="${url}" alt="Galería" class="w-full h-full object-cover" />
        <input type="hidden" class="gallery-url-input" value="${url}" />
        <button
          type="button"
          class="remove-gallery-btn absolute top-1 right-1 w-6 h-6 rounded-md bg-red-600/90 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
          title="Quitar foto"
        >
          <i class="bi bi-x text-sm"></i>
        </button>
      `;
      galleryContainer.appendChild(item);
      bindGalleryRemove(item.querySelector('.remove-gallery-btn'));
    }

    function bindGalleryRemove(btn) {
      btn?.addEventListener('click', () => {
        btn.closest('.gallery-item')?.remove();
      });
    }

    document.querySelectorAll('.remove-gallery-btn').forEach(bindGalleryRemove);

    // Itinerary builder
    const itineraryList = document.getElementById('itinerary-list');
    const addItineraryDayBtn = document.getElementById('add-itinerary-day-btn');

    function renumberDays() {
      const cards = itineraryList.querySelectorAll('.itinerary-day-card');
      cards.forEach((card, idx) => {
        const badge = card.querySelector('.day-number-badge');
        if (badge) badge.textContent = `Día ${idx + 1}`;
      });
    }

    function bindDayCard(card) {
      const removeBtn = card.querySelector('.remove-day-btn');
      removeBtn?.addEventListener('click', () => {
        card.remove();
        renumberDays();
      });
    }

    itineraryList.querySelectorAll('.itinerary-day-card').forEach(bindDayCard);

    addItineraryDayBtn?.addEventListener('click', () => {
      const count = itineraryList.querySelectorAll('.itinerary-day-card').length + 1;
      const card = document.createElement('div');
      card.className = 'itinerary-day-card bg-[#09111C] border border-slate-800 rounded-2xl p-4 sm:p-5 relative group';
      card.innerHTML = `
        <div class="flex items-center justify-between mb-3">
          <span class="day-number-badge text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg bg-[#c9a84c]/20 text-[#f6d06a] border border-[#c9a84c]/40">
            Día ${count}
          </span>
          <button
            type="button"
            class="remove-day-btn text-slate-400 hover:text-red-400 p-1 text-sm transition-colors"
            title="Eliminar este día"
          >
            <i class="bi bi-trash"></i>
          </button>
        </div>
        <div class="space-y-3">
          <input
            type="text"
            class="day-title-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-white font-semibold text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
            placeholder="Título del día o etapa"
            value="Día ${count}: Actividades programadas"
          />
          <textarea
            rows="3"
            class="day-desc-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-slate-200 text-xs sm:text-sm focus:outline-none focus:border-[#c9a84c]"
            placeholder="Descripción detallada de las actividades de este día..."
          ></textarea>
          <input
            type="text"
            class="day-activities-input w-full px-3 py-2 rounded-xl bg-[#0D1B2E] border border-slate-700/80 text-slate-400 text-xs focus:outline-none focus:border-[#c9a84c]"
            placeholder="Actividades clave separadas por comas"
          />
        </div>
      `;
      itineraryList.appendChild(card);
      bindDayCard(card);
    });

    // Includes & Excludes
    const includesList = document.getElementById('includes-list');
    const excludesList = document.getElementById('excludes-list');
    const addIncludeBtn = document.getElementById('add-include-btn');
    const addExcludeBtn = document.getElementById('add-exclude-btn');

    function bindListItem(row) {
      row.querySelector('.remove-list-item-btn')?.addEventListener('click', () => {
        row.remove();
      });
    }

    document.querySelectorAll('.include-item, .exclude-item').forEach(bindListItem);

    addIncludeBtn?.addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'include-item flex items-center gap-2';
      row.innerHTML = `
        <i class="bi bi-check2 text-emerald-400 text-sm"></i>
        <input
          type="text"
          class="include-input flex-1 px-3 py-1.5 rounded-lg bg-[#09111C] border border-slate-700/80 text-white text-xs focus:outline-none focus:border-[#c9a84c]"
          placeholder="Nuevo beneficio incluido"
        />
        <button type="button" class="remove-list-item-btn text-slate-500 hover:text-red-400 p-1 text-xs">
          <i class="bi bi-x-lg"></i>
        </button>
      `;
      includesList.appendChild(row);
      bindListItem(row);
      row.querySelector('input')?.focus();
    });

    addExcludeBtn?.addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'exclude-item flex items-center gap-2';
      row.innerHTML = `
        <i class="bi bi-x text-red-400 text-sm"></i>
        <input
          type="text"
          class="exclude-input flex-1 px-3 py-1.5 rounded-lg bg-[#09111C] border border-slate-700/80 text-white text-xs focus:outline-none focus:border-[#c9a84c]"
          placeholder="Servicio no incluido"
        />
        <button type="button" class="remove-list-item-btn text-slate-500 hover:text-red-400 p-1 text-xs">
          <i class="bi bi-x-lg"></i>
        </button>
      `;
      excludesList.appendChild(row);
      bindListItem(row);
      row.querySelector('input')?.focus();
    });

    // Save Form Submission
    async function submitTourForm() {
      const isNew = isNewInput.value === 'true';
      const originalId = originalIdInput.value;
      const title = titleInput.value.trim();
      const lang = langSelect.value;
      const category = (categoryInput.value || 'cusco').toLowerCase().trim();
      const slug = (slugInput.value || slugify(title)).trim();

      if (!title) {
        window.showToast?.('Por favor ingresa el título del tour.', 'error');
        titleInput.focus();
        return;
      }

      if (!slug) {
        window.showToast?.('Por favor define el slug del tour.', 'error');
        slugInput.focus();
        return;
      }

      // Recompilar itinerario
      const itinerary = [];
      document.querySelectorAll('.itinerary-day-card').forEach((card, idx) => {
        const dTitle = card.querySelector('.day-title-input')?.value?.trim() || `Día ${idx + 1}`;
        const dDesc = card.querySelector('.day-desc-input')?.value?.trim() || '';
        const rawActivities = card.querySelector('.day-activities-input')?.value || '';
        const activities = rawActivities.split(',').map((a) => a.trim()).filter(Boolean);

        itinerary.push({
          day: idx + 1,
          title: dTitle,
          description: dDesc,
          activities,
        });
      });

      // Includes & Excludes
      const includes = Array.from(document.querySelectorAll('.include-input'))
        .map((i) => i.value.trim())
        .filter(Boolean);

      const excludes = Array.from(document.querySelectorAll('.exclude-input'))
        .map((i) => i.value.trim())
        .filter(Boolean);

      // Galería
      const gallery = Array.from(document.querySelectorAll('.gallery-url-input'))
        .map((i) => i.value.trim())
        .filter(Boolean);

      const payload = {
        id: `${lang}/${category}/${slug}`,
        lang,
        category,
        slug,
        data: {
          title,
          price: document.getElementById('tour-price')?.value?.trim() || '0',
          duration: document.getElementById('tour-duration')?.value?.trim() || '',
          image: heroImageInput.value.trim() || '/images/Tours/cusco.webp',
          wetravelUuid: document.getElementById('tour-wetravel')?.value?.trim() || '',
          description: document.getElementById('tour-description')?.value?.trim() || '',
          availability: document.getElementById('tour-availability')?.value?.trim() || '',
          frequency: document.getElementById('tour-frequency')?.value?.trim() || '',
          difficulty: document.getElementById('tour-difficulty')?.value?.trim() || '',
          includes,
          excludes,
          itinerary,
          gallery,
          metaTitle: metaTitleInput.value.trim() || '',
          metaDescription: metaDescInput.value.trim() || '',
        },
        body: document.getElementById('tour-body')?.value?.trim() || '',
      };

      if (!isNew && originalId) {
        payload.originalId = originalId;
      }

      window.showToast?.('Guardando tour en el sistema...', 'info');

      try {
        const method = isNew ? 'POST' : 'PUT';
        const res = await fetch('/api/admin/tours', {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          window.showToast?.('¡Tour guardado exitosamente!', 'success');
          setTimeout(() => {
            window.location.href = `/admin/tours/editor?id=${encodeURIComponent(payload.id)}`;
          }, 800);
        } else {
          window.showToast?.(data.error || 'Error al guardar el tour.', 'error');
        }
      } catch (err) {
        window.showToast?.('Error al conectar con el servidor.', 'error');
      }
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      submitTourForm();
    });

    document.getElementById('save-tour-btn-top')?.addEventListener('click', submitTourForm);
  </script>

</AdminLayout>
