<script is:inline>
(function () {
  // ── Video background ──
  var video = document.getElementById('lt-video');
  var poster = document.getElementById('lt-poster');
  if (video) {
    function showVideo() {
      video.style.opacity = '1';
      if (poster) poster.style.opacity = '0';
    }
    function playVideo() {
      video.muted = true;
      video.playsInline = true;
      var p = video.play();
      if (p !== undefined) {
        p.then(showVideo).catch(function () {
          video.style.opacity = '0';
          if (poster) poster.style.opacity = '1';
        });
      } else {
        showVideo();
      }
    }
    video.addEventListener('loadeddata', playVideo, { once: true });
    video.addEventListener('canplay', playVideo, { once: true });
    video.addEventListener('playing', showVideo);
    video.addEventListener('error', function () {
      video.style.display = 'none';
      if (poster) poster.style.opacity = '1';
    });
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden && video.paused && !video.error) playVideo();
    });
    setTimeout(function () {
      if (video.style.opacity !== '1' && !video.error) {
        video.load();
        playVideo();
      }
    }, 4000);
  }

  // ── Generic carousel factory ──
  function initCarousel(trackId, dotsId, autoMs) {
    var track = document.getElementById(trackId);
    var dotsWrap = document.getElementById(dotsId);
    if (!track || !dotsWrap) return;
    var dots = dotsWrap.querySelectorAll('.lt-blog-dot');
    var current = 0;
    var total = track.children.length;
    var interval;

    function goTo(i) {
      current = i;
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      dots.forEach(function (d, idx) {
        d.classList.toggle('lt-blog-dot--active', idx === current);
      });
    }

    function next() { goTo((current + 1) % total); }

    function startAuto() {
      clearInterval(interval);
      interval = setInterval(next, autoMs);
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        goTo(parseInt(dot.dataset.index));
        startAuto();
      });
    });

    var startX = 0;
    track.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX;
    }, { passive: true });
    track.addEventListener('touchend', function (e) {
      var diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) goTo((current + 1) % total);
        else goTo((current - 1 + total) % total);
        startAuto();
      }
    });

    startAuto();
  }

  initCarousel('reviewsTrack', 'reviewsDots', 5000);
  initCarousel('blogTrack', 'blogDots', 5000);
})();
</script>
