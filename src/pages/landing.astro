const socials = [
  { icon: 'bi-facebook',  href: 'https://www.facebook.com/perubeyond',          label: 'Facebook' },
  { icon: 'bi-instagram', href: 'https://www.instagram.com/perubeyond/',         label: 'Instagram' },
  { icon: 'bi-tiktok',    href: 'https://www.tiktok.com/@perubeyond_agency',     label: 'TikTok' },
  { icon: 'bi-youtube',   href: 'https://www.youtube.com/@perubeyond',           label: 'YouTube' },
];
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Peru Beyond — Agencia de tours en Cusco, Perú. Tours a Machu Picchu, Valle Sagrado, Montaña de 7 Colores y más. Guías locales certificados, reseñas 4.9/5 en Google. Reserva segura y atención 24/7." />
  <meta name="keywords" content="tours cusco, agencia de viajes cusco, machu picchu tours, valle sagrado tour, montaña 7 colores, peru beyond, tours peru, guias locales cusco, viajes cusco peru, paquetes turisticos cusco" />
  <title>Peru Beyond — Agencia de Tours en Cusco | Machu Picchu, Valle Sagrado y más</title>
  <link rel="canonical" href="https://www.perubeyond.com/landing" />
  <meta property="og:title" content="Peru Beyond — Agencia de Tours en Cusco, Perú" />
  <meta property="og:description" content="Tours a Machu Picchu, Valle Sagrado, Montaña de 7 Colores y todo Perú. Guías locales certificados con 128+ reseñas de 5 estrellas." />
  <meta property="og:image" content="https://www.perubeyond.com/images/PeruBeyond/Logo.png" />
  <meta property="og:url" content="https://www.perubeyond.com/landing" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_PE" />
  <meta property="og:site_name" content="Peru Beyond" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Peru Beyond — Tours en Cusco con Guías Locales" />
  <meta name="twitter:description" content="Agencia de tours en Cusco con guías certificados. Machu Picchu, Valle Sagrado y experiencias auténticas por todo el Perú." />
  <meta name="robots" content="index, follow" />
  <link rel="icon" href="/images/PeruBeyond/Gallito_PeruBeyond_nobg.webp" type="image/webp" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "TravelAgency",
    "name": "Peru Beyond",
    "image": "https://www.perubeyond.com/images/PeruBeyond/Logo.png",
    "url": "https://www.perubeyond.com",
    "telephone": "+51943491959",
    "email": "info@perubeyond.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Cusco",
      "addressCountry": "PE"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "128",
      "bestRating": "5"
    },
    "priceRange": "$$",
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    },
    "sameAs": [
      "https://www.facebook.com/perubeyond",
      "https://www.instagram.com/perubeyond/",
      "https://www.tiktok.com/@perubeyond_agency",
      "https://www.youtube.com/@perubeyond"
    ]
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800&family=Cormorant+Garamond:wght@400;600;700&display=swap" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>

  <!-- Video Background (fixed) -->
  <div class="lt-bg">
    <img
      id="lt-poster"
      src="/images/Machupicchu/IMG_7715.webp"
      alt=""
      aria-hidden="true"
      class="lt-bg__media"
    />
    <video
      id="lt-video"
      autoplay muted loop playsinline preload="auto"
      poster="/images/Machupicchu/IMG_7715.webp"
      aria-hidden="true"
      class="lt-bg__media lt-bg__video"
    >
      <source src="/images/PeruBeyond/MachuPicchu-PerúBeyond.mp4" type="video/mp4" />
    </video>
    <div class="lt-bg__overlay"></div>
    <div class="lt-bg__sides-l"></div>
    <div class="lt-bg__sides-r"></div>
  </div>

  <!-- Main Content -->
  <main class="lt-main">
    <div class="lt-container">

      <!-- ── PROFILE ── -->
      <div class="lt-profile">
        <a href="/" class="lt-logo-link"><img src="/images/PeruBeyond/Logo.webp" alt="Peru Beyond — Agencia de Tours en Cusco" class="lt-logo-big" /></a>
        <h1 class="lt-name">Peru Beyond</h1>
        <p class="lt-tagline">Agencia de Tours en Cusco, Perú</p>
        <div class="lt-rating">
          <div class="lt-rating__stars">
            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
          </div>
          <span class="lt-rating__text">4.9 &middot; 128+ reseñas</span>
        </div>
      </div>

      <!-- ── BIENVENIDA + IMAGEN GRUPAL ── -->
      <div class="lt-welcome">
        <div class="lt-welcome__photo">
          <img src="/images/Laguna_Humantay/DSC04385.webp" alt="Equipo Peru Beyond" />
        </div>
        <p class="lt-welcome__text">
          Somos una agencia peruana dedicada a ofrecer tours auténticos, seguros y diseñados a medida.
          Viajamos con alma, guiamos con pasión.
        </p>
      </div>

      <!-- ── VIDEO YOUTUBE ── -->
      <div class="lt-section">
        <p class="lt-section__label">Conócenos</p>
        <div class="lt-video-wrap">
          <iframe
            src="https://www.youtube.com/embed/HjTJtS7r8do?start=1&autoplay=1&mute=1"
            title="Peru Beyond — Video"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <!-- ── RESEÑAS CARRUSEL ── -->
      <div class="lt-section">
        <p class="lt-section__label">Reseñas de Google</p>
        <div class="lt-carousel-wrap">
          <div class="lt-carousel-track" id="reviewsTrack">
            {reviews.map((r) => (
              <div class="lt-review">
                <div class="lt-review__head">
                  <div class="lt-review__avatar" style={`background:${r.color}`}>
                    <span>{r.initials}</span>
                  </div>
                  <div class="lt-review__meta">
                    <span class="lt-review__name">{r.name}</span>
                    <div class="lt-review__stars">
                      <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                    </div>
                  </div>
                </div>
                <p class="lt-review__text">{r.text}</p>
              </div>
            ))}
          </div>
          <div class="lt-carousel-dots" id="reviewsDots">
            {reviews.map((_, i) => (
              <button class={`lt-blog-dot ${i === 0 ? 'lt-blog-dot--active' : ''}`} data-index={i} aria-label={`Reseña ${i + 1}`}></button>
            ))}
          </div>
        </div>
      </div>

      <!-- ── PREGUNTAS FRECUENTES (SEO) ── -->
      <div class="lt-section">
        <p class="lt-section__label">Preguntas Frecuentes</p>
        <div class="lt-faq">
          <details class="lt-faq__item">
            <summary>¿Por qué elegir Peru Beyond para tours en Cusco?</summary>
            <p>Somos una agencia local con guías certificados por MINCETUR, más de 128 reseñas de 5 estrellas en Google y experiencias 100% personalizadas. Conocemos cada sendero, historia y secreto de Cusco y Machu Picchu.</p>
          </details>
          <details class="lt-faq__item">
            <summary>¿Qué tours ofrecen en Cusco y Machu Picchu?</summary>
            <p>Ofrecemos tours a Machu Picchu, Valle Sagrado, Montaña de 7 Colores, Laguna Humantay, Salineras de Maras, City Tour Cusco, Camino Inca y paquetes completos por todo el Perú adaptados a tus tiempos.</p>
          </details>
          <details class="lt-faq__item">
            <summary>¿Cómo puedo reservar un tour con Peru Beyond?</summary>
            <p>Puedes reservar directamente por WhatsApp al +51 943 491 959, por email a info@perubeyond.com o a través de nuestra página web. Respondemos en minutos y sin compromiso.</p>
          </details>
          <details class="lt-faq__item">
            <summary>¿Los tours incluyen transporte y guía en español?</summary>
            <p>Sí, todos nuestros tours incluyen transporte, guía profesional certificado en español (también disponible en inglés y portugués), entradas según el tour y asistencia 24/7 durante tu viaje.</p>
          </details>
          <details class="lt-faq__item">
            <summary>¿Es seguro viajar con una agencia local en Cusco?</summary>
            <p>Absolutamente. Peru Beyond está registrada en MINCETUR, respaldada por Marca Perú y cuenta con el seguro de viaje Protegeme. Operamos con grupos reducidos para máxima seguridad y atención personalizada.</p>
          </details>
        </div>
      </div>

      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Por qué elegir Peru Beyond para tours en Cusco?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Somos una agencia local con guías certificados por MINCETUR, más de 128 reseñas de 5 estrellas en Google y experiencias 100% personalizadas. Conocemos cada sendero, historia y secreto de Cusco y Machu Picchu."
            }
          },
          {
            "@type": "Question",
            "name": "¿Qué tours ofrecen en Cusco y Machu Picchu?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ofrecemos tours a Machu Picchu, Valle Sagrado, Montaña de 7 Colores, Laguna Humantay, Salineras de Maras, City Tour Cusco, Camino Inca y paquetes completos por todo el Perú adaptados a tus tiempos."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cómo puedo reservar un tour con Peru Beyond?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Puedes reservar directamente por WhatsApp al +51 943 491 959, por email a info@perubeyond.com o a través de nuestra página web. Respondemos en minutos y sin compromiso."
            }
          },
          {
            "@type": "Question",
            "name": "¿Los tours incluyen transporte y guía en español?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sí, todos nuestros tours incluyen transporte, guía profesional certificado en español (también disponible en inglés y portugués), entradas según el tour y asistencia 24/7 durante tu viaje."
            }
          },
          {
            "@type": "Question",
            "name": "¿Es seguro viajar con una agencia local en Cusco?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Absolutamente. Peru Beyond está registrada en MINCETUR, respaldada por Marca Perú y cuenta con el seguro de viaje Protegeme. Operamos con grupos reducidos para máxima seguridad y atención personalizada."
            }
          }
        ]
      }
      </script>

      <!-- ── CERTIFICACIONES ── -->
      <div class="lt-section">
        <p class="lt-section__label">Avales & Certificaciones</p>
        <div class="lt-certs">
          {certLogos.map((logo) => (
            <div class="lt-cert">
              <img src={logo.src} alt={logo.alt} loading="lazy" />
            </div>
          ))}
        </div>
      </div>

      <!-- ── BLOG CARRUSEL ── -->
      <div class="lt-section">
        <p class="lt-section__label">Blog de Viajes</p>
        <div class="lt-carousel-wrap">
          <div class="lt-carousel-track" id="blogTrack">
            {blogs.map((post) => (
              <a href={post.slug} class="lt-blog-card">
                <div class="lt-blog-card__img">
                  <img src={post.image} alt={post.title} loading="lazy" />
                  <span class="lt-blog-card__cat">{post.category}</span>
                </div>
                <div class="lt-blog-card__body">
                  <h3>{post.title}</h3>
                  <p>{post.excerpt}</p>
                </div>
              </a>
            ))}
          </div>
          <div class="lt-carousel-dots" id="blogDots">
            {blogs.map((_, i) => (
              <button class={`lt-blog-dot ${i === 0 ? 'lt-blog-dot--active' : ''}`} data-index={i} aria-label={`Blog ${i + 1}`}></button>
            ))}
          </div>
        </div>
      </div>

      <!-- ── REDES SOCIALES ── -->
      <div class="lt-socials">
        {socials.map(s => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="lt-social">
            <i class={`bi ${s.icon}`}></i>
          </a>
        ))}
      </div>

      <!-- ── CONTACTO ── -->
      <div class="lt-contact">
        <a href="tel:+51943491959" class="lt-contact__item">
          <i class="bi bi-telephone-fill"></i> +51 943 491 959
        </a>
        <span class="lt-contact__dot">&middot;</span>
        <a href="mailto:info@perubeyond.com" class="lt-contact__item">
          <i class="bi bi-envelope-fill"></i> info@perubeyond.com
        </a>
      </div>

      <!-- ── WHATSAPP CTA ── -->
      <a href="https://wa.me/51943491959" target="_blank" rel="noopener noreferrer" class="lt-wa-btn">
        <i class="bi bi-whatsapp"></i>
        <span>Chatea con Nosotros</span>
      </a>

      <!-- ── FOOTER ── -->
      <footer class="lt-footer">
        <div class="lt-footer__certs">
          <span>Operador autorizado</span>
          <span class="lt-footer__sep">|</span>
          <span>MINCETUR</span>
          <span class="lt-footer__sep">|</span>
          <span>Marca Perú</span>
        </div>
        <p class="lt-footer__copy">&copy; 2026 Peru Beyond. Todos los derechos reservados.</p>
      </footer>

    </div>
  </main>

</body>
</html>

<style>
  /* ═══════════════════════════════
     RESET & BASE
  ═══════════════════════════════ */
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html {
    font-family: 'Raleway', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  body {
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: hidden;
    color: #fff;
  }
  a { text-decoration: none; color: inherit; }

  /* ═══════════════════════════════
     VIDEO BACKGROUND
  ═══════════════════════════════ */
  .lt-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
  }
  .lt-bg__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .lt-bg__video {
    opacity: 0;
    transition: opacity 1.5s ease;
  }
  .lt-bg__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 6, 3, 0.55) 0%,
      rgba(8, 6, 3, 0.40) 30%,
      rgba(8, 6, 3, 0.50) 60%,
      rgba(8, 6, 3, 0.70) 100%
    );
    backdrop-filter: blur(1px);
  }
  .lt-bg__sides-l,
  .lt-bg__sides-r {
    display: none;
  }
  @media (min-width: 768px) {
    .lt-bg__sides-l,
    .lt-bg__sides-r {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      width: 30%;
      z-index: 1;
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }
    .lt-bg__sides-l {
      left: 0;
      background: linear-gradient(to right, rgba(8,6,3,0.75), transparent);
    }
    .lt-bg__sides-r {
      right: 0;
      background: linear-gradient(to left, rgba(8,6,3,0.75), transparent);
    }
  }
  @media (min-width: 1200px) {
    .lt-bg__sides-l,
    .lt-bg__sides-r {
      width: 35%;
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
    }
  }

  /* ═══════════════════════════════
     MAIN LAYOUT
  ═══════════════════════════════ */
  .lt-main {
    position: relative;
    z-index: 10;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 3rem 1.25rem;
    padding-top: max(4.5rem, env(safe-area-inset-top, 0px));
    padding-bottom: max(2rem, env(safe-area-inset-bottom, 0px));
  }
  .lt-container {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  /* ═══════════════════════════════
     PROFILE
  ═══════════════════════════════ */
  .lt-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }
  .lt-logo-link {
    display: block;
    transition: transform 0.3s;
  }
  .lt-logo-link:hover { transform: scale(1.05); }
  .lt-logo-big {
    width: 180px;
    height: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    animation: avatarIn 0.8s ease-out both;
  }
  .lt-name {
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-shadow: 0 2px 20px rgba(0,0,0,0.4);
    animation: fadeUp 0.6s ease-out 0.15s both;
  }
  .lt-tagline {
    font-size: 0.82rem;
    font-weight: 500;
    color: rgba(255,255,255,0.6);
    letter-spacing: 0.06em;
    animation: fadeUp 0.6s ease-out 0.25s both;
  }
  .lt-rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    animation: fadeUp 0.6s ease-out 0.35s both;
  }
  .lt-rating__stars {
