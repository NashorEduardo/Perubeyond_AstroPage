---
const certLogos = [
  { src: 'https://gercetur.com.pe/wp-content/uploads/2025/11/LOGO-POSITIVO-scaled-e1763582114614.png', alt: 'Gercetur' },
  { src: 'https://pirka.pe/wp-content/uploads/2025/07/Logo-Marca-Peru-jpeg.jpg', alt: 'Marca Perú' },
  { src: 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRfG9ZFoYjpvD34XX1veRJ3nEbPqrMrCPI1Aw&s', alt: 'TripAdvisor' },
  { src: 'https://mocatravelperu.com/wp-content/uploads/2021/09/protegeme.png', alt: 'Protegeme' },
  { src: 'https://www.wayraqperu.com/wp-content/uploads/mincetur.png', alt: 'Mincetur' },
];

const reviews = [
  {
    name: 'Daniela Britsia', initials: 'DB', color: '#8B7355',
    text: 'Reservamos nuestros tours con esta agencia y fue la mejor decisión. Todo estuvo perfectamente organizado. ¡Definitivamente volveremos!',
  },
  {
    name: 'Gaby Caso', initials: 'GC', color: '#5B8A6F',
    text: 'Experiencia excelente con Peru Beyond. La gira al Lago Titicaca estuvo muy bien organizada, interesante y muy agradable.',
  },
  {
    name: 'Carlos Deza', initials: 'CD', color: '#2E7D6B',
    text: '¡Una joya culinaria en Cusco! Nos llevaron a los mejores restaurantes locales. Superó todas nuestras expectativas.',
