---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Peru Beyond — Agencia de tours en Cusco, Perú. Tours a Machu Picchu, Valle Sagrado, Montaña de 7 Colores y más. Guías locales certificados, reseñas 4.9/5 en Google. Reserva segura y atención 24/7." />
  <meta name="keywords" content="tours cusco, agencia de viajes cusco, machu picchu tours, valle sagrado tour, montaña 7 colores, peru beyond, tours peru, guias locales cusco, viajes cusco peru, paquetes turisticos cusco" />
  <title>Peru Beyond — Agencia de Tours en Cusco | Machu Picchu, Valle Sagrado y más</title>
  <link rel="canonical" href="https://www.perubeyond.com/landing/" />
  <meta property="og:title" content="Peru Beyond — Agencia de Tours en Cusco, Perú" />
  <meta property="og:description" content="Tours a Machu Picchu, Valle Sagrado, Montaña de 7 Colores y todo Perú. Guías locales certificados con 128+ reseñas de 5 estrellas." />
  <meta property="og:image" content="https://www.perubeyond.com/images/PeruBeyond/Logo.png" />
  <meta property="og:url" content="https://www.perubeyond.com/landing/" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_PE" />
  <meta property="og:site_name" content="Peru Beyond" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Peru Beyond — Tours en Cusco con Guías Locales" />
  <meta name="twitter:description" content="Agencia de tours en Cusco con guías certificados. Machu Picchu, Valle Sagrado y experiencias auténticas por todo el Perú." />
  <!-- Landing tipo "link-in-bio" para redes sociales: no debe competir en
       buscadores con la Home ni indexarse como contenido propio. -->
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" href="/images/PeruBeyond/Gallito_PeruBeyond_nobg.webp" type="image/webp" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "TravelAgency",
    "name": "Peru Beyond",
    "image": "https://www.perubeyond.com/images/PeruBeyond/Logo.png",
    "url": "https://www.perubeyond.com",
    "telephone": "+51943491959",
    "email": "info@perubeyond.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Cusco",
      "addressCountry": "PE"
    },
    "priceRange": "$$",
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "08:00",
      "closes": "20:00"
    },
    "sameAs": [
      "https://www.facebook.com/perubeyond",
      "https://www.instagram.com/perubeyond/",
      "https://www.tiktok.com/@perubeyond_agency",
      "https://www.youtube.com/@perubeyond",
      "https://www.tripadvisor.com.pe/Attraction_Review-g294314-d33404487-Reviews-Peru_Beyond-Cusco_Cusco_Region.html"
    ]
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800&family=Cormorant+Garamond:wght@400;600;700&display=swap" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>

  <!-- Video Background (fixed) -->
  <div class="lt-bg">
    <img
      id="lt-poster"
      src="/images/Machupicchu/IMG_7715.webp"
      alt=""
      aria-hidden="true"
      class="lt-bg__media"
    />
    <video
      id="lt-video"
      autoplay muted loop playsinline preload="auto"
      poster="/images/Machupicchu/IMG_7715.webp"
      aria-hidden="true"
      class="lt-bg__media lt-bg__video"
    >
      <source src="/images/PeruBeyond/MachuPicchu-PerúBeyond.mp4" type="video/mp4" />
    </video>
    <div class="lt-bg__overlay"></div>
    <div class="lt-bg__sides-l"></div>
    <div class="lt-bg__sides-r"></div>
  </div>

  <!-- Main Content -->
  <main class="lt-main">
    <div class="lt-container">

      <!-- ── PROFILE ── -->
      <div class="lt-profile">
        <a href="/es" class="lt-logo-link"><img src="/images/PeruBeyond/Logo.webp" alt="Peru Beyond — Agencia de Tours en Cusco" class="lt-logo-big" /></a>
        <h1 class="lt-name">Peru Beyond</h1>
        <p class="lt-tagline">Agencia de Tours en Cusco, Perú</p>
        <div class="lt-rating">
          <div class="lt-rating__stars">
            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
          </div>
          <span class="lt-rating__text">4.9 &middot; 192 reseñas</span>
        </div>
        <a href="https://www.perubeyond.com/es" class="lt-website-link">
          <i class="bi bi-globe2"></i>
          <span>www.perubeyond.com</span>
        </a>
      </div>

      <!-- ── REDES SOCIALES ── -->
      <div class="lt-socials">
        {socials.map(s => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="lt-social">
            <i class={`bi ${s.icon}`}></i>
          </a>
        ))}
      </div>

      <!-- ── CTA: ASESORES DE VIAJES ── -->
      <div class="lt-section">
        <p class="lt-section__label">¿Quieres cotizar y armar tu viaje?</p>
        <p class="lt-advisors-intro">Habla directamente con uno de nuestros asesores especializados</p>
        <div class="lt-advisors-grid">
          {advisors.map((a) => (
            <div class="lt-advisor-card">
              <div class="lt-advisor-card__photo-wrap">
                <img
                  src={a.photo}
                  alt={a.name}
                  class="lt-advisor-card__photo"
                  loading="lazy"
                  onerror="this.src='/images/Laguna_Humantay/DSC04385.webp'"
                />
              </div>
              <div class="lt-advisor-card__body">
                <span class="lt-advisor-card__name">{a.name}</span>
                <span class="lt-advisor-card__role">{a.role}</span>
                <a href={a.wa} target="_blank" rel="noopener noreferrer" class="lt-advisor-card__wa">
                  <i class="bi bi-whatsapp"></i>
                  Contactar por WhatsApp
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ── VIDEO YOUTUBE ── -->
      <div class="lt-section">
        <p class="lt-section__label">Conócenos</p>
        <div class="lt-video-wrap">
          <iframe
            src="https://www.youtube.com/embed/HjTJtS7r8do?start=1&autoplay=1&mute=1"
            title="Peru Beyond — Video"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <!-- ── SECOND CTA: COTIZA TU VIAJE ── -->
      <a href="https://wa.me/51943491959?text=Hola%2C%20quiero%20cotizar%20mi%20viaje%20a%20Per%C3%BA" target="_blank" rel="noopener noreferrer" class="lt-cta-gold">
        <i class="bi bi-calendar-check-fill"></i>
        <span>Cotiza tu viaje ahora — es gratis</span>
        <i class="bi bi-arrow-right lt-cta-gold__arrow"></i>
      </a>

      <!-- ── PAQUETES MÁS EMBLEMÁTICOS ── -->
      <div class="lt-section">
        <h2 class="lt-section__label">Paquetes más emblemáticos</h2>
        <div class="lt-carousel-wrap">
          <div class="lt-carousel-track" id="pkgTrack">
            {packages.map((p) => (
              <a href={p.href} class="lt-pkg-card">
                <div class="lt-pkg-card__img">
                  <img src={p.img} alt={p.title} loading="lazy" />
                  <span class="lt-pkg-card__badge">{p.badge}</span>
                  <div class="lt-pkg-card__overlay">
                    <h3 class="lt-pkg-card__title">{p.title}</h3>
                    <p class="lt-pkg-card__desc">{p.desc}</p>
                    <span class="lt-pkg-card__cta">Ver paquete <i class="bi bi-arrow-right"></i></span>
                  </div>
                </div>
              </a>
            ))}
          </div>
          <div class="lt-carousel-dots" id="pkgDots">
            {packages.map((_, i) => (
              <button class={`lt-blog-dot ${i === 0 ? 'lt-blog-dot--active' : ''}`} data-index={i} aria-label={`Paquete ${i + 1}`}></button>
            ))}
          </div>
        </div>
      </div>

      <!-- ── RESEÑAS CARRUSEL ── -->
      <div class="lt-section">
        <p class="lt-section__label">Reseñas de Google</p>
        <div class="lt-carousel-wrap">
          <div class="lt-carousel-track" id="reviewsTrack">
            {reviews.map((r) => (
              <div class="lt-review">
                <div class="lt-review__head">
                  <div class="lt-review__avatar" style={`background:${r.color}`}>
                    <span>{r.initials}</span>
                  </div>
                  <div class="lt-review__meta">
                    <span class="lt-review__name">{r.name}</span>
                    <div class="lt-review__stars">
                      <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                    </div>
                  </div>
                </div>
                <p class="lt-review__text">{r.text}</p>
              </div>
            ))}
          </div>
          <div class="lt-carousel-dots" id="reviewsDots">
            {reviews.map((_, i) => (
              <button class={`lt-blog-dot ${i === 0 ? 'lt-blog-dot--active' : ''}`} data-index={i} aria-label={`Reseña ${i + 1}`}></button>
            ))}
          </div>
        </div>
      </div>

      <!-- ── ¿ERES INFLUENCER? TRABAJA CON NOSOTROS ── -->
      <div class="lt-influencer-hero">
        <div class="lt-influencer-hero__icon">
          <i class="bi bi-camera-video-fill"></i>
        </div>
        <h2 class="lt-influencer-hero__title">¿Eres Influencer?</h2>
        <p class="lt-influencer-hero__sub">Trabaja con nosotros</p>
        <p class="lt-influencer-hero__text">
          Colaboramos con creadores de contenido para mostrar las maravillas del Perú al mundo.
          Experiencias únicas, contenido increíble.
        </p>
        <a href="https://wa.link/eu33el" target="_blank" rel="noopener noreferrer" class="lt-influencer-hero__btn">
          <i class="bi bi-whatsapp"></i>
          Quiero colaborar
        </a>
      </div>

      <!-- ── ACCIÓN SOCIAL ── -->
      <div class="lt-section lt-social-resp">
        <div class="lt-social-resp__header">
          <div class="lt-social-resp__icon">
            <i class="bi bi-heart-fill"></i>
          </div>
          <div>
            <p class="lt-section__label" style="text-align:left; margin-bottom:0.25rem;">Acción Social</p>
            <h3 class="lt-social-resp__title">Viajar que deja huella</h3>
          </div>
        </div>

        <div class="lt-carousel-wrap lt-social-gallery">
          <div class="lt-carousel-track" id="socialTrack">
            {socialImages.map((img) => (
              <div class="lt-social-slide">
                <img src={img.src} alt={img.alt} loading="lazy" />
                <span class="lt-social-slide__caption">{img.caption}</span>
              </div>
            ))}
          </div>
          <div class="lt-carousel-dots" id="socialDots">
            {socialImages.map((_, i) => (
              <button class={`lt-blog-dot ${i === 0 ? 'lt-blog-dot--active' : ''}`} data-index={i} aria-label={`Imagen ${i + 1}`}></button>
            ))}
          </div>
        </div>

        <p class="lt-social-resp__intro">Viajando con nosotros aportas de esta manera:</p>

        <div class="lt-social-resp__block">
          <p class="lt-social-resp__block-title"><i class="bi bi-tree-fill"></i> Raíces que vuelven al suelo</p>
          <p class="lt-social-resp__text">
            Campañas de reforestación con especies nativas. Junto a comunidades campesinas de Cusco plantamos queuñas, alisos y queñoales que protegen las fuentes de agua y devuelven refugio a la fauna andina.
          </p>
        </div>

        <div class="lt-social-resp__block">
          <p class="lt-social-resp__block-title"><i class="bi bi-heart-pulse-fill"></i> Salud que llega donde más se necesita</p>
          <p class="lt-social-resp__text">
            Campañas de salud para comunidades altoandinas: controles de crecimiento, atención odontológica y tamizaje visual, sin costo y sin que nadie tenga que bajar a la ciudad.
          </p>
        </div>

        <p class="lt-social-resp__highlight">
          Viajando con nosotros colaboras con 2 árboles plantados en comunidades altoandinas.
        </p>
        <div class="lt-social-resp__badges">
          <span><i class="bi bi-check-circle-fill"></i> Reforestación nativa</span>
          <span><i class="bi bi-check-circle-fill"></i> Salud comunitaria</span>
          <span><i class="bi bi-check-circle-fill"></i> Comunidades altoandinas</span>
        </div>
      </div>

      <!-- ── INFLUENCER & MARKETING ── -->
      <div class="lt-section">
        <p class="lt-section__label">Influencer & Marketing</p>
        <div class="lt-marketing-grid">
          <a href="https://wa.link/eu33el" target="_blank" rel="noopener noreferrer" class="lt-marketing-item">
            <div class="lt-marketing-item__icon lt-marketing-item__icon--cam">
              <i class="bi bi-camera-video-fill"></i>
            </div>
            <div class="lt-marketing-item__info">
              <span class="lt-marketing-item__title">¿Eres Influencer?</span>
              <span class="lt-marketing-item__sub">Collab con nosotros</span>
            </div>
            <i class="bi bi-whatsapp lt-marketing-item__wa"></i>
          </a>
          <a href="https://wa.link/xgqs5t" target="_blank" rel="noopener noreferrer" class="lt-marketing-item">
            <div class="lt-marketing-item__icon lt-marketing-item__icon--mega">
              <i class="bi bi-megaphone-fill"></i>
            </div>
            <div class="lt-marketing-item__info">
              <span class="lt-marketing-item__title">Marketing & PR</span>
              <span class="lt-marketing-item__sub">Contacto general</span>
            </div>
            <i class="bi bi-whatsapp lt-marketing-item__wa"></i>
