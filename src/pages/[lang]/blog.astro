---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCategories from '../../components/BlogCategories.astro';
import { imageAlts } from '../../i18n/imageAlts';
import { pageMeta } from '../../i18n/pageMeta';
import { ui } from '../../i18n/ui';
import { getBlogList, getUsedBlogCategories } from '../../data/blogIndex';
import { blogCategoryCopy } from '../../data/blogCategories';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}
const { lang } = Astro.params as { lang: 'es' | 'en' | 'pt' };

const copy = {
  es: {
    placeholder: 'Buscar artículos por título...',
    noResults: 'No encontramos artículos que coincidan con tu búsqueda.',
    subtitle: 'Historias, consejos y destinos para inspirar tu próxima aventura peruana.',
    tagline: 'La diversidad natural, cultural e histórica del Perú te brindará una experiencia auténtica e inolvidable.',
    desc: 'En el blog de PeruBeyond encontrarás información valiosa sobre los destinos más icónicos del Perú: consejos de viaje, actividades destacadas, sugerencias de atracciones y mucho más.',
    featuredLabel: 'Artículo Destacado',
    moreLabel: 'Más Artículos',
    readArticle: 'LEER ARTÍCULO',
    readMore: 'LEER MÁS',
  },
  en: {
    placeholder: 'Search articles by title...',
    noResults: 'No articles match your search.',
    subtitle: 'Stories, tips and destinations to inspire your next Peruvian adventure.',
    tagline: "Peru's natural, cultural and historical diversity will give you an authentic and unforgettable experience.",
    desc: "On the PeruBeyond blog you'll find valuable information about Peru's most iconic destinations: travel tips, featured activities, attraction suggestions and much more.",
    featuredLabel: 'Featured Article',
    moreLabel: 'More Articles',
    readArticle: 'READ ARTICLE',
    readMore: 'READ MORE',
  },
  pt: {
    placeholder: 'Buscar artigos por título...',
    noResults: 'Nenhum artigo encontrado para sua busca.',
    subtitle: 'Histórias, dicas e destinos para inspirar sua próxima aventura peruana.',
    tagline: 'A diversidade natural, cultural e histórica do Peru proporcionará a você uma experiência autêntica e inesquecível.',
    desc: 'No blog da PeruBeyond você encontrará informações valiosas sobre os destinos mais icônicos do Peru: dicas de viagem, atividades em destaque, sugestões de atrações e muito mais.',
    featuredLabel: 'Artigo em Destaque',
    moreLabel: 'Mais Artigos',
    readArticle: 'LER ARTIGO',
    readMore: 'LER MAIS',
  },
}[lang];

const t = ui[lang];
const catCopy = blogCategoryCopy[lang];

// Título del hero: la última palabra va en dorado ("Blog de <Viajes>")
const titleWords = t['blog.title'].split(' ');
const heroTitleLast = titleWords.pop();
const heroTitleFirst = titleWords.join(' ');

const blogList = getBlogList(lang);
const featuredPost = blogList.find((p) => p.isFeatured)!;
const gridPosts = blogList.filter((p) => !p.isFeatured);
const categories = getUsedBlogCategories(lang);
---

<Layout
  title={pageMeta.blog[lang].title}
  description={pageMeta.blog[lang].description}
  lang={lang}
>
  <Header lang={lang} />

  <main class="blog-bg min-h-screen">

    <!-- ── Hero con imagen de portada ── -->
    <section class="hero-section relative flex flex-col items-center justify-center text-center text-white px-4 pt-20" style="height: 58vh;">
      <img
        src="/images/Maras/F4.webp"
        alt={imageAlts.marasSalineras[lang]}
        class="hero-img"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.55) 100%);"></div>
      <div class="relative z-10">
        <p class="script-title text-white/80 mb-3 text-lg">Peru Beyond</p>
        <h1 class="hero-title">
          {heroTitleFirst} <span class="text-gold">{heroTitleLast}</span>
        </h1>
        <p class="hero-subtitle">
          {copy.subtitle}
        </p>
        <nav class="flex items-center justify-center gap-2 text-xs text-white/50 mt-5">
          <a href={`/${lang}`} class="hover:text-white transition-colors flex items-center gap-1">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10.707 2.293a1 1 0 0 0-1.414 0l-7 7A1 1 0 0 0 3 11h1v6a1 1 0 0 0 1 1h4v-4h2v4h4a1 1 0 0 0 1-1v-6h1a1 1 0 0 0 .707-1.707l-7-7z"/>
            </svg>
            {t['blog.home']}
          </a>
          <span class="text-white/30">›</span>
          <span class="text-white/80">Blog</span>
        </nav>
      </div>
    </section>

    <!-- ── Contenido principal ── -->
    <div class="blog-content-section">
      <div class="max-w-6xl mx-auto px-4 md:px-8">

        <!-- Descripción -->
        <div class="text-center max-w-2xl mx-auto mb-12">
          <p class="blog-tagline">
            {copy.tagline}
          </p>
          <p class="blog-desc">
            {copy.desc}
          </p>
        </div>

        <!-- ── Buscador de artículos ── -->
        <div class="blog-search-wrap">
          <div class="blog-search-box">
            <svg class="blog-search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
            </svg>
            <input
              type="search"
              id="blog-search-input"
              class="blog-search-input"
              placeholder={copy.placeholder}
              aria-label={copy.placeholder}
              autocomplete="off"
            />
          </div>
        </div>

        <!-- ── Mapa de categorías (filtro) ── -->
        <div class="blog-cats-wrap">
          <BlogCategories lang={lang} categories={categories} mode="filter" />
          <p id="blog-filter-status" class="blog-filter-status" role="status" aria-live="polite"></p>
        </div>

        <!-- ── ARTÍCULO DESTACADO ── -->
        <div class="mb-10" id="blog-featured-block" data-title={featuredPost.title.toLowerCase()} data-category={featuredPost.categorySlug}>
          <!-- Separador con etiqueta -->
          <div class="featured-label-row mb-5">
            <div class="label-line"></div>
            <span class="label-text">{copy.featuredLabel}</span>
            <div class="label-line"></div>
          </div>

          <a href={featuredPost.href} class="featured-main group block overflow-hidden">
            <div class="featured-inner">
              <!-- Imagen -->
              <div class="featured-img-wrap">
                <img
                  src={featuredPost.image}
                  alt={featuredPost.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                  decoding="async"
                />
                <div class="featured-img-shade"></div>
              </div>
              <!-- Texto editorial -->
              <div class="featured-text-panel">
                <span class="featured-category-tag">{featuredPost.category}</span>
                <time class="featured-date">{featuredPost.date}</time>
                <h2 class="featured-headline">{featuredPost.title}</h2>
                <p class="featured-excerpt">{featuredPost.excerpt}</p>
                <span class="featured-cta">
                  {copy.readArticle}
                  <svg class="w-4 h-4 inline ml-1.5 group-hover:translate-x-1.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0-5 5m5-5H6"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </div>

        <!-- Separador grid -->
        <div class="featured-label-row mb-6" id="blog-grid-label">
          <div class="label-line"></div>
          <span class="label-text">{copy.moreLabel}</span>
          <div class="label-line"></div>
        </div>

        <!-- ── Grid de artículos ── -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="blog-grid">
          {gridPosts.map(post => (
            <a href={post.href} class="grid-card group block overflow-hidden relative" style="height: 380px;" data-title={post.title.toLowerCase()} data-category={post.categorySlug}>
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
                decoding="async"
              />
              <div class="grid-overlay">
                <span class="grid-category">{post.category}</span>
                <time class="post-date">{post.date}</time>
                <h3 class="grid-title">{post.title}</h3>
                <span class="read-more-btn read-more-sm">
                  {copy.readMore}
                  <svg class="w-3 h-3 inline ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0-5 5m5-5H6"/>
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>

        <!-- ── Sin resultados ── -->
        <p id="blog-no-results" class="blog-no-results" hidden>{copy.noResults}</p>

      </div>
    </div>
  </main>

  <script define:vars={{ countOne: catCopy.countOne, countMany: catCopy.countMany }}>
    (function () {
      const input = document.getElementById('blog-search-input');
      const featured = document.getElementById('blog-featured-block');
      const gridLabel = document.getElementById('blog-grid-label');
      const cards = Array.from(document.querySelectorAll('#blog-grid .grid-card'));
      const noResults = document.getElementById('blog-no-results');
      const status = document.getElementById('blog-filter-status');
      const chips = Array.from(document.querySelectorAll('[data-category-filter]'));
      const validSlugs = chips.map((c) => c.dataset.categoryFilter);
      let category = 'all';

      const accentMap = { 'á':'a','é':'e','í':'i','ó':'o','ú':'u','ü':'u','ñ':'n','ã':'a','õ':'o','â':'a','ê':'e','ô':'o','à':'a','ç':'c' };
      const normalize = (s) => (s || '').toLowerCase().trim().replace(/[áéíóúüñãõâêôàç]/g, (ch) => accentMap[ch] || ch);

      function categoryFromHash() {
        const slug = decodeURIComponent(location.hash.slice(1));
        return validSlugs.includes(slug) && slug !== 'all' ? slug : 'all';
      }

      function apply() {
        const query = normalize(input ? input.value : '');
        const matches = (el) =>
          (category === 'all' || el.dataset.category === category) &&
          (!query || normalize(el.dataset.title).includes(query));

        let visible = 0;
        let gridVisible = 0;
        if (featured) {
          const ok = matches(featured);
          featured.hidden = !ok;
          if (ok) visible++;
        }
        cards.forEach((card) => {
          const ok = matches(card);
          card.hidden = !ok;
          if (ok) { visible++; gridVisible++; }
        });
        if (gridLabel) gridLabel.hidden = gridVisible === 0;
        if (noResults) noResults.hidden = visible !== 0;

        chips.forEach((chip) => {
          const on = chip.dataset.categoryFilter === category;
          chip.setAttribute('aria-pressed', on ? 'true' : 'false');
          chip.classList.toggle('is-active', on);
        });

        if (status) {
          status.textContent = (category === 'all' && !query) ? '' : (visible === 1 ? countOne : countMany.replace('{n}', String(visible)));
        }
      }

      function selectCategory(slug) {
        category = slug;
        history.replaceState(null, '', slug === 'all' ? location.pathname + location.search : '#' + slug);
        apply();
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => selectCategory(chip.dataset.categoryFilter));
      });
      if (input) input.addEventListener('input', apply);
      window.addEventListener('hashchange', () => { category = categoryFromHash(); apply(); });

      category = categoryFromHash();
      apply();
      if (category !== 'all') {
        const nav = document.getElementById('blog-categories');
        if (nav) nav.scrollIntoView({ block: 'start' });
      }
    })();
  </script>

  <Footer lang={lang} />
</Layout>

<style>
  /* ── Fondo general ── */
  .blog-bg {
    background-color: #ffffff;
  }

  /* ── Hero ── */
  .hero-section {
    overflow: hidden;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .hero-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 20px rgba(0,0,0,0.4);
  }
  .hero-subtitle {
    font-size: 1rem;
    color: rgba(255,255,255,0.75);
    font-weight: 400;
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .text-gold { color: #f6d06a; }

  /* ── Sección de contenido ── */
  .blog-content-section {
    background-color: #f8f6f3;
    padding: 4rem 0 6rem;
  }

  /* ── Tipografía descripción ── */
  .blog-tagline {
    font-size: 1rem;
    font-weight: 600;
    color: #c9a84c;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .blog-desc {
    font-size: 0.875rem;
    color: #9ca3af;
    line-height: 1.75;
    max-width: 600px;
    margin: 0 auto;
  }

  /* ── Buscador ── */
  .blog-search-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 3rem;
  }
  .blog-search-box {
    position: relative;
    width: 100%;
    max-width: 440px;
  }
  .blog-search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1.05rem;
    height: 1.05rem;
    color: #c9a84c;
    pointer-events: none;
  }
  .blog-search-input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    border: 1px solid #e8dfc9;
    border-radius: 999px;
    background: #ffffff;
    font-size: 0.875rem;
    color: #0d1b2e;
    outline: none;
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .blog-search-input::placeholder {
    color: #9ca3af;
  }
  .blog-search-input:focus {
    border-color: #c9a84c;
    box-shadow: 0 0 0 3px rgba(201,168,76,0.15);
  }
  .blog-no-results {
    text-align: center;
    color: #9ca3af;
    font-size: 0.9rem;
    padding: 3rem 1rem;
  }
  .blog-no-results[hidden],
  #blog-featured-block[hidden],
  #blog-grid-label[hidden],
  .grid-card[hidden] {
    display: none !important;
  }

  /* ── Mapa de categorías ── */
  .blog-cats-wrap {
    margin-bottom: 3rem;
  }
  .blog-filter-status {
    text-align: center;
    font-size: 0.75rem;
    color: #9ca3af;
    margin: 0.85rem 0 0;
    min-height: 1.1rem;
  }
  .grid-category {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0d1b2e;
    background: #f6d06a;
    padding: 0.2rem 0.65rem;
    margin-bottom: 0.7rem;
  }

  /* ── Etiqueta separadora ── */
  .featured-label-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .label-line {
    flex: 1;
    height: 1px;
    background: #e8c76a;
    opacity: 0.5;
  }
  .label-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #c9a84c;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── Artículo destacado ── */
  .featured-main {
    box-shadow: 0 8px 40px rgba(0,0,0,0.14);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .featured-main:hover {
    box-shadow: 0 20px 60px rgba(0,0,0,0.22);
    transform: translateY(-3px);
  }
  .featured-inner {
    display: flex;
    flex-direction: column;
    height: auto;
  }
  @media (min-width: 768px) {
    .featured-inner {
      flex-direction: row;
      height: 500px;
    }
  }

  /* Imagen del destacado */
  .featured-img-wrap {
    position: relative;
    width: 100%;
    height: 280px;
    overflow: hidden;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .featured-img-wrap {
      width: 58%;
      height: 100%;
    }
  }
  .featured-img-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent 60%, rgba(13,27,46,0.25) 100%);
  }
  @media (max-width: 767px) {
    .featured-img-shade {
      background: linear-gradient(to bottom, transparent 50%, rgba(13,27,46,0.4) 100%);
    }
  }

  /* Panel de texto del destacado */
  .featured-text-panel {
    background-color: #0d1b2e;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.25rem 2.5rem;
    width: 100%;
  }
  @media (min-width: 768px) {
    .featured-text-panel {
      width: 42%;
    }
  }
  .featured-category-tag {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0d1b2e;
    background: #f6d06a;
    padding: 0.25rem 0.75rem;
    margin-bottom: 0.85rem;
    align-self: flex-start;
  }
  .featured-date {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.45);
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }
  .featured-headline {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.4;
    margin-bottom: 1.1rem;
  }
  .featured-excerpt {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.75;
    margin-bottom: 1.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .featured-cta {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f6d06a;
    border-bottom: 1px solid rgba(246,208,106,0.4);
    padding-bottom: 2px;
    align-self: flex-start;
    transition: color 0.25s, border-color 0.25s;
  }
  .featured-main:hover .featured-cta {
    color: #ffffff;
    border-color: rgba(255,255,255,0.5);
  }

  /* ── Grid de artículos ── */
  .grid-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .grid-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #c9a84c;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
    z-index: 10;
  }
  .grid-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 48px rgba(0,0,0,0.2);
  }
  .grid-card:hover::after {
    transform: scaleX(1);
  }
  .grid-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.15) 50%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    text-align: center;
    padding: 1.5rem;
  }
  .grid-title {
    font-family: Georgia, serif;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.45;
    margin-bottom: 0.6rem;
  }

  /* ── Elementos comunes ── */
  .post-date {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #f6d06a;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    display: block;
  }
  .read-more-btn {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.85);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(255,255,255,0.3);
    transition: color 0.25s, border-color 0.25s;
  }
  .grid-card:hover .read-more-btn {
    color: #f6d06a;
    border-color: #f6d06a;
  }
</style>
