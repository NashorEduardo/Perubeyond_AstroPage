---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { imageAlts } from '../../i18n/imageAlts';
import { pageMeta } from '../../i18n/pageMeta';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}
const { lang } = Astro.params as { lang: 'es' | 'en' | 'pt' };

const searchCopy = {
  es: { placeholder: 'Buscar artículos por título...', noResults: 'No encontramos artículos que coincidan con tu búsqueda.' },
  en: { placeholder: 'Search articles by title...', noResults: 'No articles match your search.' },
  pt: { placeholder: 'Buscar artigos por título...', noResults: 'Nenhum artigo encontrado para sua busca.' },
}[lang];

const featuredPost = {
  date: '14 de Junio, 2026',
  category: 'Historia & Cultura',
  title: 'Inti Raymi: La Fiesta del Sol en el Cusco',
  excerpt: 'El Inti Raymi es la celebración más importante del Imperio Inca. Cada 24 de junio, Cusco se transforma en el corazón del Tahuantinsuyo con música, danzas y una teatralización que reúne a miles en la explanada de Sacsayhuamán.',
  image: '/images/PeruBeyond/Inti_raymi.webp',
  slug: '/blog/inti-raymi',
};

const gridPosts = [
  {
    date: '21 de Junio, 2026',
    title: 'Mal de altura en Cusco: cómo prepararse y prevenirlo en 2026',
    image: '/images/Cuzco/FT3.webp',
    slug: '/blog/mal-de-altura-cusco',
  },
  {
    date: '20 de Junio, 2026',
    title: 'Camino Inca vs Salkantay Trek: cuál elegir en 2026',
    image: '/images/Machupicchu/FT 7.webp',
    slug: '/blog/camino-inca-vs-salkantay',
  },
  {
    date: '19 de Junio, 2026',
    title: 'Qué hacer en Cusco en 3 días: itinerario completo 2026',
    image: '/images/Cuzco/FT4.webp',
    slug: '/blog/que-hacer-en-cusco-3-dias',
  },
  {
    date: '18 de Junio, 2026',
    title: 'Mejor época para visitar Machu Picchu: guía mes a mes 2026',
    image: '/images/Machupicchu/FT 2.webp',
    slug: '/blog/mejor-epoca-machu-picchu',
  },
  {
    date: '17 de Junio, 2026',
    title: 'Gastronomía cusqueña: 10 platos que no puedes perderte en Cusco',
    image: '/images/Cuzco/FT7.webp',
    slug: '/blog/gastronomia-cusquena',
  },
  {
    date: '4 de Junio, 2026',
    title: 'Corpus Christi Cusqueño: La Fiesta de los Santos que Viste de Oro al Cusco',
    image: '/images/PeruBeyond/carroza.webp',
    slug: '/blog/corpus-christi-cusqueno',
  },
  {
    date: '11 de Septiembre, 2025',
    title: 'Descubre el Valle Sagrado: Ruinas y Espíritu Inca',
    image: '/images/ValleSagrado/ollantaytambo.webp',
    slug: '/blog/valle-sagrado',
  },
  {
    date: '10 de Octubre, 2025',
    title: 'Machu Picchu: La Maravilla del Mundo Inca',
    image: '/images/Machupicchu/IMG_7711.webp',
    slug: '/blog/machu-picchu',
  },
  {
    date: '27 de Agosto, 2025',
    title: 'Sacsayhuamán, donde las piedras cuentan historias',
    image: '/images/Cuzco/cusco.webp',
    slug: '/blog/sacsayhuaman',
  },
  {
    date: '16 de Abril, 2026',
    title: 'Laguna Humantay: el tesoro turquesa del Cusco que no te puedes perder',
    image: '/images/Laguna_Humantay/DSC04361.webp',
    slug: '/blog/laguna-humantay',
  },
  {
    date: '14 de Abril, 2026',
    title: 'Maras, Moray y las Salineras: tres joyas que revelan la sabiduría del Valle Sagrado',
    image: '/images/ValleSagrado/moray.webp',
    slug: '/blog/maras-moray-salineras',
  },
  {
    date: '14 de Abril, 2026',
    title: 'Pikillaqta, el sitio que revela el Cusco antes de los Incas',
    image: '/images/Cuzco/FT1.webp',
    slug: '/blog/pikillaqta',
  },
  {
    date: '11 de Abril, 2026',
    title: 'Cerro de 7 Colores (Vinicunca): la joya natural más sorprendente del Cusco',
    image: '/images/Montaña_de_7_colores/DSC02961.webp',
    slug: '/blog/vinicunca-7-colores',
  },
];
---

<Layout
  title={pageMeta.blog[lang].title}
  description={pageMeta.blog[lang].description}
  lang={lang}
>
  <Header lang={lang} />

  <main class="blog-bg min-h-screen">

    <!-- ── Hero con imagen de portada ── -->
    <section class="hero-section relative flex flex-col items-center justify-center text-center text-white px-4 pt-20" style="height: 58vh;">
      <img
        src="/images/Maras/F4.webp"
        alt={imageAlts.marasSalineras[lang]}
        class="hero-img"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.55) 100%);"></div>
      <div class="relative z-10">
        <p class="script-title text-white/80 mb-3 text-lg">Peru Beyond</p>
        <h1 class="hero-title">
          Blog de <span class="text-gold">Viajes</span>
        </h1>
        <p class="hero-subtitle">
          Historias, consejos y destinos para inspirar tu próxima aventura peruana.
        </p>
        <nav class="flex items-center justify-center gap-2 text-xs text-white/50 mt-5">
          <a href={`/${lang}`} class="hover:text-white transition-colors flex items-center gap-1">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10.707 2.293a1 1 0 0 0-1.414 0l-7 7A1 1 0 0 0 3 11h1v6a1 1 0 0 0 1 1h4v-4h2v4h4a1 1 0 0 0 1-1v-6h1a1 1 0 0 0 .707-1.707l-7-7z"/>
            </svg>
            Inicio
          </a>
          <span class="text-white/30">›</span>
          <span class="text-white/80">Blog</span>
        </nav>
      </div>
    </section>

    <!-- ── Contenido principal ── -->
    <div class="blog-content-section">
      <div class="max-w-6xl mx-auto px-4 md:px-8">

        <!-- Descripción -->
        <div class="text-center max-w-2xl mx-auto mb-12">
          <p class="blog-tagline">
            La diversidad natural, cultural e histórica del Perú te brindará una experiencia auténtica e inolvidable.
          </p>
          <p class="blog-desc">
            En el blog de PeruBeyond encontrarás información valiosa sobre los destinos más icónicos del Perú:
            consejos de viaje, actividades destacadas, sugerencias de atracciones y mucho más.
          </p>
        </div>

        <!-- ── Buscador de artículos ── -->
        <div class="blog-search-wrap">
          <div class="blog-search-box">
            <svg class="blog-search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
            </svg>
            <input
              type="search"
              id="blog-search-input"
              class="blog-search-input"
              placeholder={searchCopy.placeholder}
              aria-label={searchCopy.placeholder}
              autocomplete="off"
            />
          </div>
        </div>

        <!-- ── ARTÍCULO DESTACADO ── -->
        <div class="mb-10" id="blog-featured-block" data-title={featuredPost.title.toLowerCase()}>
          <!-- Separador con etiqueta -->
          <div class="featured-label-row mb-5">
            <div class="label-line"></div>
            <span class="label-text">Artículo Destacado</span>
            <div class="label-line"></div>
          </div>

          <a href={`/${lang}${featuredPost.slug}`} class="featured-main group block overflow-hidden">
            <div class="featured-inner">
              <!-- Imagen -->
              <div class="featured-img-wrap">
                <img
                  src={featuredPost.image}
                  alt={featuredPost.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
                <div class="featured-img-shade"></div>
              </div>
              <!-- Texto editorial -->
              <div class="featured-text-panel">
                <span class="featured-category-tag">{featuredPost.category}</span>
                <time class="featured-date">{featuredPost.date}</time>
                <h2 class="featured-headline">{featuredPost.title}</h2>
                <p class="featured-excerpt">{featuredPost.excerpt}</p>
                <span class="featured-cta">
                  LEER ARTÍCULO
                  <svg class="w-4 h-4 inline ml-1.5 group-hover:translate-x-1.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0-5 5m5-5H6"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </div>

        <!-- Separador grid -->
        <div class="featured-label-row mb-6" id="blog-grid-label">
          <div class="label-line"></div>
          <span class="label-text">Más Artículos</span>
          <div class="label-line"></div>
        </div>

        <!-- ── Grid de artículos ── -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="blog-grid">
          {gridPosts.map(post => (
            <a href={`/${lang}${post.slug}`} class="grid-card group block overflow-hidden relative" style="height: 380px;" data-title={post.title.toLowerCase()}>
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="grid-overlay">
                <time class="post-date">{post.date}</time>
                <h3 class="grid-title">{post.title}</h3>
                <span class="read-more-btn read-more-sm">
                  LEER MÁS
                  <svg class="w-3 h-3 inline ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0-5 5m5-5H6"/>
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>

        <!-- ── Sin resultados ── -->
        <p id="blog-no-results" class="blog-no-results" hidden>{searchCopy.noResults}</p>

      </div>
    </div>
  </main>

  <script define:vars={{ noResultsText: searchCopy.noResults }}>
    (function () {
      const input = document.getElementById('blog-search-input');
      if (!input) return;
      const featured = document.getElementById('blog-featured-block');
      const gridLabel = document.getElementById('blog-grid-label');
      const cards = Array.from(document.querySelectorAll('#blog-grid .grid-card'));
      const noResults = document.getElementById('blog-no-results');

      const accentMap = { 'á':'a','é':'e','í':'i','ó':'o','ú':'u','ü':'u','ñ':'n','ã':'a','õ':'o','â':'a','ê':'e','ô':'o','à':'a','ç':'c' };
      const normalize = (s) => (s || '').toLowerCase().trim().replace(/[áéíóúüñãõâêôàç]/g, (ch) => accentMap[ch] || ch);

      input.addEventListener('input', () => {
        const query = normalize(input.value);

        if (!query) {
          if (featured) featured.hidden = false;
          if (gridLabel) gridLabel.hidden = false;
          cards.forEach((card) => { card.hidden = false; });
          if (noResults) noResults.hidden = true;
          return;
        }

        const featuredMatch = featured ? normalize(featured.dataset.title).includes(query) : false;
        if (featured) featured.hidden = !featuredMatch;

        let visibleCount = featuredMatch ? 1 : 0;
        cards.forEach((card) => {
          const match = normalize(card.dataset.title).includes(query);
          card.hidden = !match;
          if (match) visibleCount++;
        });

        if (gridLabel) gridLabel.hidden = visibleCount === (featuredMatch ? 1 : 0) && cards.every(c => c.hidden);
        if (noResults) noResults.hidden = visibleCount !== 0;
      });
    })();
  </script>

  <Footer lang={lang} />
</Layout>

<style>
  /* ── Fondo general ── */
  .blog-bg {
    background-color: #ffffff;
  }

  /* ── Hero ── */
  .hero-section {
    overflow: hidden;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .hero-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 20px rgba(0,0,0,0.4);
  }
  .hero-subtitle {
    font-size: 1rem;
    color: rgba(255,255,255,0.75);
    font-weight: 400;
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .text-gold { color: #f6d06a; }

  /* ── Sección de contenido ── */
  .blog-content-section {
    background-color: #f8f6f3;
    padding: 4rem 0 6rem;
  }

  /* ── Tipografía descripción ── */
  .blog-tagline {
    font-size: 1rem;
    font-weight: 600;
    color: #c9a84c;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .blog-desc {
    font-size: 0.875rem;
    color: #9ca3af;
    line-height: 1.75;
    max-width: 600px;
    margin: 0 auto;
  }

  /* ── Buscador ── */
  .blog-search-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 3rem;
  }
  .blog-search-box {
    position: relative;
    width: 100%;
    max-width: 440px;
  }
  .blog-search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1.05rem;
    height: 1.05rem;
    color: #c9a84c;
    pointer-events: none;
  }
  .blog-search-input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    border: 1px solid #e8dfc9;
    border-radius: 999px;
    background: #ffffff;
    font-size: 0.875rem;
    color: #0d1b2e;
    outline: none;
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .blog-search-input::placeholder {
    color: #9ca3af;
  }
  .blog-search-input:focus {
    border-color: #c9a84c;
    box-shadow: 0 0 0 3px rgba(201,168,76,0.15);
  }
  .blog-no-results {
    text-align: center;
    color: #9ca3af;
    font-size: 0.9rem;
    padding: 3rem 1rem;
  }

  /* ── Etiqueta separadora ── */
  .featured-label-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .label-line {
    flex: 1;
    height: 1px;
    background: #e8c76a;
    opacity: 0.5;
  }
  .label-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #c9a84c;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── Artículo destacado ── */
  .featured-main {
    box-shadow: 0 8px 40px rgba(0,0,0,0.14);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .featured-main:hover {
    box-shadow: 0 20px 60px rgba(0,0,0,0.22);
    transform: translateY(-3px);
  }
  .featured-inner {
    display: flex;
    flex-direction: column;
    height: auto;
  }
  @media (min-width: 768px) {
    .featured-inner {
      flex-direction: row;
      height: 500px;
    }
  }

  /* Imagen del destacado */
  .featured-img-wrap {
    position: relative;
    width: 100%;
    height: 280px;
    overflow: hidden;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .featured-img-wrap {
      width: 58%;
      height: 100%;
    }
  }
  .featured-img-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent 60%, rgba(13,27,46,0.25) 100%);
  }
  @media (max-width: 767px) {
    .featured-img-shade {
      background: linear-gradient(to bottom, transparent 50%, rgba(13,27,46,0.4) 100%);
    }
  }

  /* Panel de texto del destacado */
  .featured-text-panel {
    background-color: #0d1b2e;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.25rem 2.5rem;
    width: 100%;
  }
  @media (min-width: 768px) {
    .featured-text-panel {
      width: 42%;
    }
  }
  .featured-category-tag {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0d1b2e;
    background: #f6d06a;
    padding: 0.25rem 0.75rem;
    margin-bottom: 0.85rem;
    align-self: flex-start;
  }
  .featured-date {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.45);
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }
  .featured-headline {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.4;
    margin-bottom: 1.1rem;
  }
  .featured-excerpt {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.75;
    margin-bottom: 1.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .featured-cta {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f6d06a;
    border-bottom: 1px solid rgba(246,208,106,0.4);
    padding-bottom: 2px;
    align-self: flex-start;
    transition: color 0.25s, border-color 0.25s;
  }
  .featured-main:hover .featured-cta {
    color: #ffffff;
    border-color: rgba(255,255,255,0.5);
  }

  /* ── Grid de artículos ── */
  .grid-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .grid-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #c9a84c;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
    z-index: 10;
  }
  .grid-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 48px rgba(0,0,0,0.2);
  }
  .grid-card:hover::after {
    transform: scaleX(1);
  }
  .grid-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.15) 50%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    text-align: center;
    padding: 1.5rem;
  }
  .grid-title {
    font-family: Georgia, serif;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.45;
    margin-bottom: 0.6rem;
  }

  /* ── Elementos comunes ── */
  .post-date {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #f6d06a;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    display: block;
  }
  .read-more-btn {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.85);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(255,255,255,0.3);
    transition: color 0.25s, border-color 0.25s;
  }
  .grid-card:hover .read-more-btn {
    color: #f6d06a;
    border-color: #f6d06a;
  }
</style>
