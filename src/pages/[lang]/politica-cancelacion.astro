---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}
const { lang } = Astro.params as { lang: 'es' | 'en' | 'pt' };

// Contenido traducido de esta página. Las cifras (30% depósito, 25/50/100%
// de penalidad, 45/70 días, 30-120 días hábiles de reembolso, etc.) son las
// mismas ya publicadas en /terminos (sección 4 y 6) — no se inventa ningún
// dato comercial nuevo, solo se presenta de forma más clara y localizada.
const pages = {
  es: {
    metaTitle: 'Política de Reservas y Cancelación | Peru Beyond',
    metaDesc: 'Condiciones de reserva, pagos y cancelación de tours con Peru Beyond en Cusco y Perú: depósito, plazos, penalidades y reembolsos explicados con claridad.',
    heroKicker: 'Peru Beyond',
    heroTitle1: 'Política de Reservas',
    heroTitle2: 'y Cancelación',
    heroSub: 'Todo lo que debes saber antes de reservar tu tour: depósitos, pagos, cambios de fecha y condiciones de cancelación.',
    breadcrumbHome: 'Inicio',
    breadcrumbSelf: 'Política de Reservas y Cancelación',
    introLabel: 'Antes de reservar',
    introTitle: 'Reserva con total transparencia',
    introText: 'En Peru Beyond queremos que sepas exactamente qué esperar antes de confirmar tu viaje. Esta página resume nuestras condiciones de reserva, pago y cancelación. Para el detalle legal completo, consulta nuestros Términos y Condiciones.',
    termsLink: 'Ver Términos y Condiciones completos',
    contactCta: 'Escríbenos al WhatsApp',
    sections: [
      {
        title: 'Cómo funciona la reserva',
        icon: 'bi-calendar-check',
        items: [
          'Envíanos tu solicitud por WhatsApp, email o el formulario de la web con el tour, fechas y número de viajeros.',
          'Te enviaremos una cotización personalizada; nuestro equipo te contactará en un plazo no mayor a 48 horas para confirmar disponibilidad.',
          'La reserva queda confirmada únicamente tras el pago del depósito y la emisión de un voucher o correo de confirmación de Peru Beyond.',
        ],
      },
      {
        title: 'Depósito y pago del saldo',
        icon: 'bi-cash-coin',
        items: [
          'Para confirmar cualquier reserva es necesario abonar un depósito mínimo del 30% del valor total del servicio, más los gastos bancarios o de transferencia que correspondan.',
          'El saldo restante debe cancelarse antes del inicio de los servicios, según el plazo acordado con nuestro equipo de ventas.',
          'Tienes 48 horas desde la confirmación para hacer observaciones; pasado ese plazo se entiende el servicio como aceptado conforme.',
        ],
      },
      {
        title: 'Métodos de pago',
        icon: 'bi-credit-card',
        items: [
          'Transferencias bancarias nacionales e internacionales y depósitos en efectivo.',
          'Tarjetas de crédito o débito Visa y Mastercard (sujetas a comisión bancaria internacional).',
          'Western Union o MoneyGram.',
          'Todos los gastos bancarios y comisiones de intermediarios financieros son asumidos por el cliente.',
        ],
      },
      {
        title: 'Política de cancelación',
        icon: 'bi-x-circle',
        highlight: true,
        items: [
          'Más de 70 días antes del inicio del servicio: penalidad del 25% del valor del programa.',
          'Entre 70 y 45 días antes del inicio del servicio: penalidad del 50% del valor del programa.',
          'Dentro de los 45 días previos, o no presentación (No Show): penalidad del 100%, sin derecho a reembolso.',
        ],
      },
      {
        title: 'Reprogramaciones',
        icon: 'bi-arrow-repeat',
        items: [
          'Las reprogramaciones dentro de los 45 días previos al servicio podrán evaluarse siempre que no existan saldos pendientes, el proveedor lo permita y no haya diferencia de tarifa.',
          'Cuando el servicio sea operado por un tercero (aerolínea, PeruRail, hoteles, etc.) con políticas más estrictas, prevalecerán las condiciones de ese proveedor.',
        ],
      },
      {
        title: 'Reembolsos',
        icon: 'bi-arrow-counterclockwise',
        items: [
          'Los reembolsos aprobados se procesan en un plazo de entre 30 y 120 días hábiles, descontando gastos administrativos y comisiones bancarias correspondientes.',
        ],
      },
      {
        title: 'Causas de fuerza mayor',
        icon: 'bi-cloud-lightning',
        items: [
          'Peru Beyond no es responsable por cancelaciones o retrasos derivados de causas de fuerza mayor (huelgas, bloqueos, fenómenos climáticos, desastres naturales, estados de emergencia).',
          'En estos casos, apoyamos al viajero para reprogramar los servicios afectados en la medida de lo posible.',
        ],
      },
    ],
    footNote: 'Esta página resume las condiciones aplicables a la mayoría de nuestros tours. El detalle legal completo, incluyendo condiciones específicas por tipo de servicio (boletos de tren, vuelos, hospedaje), está disponible en nuestros Términos y Condiciones.',
  },
  en: {
    metaTitle: 'Booking & Cancellation Policy | Peru Beyond',
    metaDesc: 'Booking, payment and cancellation conditions for Peru Beyond tours in Cusco and Peru: deposit, deadlines, penalties and refunds explained clearly.',
    heroKicker: 'Peru Beyond',
    heroTitle1: 'Booking &',
    heroTitle2: 'Cancellation Policy',
    heroSub: 'Everything you need to know before booking your tour: deposits, payments, date changes and cancellation conditions.',
    breadcrumbHome: 'Home',
    breadcrumbSelf: 'Booking & Cancellation Policy',
    introLabel: 'Before you book',
    introTitle: 'Book with full transparency',
    introText: 'At Peru Beyond we want you to know exactly what to expect before confirming your trip. This page summarizes our booking, payment and cancellation conditions. For the complete legal detail, see our Terms & Conditions.',
    termsLink: 'See full Terms & Conditions',
    contactCta: 'Message us on WhatsApp',
    sections: [
      {
        title: 'How booking works',
        icon: 'bi-calendar-check',
        items: [
          'Send us your request via WhatsApp, email or the website form with the tour, dates and number of travelers.',
          'We will send you a personalized quote; our team will contact you within 48 hours to confirm availability.',
          'The booking is confirmed only after the deposit is paid and Peru Beyond issues a voucher or confirmation email.',
        ],
      },
      {
        title: 'Deposit and balance payment',
        icon: 'bi-cash-coin',
        items: [
          'To confirm any booking, a minimum deposit of 30% of the total service value is required, plus any applicable bank or transfer fees.',
          'The remaining balance must be paid before the services begin, per the deadline agreed with our sales team.',
          'You have 48 hours from confirmation to raise any observations; after that period the service is considered accepted as is.',
        ],
      },
      {
        title: 'Payment methods',
        icon: 'bi-credit-card',
        items: [
          'Domestic and international bank transfers and cash deposits.',
          'Visa and Mastercard credit/debit cards (subject to international banking fees).',
          'Western Union or MoneyGram.',
          'All bank charges and financial intermediary fees are the client\'s responsibility.',
        ],
      },
      {
        title: 'Cancellation policy',
        icon: 'bi-x-circle',
        highlight: true,
        items: [
          'More than 70 days before the service start: 25% penalty of the program value.',
          'Between 70 and 45 days before the service start: 50% penalty of the program value.',
          'Within 45 days, or No Show: 100% penalty, with no right to a refund.',
        ],
      },
      {
        title: 'Rescheduling',
        icon: 'bi-arrow-repeat',
        items: [
          'Rescheduling within 45 days of the service may be evaluated provided there is no outstanding balance, the provider allows it, and there is no rate difference.',
          'When a service is operated by a third party (airline, PeruRail, hotels, etc.) with stricter policies, that provider\'s conditions will prevail.',
        ],
      },
      {
        title: 'Refunds',
        icon: 'bi-arrow-counterclockwise',
        items: [
          'Approved refunds are processed within 30 to 120 business days, minus applicable administrative and banking fees.',
        ],
      },
      {
        title: 'Force majeure',
        icon: 'bi-cloud-lightning',
        items: [
          'Peru Beyond is not responsible for cancellations or delays resulting from force majeure (strikes, road blockages, weather events, natural disasters, states of emergency).',
          'In these cases, we support the traveler in rescheduling affected services whenever possible.',
        ],
      },
    ],
    footNote: 'This page summarizes the conditions applicable to most of our tours. Full legal detail, including conditions specific to each service type (train tickets, flights, lodging), is available in our Terms & Conditions.',
  },
  pt: {
    metaTitle: 'Política de Reservas e Cancelamento | Peru Beyond',
    metaDesc: 'Condições de reserva, pagamento e cancelamento dos tours da Peru Beyond em Cusco e no Peru: depósito, prazos, penalidades e reembolsos explicados com clareza.',
    heroKicker: 'Peru Beyond',
    heroTitle1: 'Política de Reservas',
    heroTitle2: 'e Cancelamento',
    heroSub: 'Tudo o que você precisa saber antes de reservar seu tour: depósitos, pagamentos, alterações de data e condições de cancelamento.',
    breadcrumbHome: 'Início',
    breadcrumbSelf: 'Política de Reservas e Cancelamento',
    introLabel: 'Antes de reservar',
    introTitle: 'Reserve com total transparência',
    introText: 'Na Peru Beyond queremos que você saiba exatamente o que esperar antes de confirmar sua viagem. Esta página resume nossas condições de reserva, pagamento e cancelamento. Para o detalhe legal completo, consulte nossos Termos e Condições.',
    termsLink: 'Ver Termos e Condições completos',
    contactCta: 'Escreva-nos no WhatsApp',
    sections: [
      {
        title: 'Como funciona a reserva',
        icon: 'bi-calendar-check',
        items: [
          'Envie sua solicitação pelo WhatsApp, e-mail ou formulário do site com o tour, as datas e o número de viajantes.',
          'Enviaremos uma cotação personalizada; nossa equipe entrará em contato em até 48 horas para confirmar a disponibilidade.',
          'A reserva é confirmada somente após o pagamento do depósito e a emissão de um voucher ou e-mail de confirmação da Peru Beyond.',
        ],
      },
      {
        title: 'Depósito e pagamento do saldo',
        icon: 'bi-cash-coin',
        items: [
          'Para confirmar qualquer reserva é necessário pagar um depósito mínimo de 30% do valor total do serviço, mais eventuais taxas bancárias ou de transferência.',
          'O saldo restante deve ser pago antes do início dos serviços, conforme o prazo combinado com nossa equipe de vendas.',
          'Você tem 48 horas a partir da confirmação para fazer observações; após esse prazo, o serviço é considerado aceito conforme apresentado.',
        ],
      },
      {
        title: 'Métodos de pagamento',
        icon: 'bi-credit-card',
        items: [
          'Transferências bancárias nacionais e internacionais e depósitos em dinheiro.',
          'Cartões de crédito ou débito Visa e Mastercard (sujeitos a taxa bancária internacional).',
          'Western Union ou MoneyGram.',
          'Todas as taxas bancárias e comissões de intermediários financeiros são de responsabilidade do cliente.',
        ],
      },
      {
        title: 'Política de cancelamento',
        icon: 'bi-x-circle',
        highlight: true,
        items: [
          'Mais de 70 dias antes do início do serviço: penalidade de 25% do valor do programa.',
          'Entre 70 e 45 dias antes do início do serviço: penalidade de 50% do valor do programa.',
          'Dentro de 45 dias, ou não comparecimento (No Show): penalidade de 100%, sem direito a reembolso.',
        ],
      },
      {
        title: 'Reagendamentos',
        icon: 'bi-arrow-repeat',
        items: [
          'Reagendamentos dentro de 45 dias do serviço podem ser avaliados desde que não haja saldos pendentes, o fornecedor permita e não haja diferença de tarifa.',
          'Quando o serviço for operado por terceiros (companhia aérea, PeruRail, hotéis etc.) com políticas mais rígidas, prevalecerão as condições desse fornecedor.',
        ],
      },
      {
        title: 'Reembolsos',
        icon: 'bi-arrow-counterclockwise',
        items: [
          'Os reembolsos aprovados são processados em um prazo de 30 a 120 dias úteis, descontando taxas administrativas e bancárias correspondentes.',
        ],
      },
      {
        title: 'Casos de força maior',
        icon: 'bi-cloud-lightning',
        items: [
          'A Peru Beyond não se responsabiliza por cancelamentos ou atrasos decorrentes de força maior (greves, bloqueios, fenômenos climáticos, desastres naturais, estados de emergência).',
          'Nesses casos, apoiamos o viajante para reagendar os serviços afetados sempre que possível.',
        ],
      },
    ],
    footNote: 'Esta página resume as condições aplicáveis à maioria dos nossos tours. O detalhe legal completo, incluindo condições específicas por tipo de serviço (passagens de trem, voos, hospedagem), está disponível em nossos Termos e Condições.',
  },
} as const;

const p = pages[lang] ?? pages.es;
---

<Layout title={p.metaTitle} description={p.metaDesc} lang={lang}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: p.breadcrumbHome, item: `https://www.perubeyond.com/${lang}` },
      { '@type': 'ListItem', position: 2, name: p.breadcrumbSelf, item: `https://www.perubeyond.com/${lang}/politica-cancelacion` },
    ],
  })} />

  <Header lang={lang} />

  <main class="bg-white">
    <!-- ══ HERO ══ -->
    <section class="pc-hero relative flex flex-col items-center justify-center text-center text-white px-4 pt-20" style="height: 52vh;">
      <img
        src="/images/ValleSagrado/ollantaytambo.webp"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.65) 100%);"></div>
      <div class="relative z-10">
        <p class="script-title text-white/75 mb-3 text-lg">{p.heroKicker}</p>
        <h1 class="pc-hero-title">
          {p.heroTitle1} <span class="text-gold">{p.heroTitle2}</span>
        </h1>
        <p class="pc-hero-sub">{p.heroSub}</p>
        <nav class="flex items-center justify-center gap-2 text-xs text-white/50 mt-5">
          <a href={`/${lang}`} class="hover:text-white transition-colors">{p.breadcrumbHome}</a>
          <span class="text-white/30">›</span>
          <span class="text-white/80">{p.breadcrumbSelf}</span>
        </nav>
      </div>
    </section>

    <!-- ══ INTRO ══ -->
    <section class="py-16 px-4" style="background-color: #faf9f7;">
      <div class="max-w-3xl mx-auto text-center">
        <span class="script-title block mb-2">{p.introLabel}</span>
        <h2 class="text-2xl md:text-3xl font-bold text-navy mb-4">{p.introTitle}</h2>
        <div class="w-10 h-px bg-amber-400 mx-auto mb-6"></div>
        <p class="text-gray-500 text-sm leading-relaxed mb-6">{p.introText}</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={`/${lang}/terminos`}
            class="inline-flex items-center gap-2 text-navy text-sm font-semibold underline underline-offset-4 decoration-amber-400 hover:text-amber-600 transition-colors"
          >
            {p.termsLink}
          </a>
          <a
            href="https://wa.me/51943491959"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-gray-900 hover:bg-amber-500 text-white text-sm font-semibold px-6 py-3 rounded-full transition-all duration-300"
          >
            <i class="bi bi-whatsapp text-base"></i>
            {p.contactCta}
          </a>
        </div>
      </div>
    </section>

    <!-- ══ SECCIONES ══ -->
    <section class="py-20 px-4 bg-white">
      <div class="max-w-4xl mx-auto grid gap-6">
        {p.sections.map((section) => (
          <div class={`pc-card ${section.highlight ? 'pc-card--highlight' : ''}`}>
            <div class="flex items-center gap-3 mb-4">
              <span class="pc-icon"><i class={`bi ${section.icon}`}></i></span>
              <h3 class="text-lg md:text-xl font-bold text-navy">{section.title}</h3>
            </div>
            <ul class="space-y-3 pl-1">
              {section.items.map((item) => (
                <li class="flex items-start gap-3 text-sm text-gray-600 leading-relaxed">
                  <span class="pc-bullet"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}

        <p class="text-xs text-gray-400 mt-4 text-center leading-relaxed">{p.footNote}</p>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .pc-hero-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.2rem, 5.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 20px rgba(0,0,0,0.4);
  }
  .pc-hero-sub {
    font-size: 1rem;
    color: rgba(255,255,255,0.72);
    max-width: 460px;
    margin: 0 auto;
  }
  .pc-card {
    background: #fff;
    border: 1px solid #ece7de;
    border-radius: 1.25rem;
    padding: 1.75rem;
    box-shadow: 0 1px 6px rgba(0,0,0,0.03);
  }
  .pc-card--highlight {
    border-color: rgba(201, 168, 76, 0.5);
    background: #fdfaf2;
  }
  .pc-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 0.75rem;
    background: rgba(201, 168, 76, 0.12);
    color: #c9a84c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }
  .pc-bullet {
    display: inline-block;
    width: 6px;
    height: 6px;
    min-width: 6px;
    border-radius: 50%;
    background-color: #c9a84c;
    margin-top: 0.4rem;
  }
</style>
