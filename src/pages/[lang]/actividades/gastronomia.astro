---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { imageAlts } from '../../../i18n/imageAlts';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}
const { lang } = Astro.params as { lang: 'es' | 'en' | 'pt' };

const dishes = [
  {
    icon: 'bi-layers',
    iconBg: 'bg-amber-100',
    iconColor: 'text-amber-600',
    name: 'Causita Limeña',
    desc: 'Capas de puré de papa amarilla aliñado con sal, pimienta y limón, rellenas de pollo, vegetales o quinua. Un clásico de la gastronomía peruana.',
  },
  {
    icon: 'bi-fire',
    iconBg: 'bg-red-100',
    iconColor: 'text-red-500',
    name: 'Lomo Saltado',
    desc: 'Carne de lomo fino salteada en wok con cebolla, tomates y ají amarillo, servida sobre papas fritas y acompañada de arroz.',
  },
  {
    icon: 'bi-egg-fried',
    iconBg: 'bg-yellow-100',
    iconColor: 'text-yellow-600',
    name: 'Crepe de Quinua y Kiwicha',
    desc: 'Delicioso crepe en base de quinua y kiwicha acompañado de crema de durazno o mango.',
  },
];

const otherActivities = [
  {
    name: 'Making Sour + Pisco Tasting',
    desc: 'Coctelería artesanal · 2–3 horas · Cusco',
    img: '/images/Actividades/Pisco.webp',
    alt: imageAlts.piscoSour[lang],
    href: `/${lang}/actividades/pisco`,
    icon: 'bi-cup-straw',
    color: 'bg-gold',
  },
  {
    name: 'Pintado de Toritos de Pucará',
    desc: 'Arte & Cultura andina · 1.5–2 horas · Cusco',
    img: '/images/Actividades/Toritos_01.webp',
    alt: imageAlts.toritos01[lang],
    href: `/${lang}/actividades/toritos`,
    icon: 'bi-palette',
    color: 'bg-red-500',
  },
];
---

<Layout
  title="Clásicos de la Gastronomía Peruana | PeruBeyond"
  description="Vive un taller gastronómico auténtico en Cusco: aprende a preparar Causita Limeña, Lomo Saltado y Crepe de Quinua de la mano de un chef experto. Reserva con PeruBeyond."
  lang={lang}
>
  <Header lang={lang} />

  <main class="min-h-screen">

    <!-- Hero -->
    <section class="act-hero relative flex flex-col items-center justify-center text-center text-white px-4 pt-20">
      <img src="/images/Actividades/Platillo_01.webp" alt={imageAlts.andeanPlate[lang]} class="hero-bg-img" />
      <div class="hero-overlay"></div>
      <div class="relative z-10 max-w-3xl">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-gold mb-4 bg-gold/10 border border-gold/30 px-4 py-1.5 rounded-full">
          Taller Gastronómico
        </span>
        <h1 class="act-hero-title">
          Clásicos de la <span class="text-gold">Gastronomía Peruana</span>
        </h1>
        <p class="act-hero-sub">
          Aprende a preparar los platos más emblemáticos del Perú de la mano de un chef experto. Una experiencia culinaria que despertará todos tus sentidos.
        </p>

        <!-- Stats -->
        <div class="flex items-center justify-center gap-8 mt-8">
          <div class="text-center">
            <span class="text-gold text-3xl font-black block leading-none">2</span>
            <span class="text-white/55 text-xs uppercase tracking-wider mt-1 block">Horas</span>
          </div>
          <div class="w-px h-10 bg-white/20"></div>
          <div class="text-center">
            <span class="text-gold text-3xl font-black block leading-none">3</span>
            <span class="text-white/55 text-xs uppercase tracking-wider mt-1 block">Platos</span>
          </div>
          <div class="w-px h-10 bg-white/20"></div>
          <div class="text-center">
            <span class="text-gold text-3xl font-black block leading-none">Cusco</span>
            <span class="text-white/55 text-xs uppercase tracking-wider mt-1 block">Ubicación</span>
          </div>
        </div>

        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-xs text-white/40 mt-8">
          <a href={`/${lang}`} class="hover:text-white transition-colors flex items-center gap-1">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10.707 2.293a1 1 0 0 0-1.414 0l-7 7A1 1 0 0 0 3 11h1v6a1 1 0 0 0 1 1h4v-4h2v4h4a1 1 0 0 0 1-1v-6h1a1 1 0 0 0 .707-1.707l-7-7z"/>
            </svg>
            Inicio
          </a>
          <span class="text-white/20">›</span>
          <a href={`/${lang}/actividades`} class="hover:text-white transition-colors">Actividades</a>
          <span class="text-white/20">›</span>
          <span class="text-white/70">Gastronomía</span>
        </nav>
      </div>
    </section>

    <!-- Contenido principal -->
    <div class="act-content-bg">
      <div class="max-w-6xl mx-auto px-4 md:px-8 py-16 space-y-20">

        <!-- Layout principal -->
        <section>
          <div class="flex items-center gap-4 mb-10">
            <div class="w-12 h-12 rounded-2xl bg-amber-500 flex items-center justify-center shadow-lg flex-shrink-0">
              <i class="bi bi-stars text-white text-xl"></i>
            </div>
            <div>
              <h2 class="act-section-title">Clásicos de la Gastronomía Peruana</h2>
              <p class="act-section-sub">Taller gastronómico · 2 horas · Cusco</p>
            </div>
          </div>

          <div class="grid lg:grid-cols-2 gap-12 items-start mb-14">

            <!-- Imágenes -->
            <div class="grid grid-cols-2 gap-3">
              <img
                src="/images/Actividades/Platillo_01.webp"
                alt={imageAlts.andeanPlate[lang]}
                class="act-img col-span-2 h-72 object-cover rounded-2xl"
                loading="lazy"
              />
              <img
                src="/images/Actividades/Platillo_02.webp"
                alt={imageAlts.grilledMeatDish[lang]}
                class="act-img h-48 object-cover rounded-2xl"
                loading="lazy"
              />
              <div class="bg-amber-50 border border-amber-100 rounded-2xl h-48 flex flex-col items-center justify-center p-6">
                <i class="bi bi-clock text-amber-500 text-3xl mb-2"></i>
                <span class="text-navy font-bold text-xl">2 horas</span>
                <span class="text-gray-400 text-sm text-center mt-1">de experiencia gastronómica</span>
              </div>
            </div>

            <!-- Texto -->
            <div>
              <p class="act-desc mb-4">
                Nuestro evento comienza con una bienvenida seguida de una introducción al pisco, explorando su historia y variedades. Los participantes aprenderán a preparar un auténtico pisco sour bajo la guía de nuestro experto bartender, con la oportunidad de degustar su propia creación.
              </p>
              <p class="act-desc mb-4">
                Continuaremos con un taller práctico de causa limeña, donde cada uno personalizará y preparará su versión de este plato tradicional. La experiencia culminará con una sesión interactiva de cocina para preparar lomo saltado, aprendiendo técnicas de salteado antes de disfrutar del plato que han cocinado.
              </p>
              <p class="act-desc mb-8">
                El evento concluye con una sesión de preguntas y respuestas, proporcionando una oportunidad para discutir lo aprendido y compartir impresiones sobre la experiencia gastronómica.
              </p>

              <!-- Info rápida -->
              <div class="grid grid-cols-2 gap-3 mb-8">
                <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
                  <i class="bi bi-clock text-amber-500 text-lg mb-1 block"></i>
                  <span class="text-navy font-bold text-sm block">Duración</span>
                  <span class="text-gray-500 text-xs">2 horas</span>
                </div>
                <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
                  <i class="bi bi-geo-alt text-amber-500 text-lg mb-1 block"></i>
                  <span class="text-navy font-bold text-sm block">Ubicación</span>
                  <span class="text-gray-500 text-xs">Cusco, Perú</span>
                </div>
                <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
                  <i class="bi bi-people text-amber-500 text-lg mb-1 block"></i>
                  <span class="text-navy font-bold text-sm block">Grupos</span>
                  <span class="text-gray-500 text-xs">Pequeños y privados</span>
                </div>
                <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
                  <i class="bi bi-translate text-amber-500 text-lg mb-1 block"></i>
                  <span class="text-navy font-bold text-sm block">Idioma</span>
                  <span class="text-gray-500 text-xs">Español / Inglés</span>
                </div>
              </div>

              <a
                href={`https://wa.me/51943491959?text=${encodeURIComponent('Hola, me interesa la actividad: Clásicos de la Gastronomía Peruana')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="act-main-cta"
              >
                <i class="bi bi-whatsapp text-base"></i>
                Reservar experiencia
              </a>
            </div>
          </div>

          <!-- Tarjetas de platos -->
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-5">Qué se prepara</p>
            <div class="grid sm:grid-cols-3 gap-5">
              {dishes.map(dish => (
                <div class="dish-card">
                  <div class={`dish-icon ${dish.iconBg} ${dish.iconColor}`}>
                    <i class={`bi ${dish.icon} text-xl`}></i>
                  </div>
                  <h3 class="dish-name">{dish.name}</h3>
                  <p class="dish-desc">{dish.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Otras actividades -->
        <section>
          <div class="act-divider mb-16"></div>
          <h2 class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-6">Otras experiencias</h2>
          <div class="grid sm:grid-cols-2 gap-5">
            {otherActivities.map(act => (
              <a href={act.href} class="group relative overflow-hidden rounded-2xl h-52 block">
                <img src={act.img} alt={act.alt} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                <div class="absolute inset-0 flex flex-col justify-end p-6">
                  <div class={`w-8 h-8 rounded-lg ${act.color} flex items-center justify-center mb-2`}>
                    <i class={`bi ${act.icon} text-white text-sm`}></i>
                  </div>
                  <h3 class="text-white font-bold text-base leading-snug">{act.name}</h3>
                  <p class="text-white/60 text-xs mt-0.5">{act.desc}</p>
                </div>
              </a>
            ))}
          </div>
        </section>

        <!-- CTA Banner -->
        <section class="act-cta-banner relative overflow-hidden rounded-3xl">
          <img src="/images/Actividades/Platillo_02.webp" alt={imageAlts.grilledMeatDish[lang]} class="absolute inset-0 w-full h-full object-cover object-center" loading="lazy" />
          <div class="absolute inset-0 bg-navy/80"></div>
          <div class="relative z-10 text-center py-16 px-6">
            <span class="text-gold text-xs font-bold uppercase tracking-widest block mb-3">¿Listo para vivir el Perú?</span>
            <h2 class="cta-banner-title">Diseñamos tu experiencia a medida</h2>
            <p class="cta-banner-sub">
              Nuestro equipo te asesora sin costo para combinar las actividades culturales y gastronómicas que más te apasionen.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-4 mt-8">
              <a
                href="https://wa.me/51943491959?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20actividades%20culturales%20y%20gastron%C3%B3micas"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white font-bold text-sm px-6 py-3 rounded-full transition-all shadow-lg hover:-translate-y-0.5"
              >
                <i class="bi bi-whatsapp text-base"></i>
                WhatsApp directo
              </a>
              <a
                href={`/${lang}/contacto`}
                class="inline-flex items-center gap-2 bg-gold hover:bg-yellow-400 text-navy font-bold text-sm px-6 py-3 rounded-full transition-all shadow-lg hover:-translate-y-0.5"
              >
                Consultar ahora
                <i class="bi bi-arrow-right"></i>
              </a>
            </div>
          </div>
        </section>

      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  :root { --navy: #0d1b2e; --gold: #f6d06a; }

  .act-hero {
    height: 70vh;
    min-height: 560px;
    overflow: hidden;
  }
  .hero-bg-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 40%;
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(13,27,46,0.55) 0%, rgba(13,27,46,0.80) 100%);
  }
  .act-hero-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 800; color: #fff;
    line-height: 1.15; margin-bottom: 1rem;
    text-shadow: 0 2px 24px rgba(0,0,0,0.45);
  }
  .act-hero-sub {
    font-size: 1.05rem; color: rgba(255,255,255,0.72);
    line-height: 1.65; max-width: 560px; margin: 0 auto;
  }
  .act-content-bg { background-color: #f8f6f3; }
  .act-section-title {
    font-family: Georgia, serif; font-size: 1.65rem;
    font-weight: 800; color: #0d1b2e;
    letter-spacing: 0.02em; line-height: 1.1;
  }
  .act-section-sub { font-size: 0.8rem; color: #9ca3af; font-weight: 500; margin-top: 0.25rem; }
  .act-desc { font-size: 0.9rem; color: #4b5563; line-height: 1.75; }
  .act-img { transition: transform 0.4s ease; }
  .act-img:hover { transform: scale(1.02); }
  .act-main-cta {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: #0d1b2e; color: #f6d06a;
    font-size: 0.85rem; font-weight: 700;
    padding: 0.7rem 1.5rem; border-radius: 9999px;
    letter-spacing: 0.04em;
    transition: background 0.2s, color 0.2s, transform 0.2s;
    text-decoration: none;
  }
  .act-main-cta:hover { background: #c9a84c; color: #0d1b2e; transform: translateY(-2px); }
  .dish-card {
    background: #fff; border-radius: 1.25rem; padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    display: flex; flex-direction: column; gap: 0.5rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .dish-card:hover { transform: translateY(-4px); box-shadow: 0 12px 36px rgba(0,0,0,0.12); }
  .dish-icon {
    width: 3rem; height: 3rem; border-radius: 0.75rem;
    display: flex; align-items: center; justify-content: center; margin-bottom: 0.25rem;
  }
  .dish-name { font-family: Georgia, serif; font-size: 1rem; font-weight: 700; color: #0d1b2e; }
  .dish-desc { font-size: 0.8rem; color: #6b7280; line-height: 1.65; }
  .act-divider { height: 1px; background: linear-gradient(to right, transparent, #e5e7eb, transparent); }
  .act-cta-banner { margin-top: 2rem; }
  .cta-banner-title {
    font-family: Georgia, serif;
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    font-weight: 800; color: #fff;
    margin-bottom: 0.75rem; line-height: 1.2;
  }
  .cta-banner-sub {
    font-size: 0.95rem; color: rgba(255,255,255,0.65);
    max-width: 520px; margin: 0 auto; line-height: 1.7;
  }
  .text-navy { color: #0d1b2e; }
  .text-gold { color: #f6d06a; }
  .bg-navy { background-color: #0d1b2e; }
  .bg-gold { background-color: #f6d06a; }
</style>