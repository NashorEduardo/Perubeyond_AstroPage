---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Promotions from '../../components/Promotions.astro';
import About from '../../components/About.astro';
import FavoriteTours from '../../components/FavoriteTours.astro';
import MachuPicchuTours from '../../components/MachuPicchuTours.astro';
import ToursPeru from '../../components/ToursPeru.astro';
import ToursCuscoSlider from '../../components/ToursCuscoSlider.astro';
import DestinationsSlider from '../../components/DestinationsSlider.astro';
import TripadvisorReviews from '../../components/TripadvisorReviews.astro';
import WhyChooseUs from '../../components/WhyChooseUs.astro';
import BlogPreview from '../../components/BlogPreview.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { pageMeta } from '../../i18n/pageMeta';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}
const { lang } = Astro.params as { lang: 'es' | 'en' | 'pt' };
---
<Layout
  title={pageMeta.home[lang].title}
  description={pageMeta.home[lang].description}
  lang={lang}
>
  <link slot="head" rel="preload" as="image" href="/images/Lima/pexels-icarus-7357663.webp" />
  <link slot="head" rel="preload" as="video" href="/images/PeruBeyond/MachuPicchu-PerúBeyond.mp4" type="video/mp4" />
  <Header lang={lang} />
  <Hero lang={lang} />
  <Promotions lang={lang} />
  <About lang={lang} />
  <FavoriteTours />
  <MachuPicchuTours lang={lang} />
  <DestinationsSlider lang={lang} />
  <ToursPeru lang={lang} />
  <ToursCuscoSlider />
  <TripadvisorReviews lang={lang} />
  <WhyChooseUs />
  <BlogPreview />
  <Footer lang={lang} />

  <WhatsAppFloat />
</Layout>

