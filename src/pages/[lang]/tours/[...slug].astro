  <!-- FUNCIÓN: el menú secundario reemplaza al header al hacer scroll.
       Se controla todo por JS (position:fixed) en vez de usar CSS "sticky",
       porque "sticky" se rompe si algún elemento padre en el layout tiene
       overflow-hidden (muy común en este tipo de sitios). "fixed" no tiene
       ese problema. -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const header  = document.getElementById('main-header') as HTMLElement | null;
      const nav     = document.getElementById('floating-menu') as HTMLElement | null;
      const spacer  = document.getElementById('floating-menu-spacer') as HTMLElement | null;
      if (!header || !nav || !spacer) return;
      const headerEl = header;
      const navEl = nav;
      const spacerEl = spacer;

      let navOffsetTop = 0;

      // Guarda la posición natural del menú en el documento (solo cuando
      // NO está fijado, para no medir mal su propia posición fija).
      function measure() {
        if (!navEl.classList.contains('is-fixed')) {
          navOffsetTop = navEl.getBoundingClientRect().top + window.scrollY;
        }
      }
      measure();
      window.addEventListener('resize', measure);

      function onScroll() {
        const shouldStick = window.scrollY >= navOffsetTop;
        const isFixed = navEl.classList.contains('is-fixed');

        if (shouldStick && !isFixed) {
          // Fijamos el menú secundario arriba y dejamos un spacer para
          // que el contenido de abajo no salte.
          spacerEl.style.height = navEl.offsetHeight + 'px';
          spacerEl.classList.remove('hidden');
          navEl.classList.add('is-fixed', 'fixed', 'top-0', 'left-0', 'right-0');
          navEl.classList.remove('relative');

          // Ocultamos el header principal: el menú secundario lo reemplaza.
          headerEl.classList.add('-translate-y-full', 'pointer-events-none');
        } else if (!shouldStick && isFixed) {
          navEl.classList.remove('is-fixed', 'fixed', 'top-0', 'left-0', 'right-0');
          navEl.classList.add('relative');
          spacerEl.classList.add('hidden');
          spacerEl.style.height = '0px';

          // Volvemos a mostrar el header principal.
          headerEl.classList.remove('-translate-y-full', 'pointer-events-none');
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    });
  </script>

  <!-- FUNCION PARA LA FUNCION DEL CARRUCEL DE LOS ITINERARIOS  -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const state: Record<string, number> = {};
  
      function getTrack(id: string): HTMLElement | null {
        return document.querySelector(`.carousel-track[data-carousel="${id}"]`);
      }
  
      function getSlides(id: string): HTMLElement[] {
        const track = getTrack(id);
        return track ? Array.from(track.querySelectorAll('.carousel-slide')) : [];
      }
  
      function updateCarousel(id: string) {
        const slides = getSlides(id);
        if (!slides.length) return;
        const current = state[id] ?? 0;
        const slideWidth = slides[0].getBoundingClientRect().width + 12;
        const track = getTrack(id);
        if (track) track.style.transform = `translateX(-${current * slideWidth}px)`;
  
        document.querySelectorAll(`[data-dots="${id}"] .dot`).forEach((dot, i) => {
          const el = dot as HTMLElement;
          el.classList.toggle('bg-orange-500', i === current);
          el.classList.toggle('!w-4', i === current);
          el.classList.toggle('bg-gray-300', i !== current);
        });
      }
  
      document.querySelectorAll('.carousel-next').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.target!;
          const max = Math.max(0, getSlides(id).length - 3);
          state[id] = Math.min((state[id] ?? 0) + 1, max);
          updateCarousel(id);
        });
      });
  
      document.querySelectorAll('.carousel-prev').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.target!;
          state[id] = Math.max((state[id] ?? 0) - 1, 0);
          updateCarousel(id);
        });
      });
  
      document.querySelectorAll('[data-dots] .dot').forEach(dot => {
        dot.addEventListener('click', () => {
          const id = (dot as HTMLElement).dataset.carousel!;
          state[id] = parseInt((dot as HTMLElement).dataset.index!);
          updateCarousel(id);
        });
      });
    });
  </script>




  <!-- SECCION PARA EL FUNCIONAMIENTO DE LA GALERIA DE IMAGENES  -->
  <script define:vars={{ galleryImages: gallery ?? [], videoUrl: videoUrl ?? '' }}>
    let currentIndex = 0;
  
    function openLightbox(index) {
      currentIndex = index;
      const lb = document.getElementById('lightbox');
      const img = document.getElementById('lightbox-img');
      const counter = document.getElementById('lightbox-counter');
      if (!lb || !img) return;
      img.src = galleryImages[currentIndex];
      img.alt = `Foto ${currentIndex + 1}`;
      if (counter) counter.textContent = `${currentIndex + 1} / ${galleryImages.length}`;
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  
    function closeLightbox() {
      const lb = document.getElementById('lightbox');
      if (!lb) return;
      lb.classList.add('hidden');
      lb.classList.remove('flex');
      document.body.style.overflow = '';
    }
  
    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeLightbox();
    });
  
    // Botón Siguiente
    document.getElementById('lightbox-next')?.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % galleryImages.length;
      const img = document.getElementById('lightbox-img');
      const counter = document.getElementById('lightbox-counter');
      
      if (img instanceof HTMLImageElement) {
        img.src = galleryImages[currentIndex];
      }
      
      if (counter) {
        counter.textContent = `${currentIndex + 1} / ${galleryImages.length}`;
      }
    });
  
    // Botón Anterior
    document.getElementById('lightbox-prev')?.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + galleryImages.length) % galleryImages.length;
      const img = document.getElementById('lightbox-img');
      const counter = document.getElementById('lightbox-counter');
      
      if (img instanceof HTMLImageElement) {
        img.src = galleryImages[currentIndex];
      }
      
      if (counter) {
        counter.textContent = `${currentIndex + 1} / ${galleryImages.length}`;
      }
    });
  
    // Teclado
    document.addEventListener('keydown', (e) => {
      const lb = document.getElementById('lightbox');
      if (!lb || lb.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') document.getElementById('lightbox-next')?.click();
      if (e.key === 'ArrowLeft') document.getElementById('lightbox-prev')?.click();
    });
  
    // Botón de video
    document.getElementById('gallery-video-btn')?.addEventListener('click', () => {
      if (!videoUrl) return;
      const videoId = videoUrl.includes('v=') ? videoUrl.split('v=')[1].split('&')[0] : videoUrl.split('/').pop();
      window.open(`https://www.youtube.com/watch?v=${videoId}`, '_blank');
    });
  </script>


  <!--  Funcionamiento de las Preguntas Frecuentes  -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.faq-trigger').forEach(trigger => {
        trigger.addEventListener('click', () => {
          const index = (trigger as HTMLElement).dataset.index!;
          const item = document.querySelector(`.faq-item[data-index="${index}"]`);
          if (!item) return;

          const answer = item.querySelector('.faq-answer') as HTMLElement;
          const icon = item.querySelector('.faq-icon') as HTMLElement;
          const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';

          // Cerrar todos
          document.querySelectorAll('.faq-item').forEach(el => {
            const a = el.querySelector('.faq-answer') as HTMLElement;
            const ic = el.querySelector('.faq-icon') as HTMLElement;
            if (a) a.style.maxHeight = '0px';
            if (ic) { ic.textContent = '+'; ic.classList.remove('bg-gold', 'text-white', 'border-gold'); }
          });

          // Abrir el clickeado si estaba cerrado
          if (!isOpen) {
            answer.style.maxHeight = answer.scrollHeight + 'px';
            icon.textContent = '−';
            icon.classList.add('bg-gold', 'text-white', 'border-gold');
          }
        });
      });
    });
  </script>

  <!-- Script para envío del formulario a /api/reserva -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('tour-inquiry-form') as HTMLFormElement | null;
      if (!form) return;

      const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;
      const btnText = document.getElementById('form-btn-text') as HTMLElement | null;
      const statusDiv = document.getElementById('form-status') as HTMLElement | null;

      const originalBtnText = btnText ? btnText.textContent : 'Enviar Consulta';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;

        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'Enviando...';
        if (statusDiv) {
          statusDiv.className = 'hidden';
          statusDiv.textContent = '';
        }

        const formData = new FormData(form);
        const data: Record<string, any> = {};
        formData.forEach((val, key) => { data[key] = val; });

        try {
          const res = await fetch('/api/reserva', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify(data),
          });

          const result = await res.json();

          if (res.ok && result.success) {
            form.reset();
            if (statusDiv) {
              statusDiv.textContent = '¡Gracias! Tu consulta ha sido enviada con éxito. Nos pondremos en contacto contigo a la brevedad.';
              statusDiv.className = 'text-xs rounded-xl p-3.5 bg-emerald-50 text-emerald-800 border border-emerald-200 block';
            }
          } else {
            if (statusDiv) {
              statusDiv.textContent = result.error || 'Ocurrió un error al enviar tu consulta. Por favor, inténtalo de nuevo o contáctanos por WhatsApp.';
              statusDiv.className = 'text-xs rounded-xl p-3.5 bg-rose-50 text-rose-800 border border-rose-200 block';
            }
          }
        } catch (err) {
          if (statusDiv) {
            statusDiv.textContent = 'Error de conexión. Por favor intenta contactarnos directamente por WhatsApp.';
            statusDiv.className = 'text-xs rounded-xl p-3.5 bg-rose-50 text-rose-800 border border-rose-200 block';
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = originalBtnText;
        }
      });
    });
  </script>

