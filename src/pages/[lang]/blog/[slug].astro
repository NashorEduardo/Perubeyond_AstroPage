    scroll-margin-top: 6rem;
    line-height: 1.4;
  }
  .prose-blog h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #334155;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-blog ul {
    list-style-type: disc;
    margin-left: 1.5rem;
    margin-bottom: 1.4rem;
  }
  .prose-blog ol {
    list-style-type: decimal;
    margin-left: 1.5rem;
    margin-bottom: 1.4rem;
  }
  .prose-blog li {
    margin-bottom: 0.4rem;
  }
  .prose-blog strong {
    color: #0f172a;
    font-weight: 700;
  }
  .prose-blog a {
    color: #9a7625;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .prose-blog a:hover {
    color: #c9a84c;
  }

  /* ── Tablas Markdown Comparativas (Completas en PC y apiladas/limpias en Móvil) ── */
  .prose-blog table {
    width: 100%;
    display: table;
    table-layout: auto;
    border-collapse: separate;
    border-spacing: 0;
    margin: 1.75rem 0 2.25rem;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    box-shadow: 0 6px 20px rgba(13, 27, 46, 0.06);
    background: #ffffff;
  }
  .prose-blog thead {
    background-color: #0D1B2E;
  }
  .prose-blog th {
    padding: 0.9rem 1rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #f6d06a;
    border-bottom: 2px solid #c9a84c;
    text-align: left;
    line-height: 1.35;
  }
  .prose-blog td {
    padding: 0.85rem 1rem;
    font-size: 0.88rem;
    color: #334155;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: middle;
    line-height: 1.45;
  }
  .prose-blog tr:last-child td {
    border-bottom: none;
  }
  .prose-blog tr:nth-child(even) td {
    background-color: #f8fafc;
  }
  .prose-blog tr:hover td {
    background-color: #fefce8;
  }

  /* Comportamiento en Móvil: Vista compacta tipo tarjetas sin desbordamiento */
  @media (max-width: 768px) {
    .prose-blog table {
      display: block;
      border: none;
      box-shadow: none;
      background: transparent;
    }
    .prose-blog thead {
      display: none;
    }
    .prose-blog tbody {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .prose-blog tr {
      display: block;
      background: #ffffff;
      border: 1px solid #e2e8f0;
