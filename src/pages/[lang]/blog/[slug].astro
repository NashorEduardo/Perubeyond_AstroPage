---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getMergedPosts, getBlogList } from '../../../data/blogIndex';
import BlogCategories from '../../../components/BlogCategories.astro';
import { getCategorySlug } from '../../../data/blogCategories';
import { ui } from '../../../i18n/ui';

export async function getStaticPaths() {
  const langs = ['es', 'en', 'pt'] as const;
  const paths = [];

  // 1. Obtener entradas de la colección blog (Markdown en src/content/blog)
  let mdEntries: any[] = [];
  try {
    mdEntries = await getCollection('blog');
  } catch (e) {
    console.warn('Colección blog vacía o no inicializada aún:', e);
  }

  const mdMap = new Map<string, any>();
  for (const entry of mdEntries) {
    // entry.id tiene formato "es/slug" o "en/slug"
    mdMap.set(entry.id, entry);
  }

  for (const lang of langs) {
    const posts = getMergedPosts(lang);
    for (const [slug, blog] of Object.entries(posts)) {
      const entryKey = `${lang}/${slug}`;
      const mdEntry = mdMap.get(entryKey) || null;

      paths.push({
        params: { lang, slug },
        props: {
          blog,
          mdEntry,
          hasMarkdown: Boolean(mdEntry || blog.contentMarkdown),
        },
      });
    }
  }
  return paths;
}

const { blog, mdEntry } = Astro.props;
const { slug, lang } = Astro.params as { slug: string; lang: 'es' | 'en' | 'pt' };
const t = ui[lang as keyof typeof ui] ?? ui.es;
const categorySlug = getCategorySlug(lang, blog.category);

// Renderizar Markdown si existe entrada en Content Collections
let Content: any = null;
let headings: { depth: number; slug: string; text: string }[] = [];

if (mdEntry) {
  try {
    const rendered = await render(mdEntry);
    Content = rendered.Content;
    headings = rendered.headings || [];
  } catch (err) {
    console.error('Error al renderizar mdEntry:', err);
  }
} else if (blog.sections && blog.sections.length > 0) {
  // Generar encabezados para blogs clásicos basados en secciones
  headings = blog.sections
    .filter((s: any) => s.heading)
    .map((s: any, idx: number) => ({
      depth: 2,
      slug: `seccion-${idx + 1}`,
      text: s.heading,
    }));
}

// Numerar encabezados estilo Salkantay Trekking y Viagens Machu Picchu: 1., 1.1., 1.2., 2., etc.
let h2Count = 0;
let h3Count = 0;
const numberedHeadings = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => {
    if (h.depth === 2) {
      h2Count++;
      h3Count = 0;
      return { ...h, number: `${h2Count}. ` };
    } else {
      h3Count++;
      return { ...h, number: `${h2Count}.${h3Count} ` };
    }
  });

const hasToc = numberedHeadings.length > 0;

// Obtener tours relacionados de la colección 'tours'
const allTours = await getCollection('tours');
const langTours = allTours.filter((t) => t.id.startsWith(`${lang}/`));

const relatedSlugs = blog.relatedTours && blog.relatedTours.length > 0
  ? blog.relatedTours
  : ['machu-picchu-full-day-tour', 'cusco-machu-picchu-3d-2n', 'trekking-montana-7-colores'];

const matchedTours = relatedSlugs
  .map((slugOrId: string) => {
    return langTours.find((t) => t.id.endsWith(`/${slugOrId}`) || t.id.includes(slugOrId));
  })
  .filter(Boolean)
  .slice(0, 3);

// Artículos relacionados (del mismo idioma, excluyendo el actual)
const allPostsList = getBlogList(lang);
const relatedPosts = allPostsList
  .filter((p) => p.slug !== slug)
  .slice(0, 3);

const siteBase = Astro.site ?? new URL('https://www.perubeyond.com');
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const ogImageAbs = blog.heroImage?.startsWith('http')
  ? blog.heroImage
  : new URL(blog.heroImage || '/images/PeruBeyond/Logo.webp', siteBase).href;

const updatedText = {
  es: `Actualizado en ${blog.updatedDate || 'Octubre 2026'}`,
  en: `Updated on ${blog.updatedDate || 'October 2026'}`,
  pt: `Atualizado em ${blog.updatedDate || 'Outubro 2026'}`,
}[lang];

const tocTitle = {
  es: 'Tabla de Contenidos',
  en: 'Table of Contents',
  pt: 'Tabela de Conteúdo',
}[lang];

const relatedToursTitle = {
  es: 'Vive esta Aventura con Peru Beyond',
  en: 'Experience This Adventure with Peru Beyond',
  pt: 'Viva Esta Aventura com a Peru Beyond',
}[lang];

const relatedPostsTitle = {
  es: 'Artículos Relacionados',
  en: 'Related Articles',
  pt: 'Artigos Relacionados',
}[lang];

const faqsTitle = {
  es: 'Preguntas Frecuentes',
  en: 'Frequently Asked Questions',
  pt: 'Perguntas Frequentes',
}[lang];

// Schema JSON-LD BlogPosting
const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': blog.title,
  'description': blog.description || blog.excerpt || '',
  'image': ogImageAbs,
  'datePublished': blog.pubDate || blog.date || '2026-10-26',
  'dateModified': blog.updatedDate || '2026-10-26',
  'author': {
    '@type': 'Person',
    'name': blog.author || 'Peru Beyond Team',
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Peru Beyond',
    'logo': {
      '@type': 'ImageObject',
      'url': `${siteBase.origin}/images/PeruBeyond/Logo.webp`,
    },
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonicalURL.href,
  },
  'keywords': blog.targetKeyword || blog.keywords || '',
};

// Schema JSON-LD FAQPage
const faqSchema = blog.faqs && blog.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': blog.faqs.map((f: any) => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer,
    },
  })),
} : null;

// Schema JSON-LD BreadcrumbList
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': t['blog.home'] || 'Inicio',
      'item': `${siteBase.origin}/${lang}`,
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Blog',
      'item': `${siteBase.origin}/${lang}/blog`,
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': blog.category,
      'item': `${siteBase.origin}/${lang}/blog`,
    },
    {
      '@type': 'ListItem',
      'position': 4,
      'name': blog.title,
      'item': canonicalURL.href,
    },
  ],
};
---

<Layout
  title={`${blog.title} | Peru Beyond`}
  description={blog.description || blog.excerpt || blog.title}
  ogImage={blog.heroImage}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Header lang={lang} />

  <main class="bg-[#faf8f5] min-h-screen text-slate-800 antialiased selection:bg-[#f6d06a] selection:text-slate-900">

    <!-- ── Hero Editorial ── -->
    <header class="relative bg-slate-950 text-white pt-28 pb-16 overflow-hidden">
      <!-- Fondo difuminado + Hero Image -->
      <div class="absolute inset-0 z-0">
        <img
          src={blog.heroImage}
          alt={blog.title}
          class="w-full h-full object-cover object-center opacity-40 filter brightness-75 scale-105 transform duration-700 ease-out"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0D1B2E] via-[#0D1B2E]/70 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6">
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs text-white/70 mb-4 flex-wrap" aria-label="Breadcrumb">
          <a href={`/${lang}`} class="hover:text-[#f6d06a] transition-colors">{t['blog.home'] || 'Inicio'}</a>
          <span class="text-white/40">›</span>
          <a href={`/${lang}/blog`} class="hover:text-[#f6d06a] transition-colors">Blog</a>
          <span class="text-white/40">›</span>
          <span class="text-white/90 font-medium truncate max-w-xs">{blog.category}</span>
        </nav>

        <!-- Category Badge -->
        <div class="mb-4">
          <span class="inline-block px-3 py-1 rounded bg-[#c9a84c] text-slate-950 text-xs font-bold uppercase tracking-wider shadow">
            {blog.category}
          </span>
        </div>

        <!-- Title H1 -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-white tracking-tight leading-tight mb-6 max-w-4xl drop-shadow-md">
          {blog.title}
        </h1>

        <!-- Editorial Meta Row -->
        <div class="flex flex-wrap items-center gap-y-3 gap-x-6 text-xs sm:text-sm text-white/80 pb-6 border-b border-white/15">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#c9a84c] to-[#f6d06a] text-slate-950 font-bold flex items-center justify-center text-xs shadow">
              {(blog.author || 'PB').charAt(0)}
            </div>
            <div>
              <span class="text-white/50 text-[11px] block">{t['blog.by'] || 'Por'}</span>
              <span class="font-semibold text-white">{blog.author || 'Peru Beyond'}</span>
            </div>
          </div>

          <div class="flex items-center gap-1.5 text-amber-300 font-medium">
            <i class="bi bi-clock-history"></i>
            <span>{updatedText}</span>
          </div>

          <div class="flex items-center gap-1.5 text-white/70">
            <i class="bi bi-book"></i>
            <span>{blog.readingTime || blog.readTime || '10 min de lectura'}</span>
          </div>

          <!-- Share buttons -->
          <div class="ml-auto flex items-center gap-2">
            <span class="text-xs uppercase font-semibold text-white/50 mr-1 hidden sm:inline">{t['blog.share'] || 'Compartir'}:</span>
            <a
              href={`https://wa.me/?text=${encodeURIComponent(`${blog.title} - ${canonicalURL.href}`)}`}
              target="_blank"
              rel="noopener"
              class="w-8 h-8 rounded-full bg-emerald-600/80 hover:bg-emerald-600 text-white flex items-center justify-center transition-colors shadow"
              title="WhatsApp"
            >
              <i class="bi bi-whatsapp"></i>
            </a>
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalURL.href)}`}
              target="_blank"
              rel="noopener"
              class="w-8 h-8 rounded-full bg-blue-600/80 hover:bg-blue-600 text-white flex items-center justify-center transition-colors shadow"
              title="Facebook"
            >
              <i class="bi bi-facebook"></i>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- ── Contenedor Principal (Grid: Sidebar Sticky TOC + Contenido) ── -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

        <!-- ── SIDEBAR TOC (Escritorio Sticky) ── -->
        {hasToc && (
          <aside class="hidden lg:block lg:col-span-4 w-full min-w-0 sticky top-24 space-y-6">
            <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
              <div class="flex items-center gap-2 pb-3 mb-4 border-b border-slate-100">
                <i class="bi bi-list-nested text-[#c9a84c] text-lg"></i>
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800">
                  {tocTitle}
                </h2>
              </div>
              <nav class="space-y-1.5 text-xs max-h-[70vh] overflow-y-auto pr-2 custom-scrollbar">
                {numberedHeadings.map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class={`block py-1.5 px-2.5 rounded-lg transition-colors leading-snug ${
                      h.depth === 2
                        ? 'font-bold text-slate-800 hover:bg-amber-50 hover:text-[#9a7625]'
                        : 'pl-6 text-slate-500 hover:text-slate-800 hover:bg-slate-50'
                    }`}
                  >
                    <span class="text-[#c9a84c] font-semibold mr-1">{h.number}</span>
                    {h.text}
                  </a>
                ))}
                {blog.faqs && blog.faqs.length > 0 && (
                  <a
                    href="#faqs-section"
                    class="block py-1.5 px-2.5 rounded-lg font-bold text-slate-800 hover:bg-amber-50 hover:text-[#9a7625] transition-colors"
                  >
                    <span class="text-[#c9a84c] font-semibold mr-1">★ </span>
                    {faqsTitle}
                  </a>
                )}
              </nav>
            </div>

            <!-- Mini CTA en sidebar -->
            <div class="bg-gradient-to-br from-[#0D1B2E] to-[#152843] rounded-2xl p-5 text-white shadow-lg border border-slate-800">
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#f6d06a]">Peru Beyond Travel</span>
              <h4 class="text-base font-bold mt-1 mb-2">¿Planeando tu viaje a Perú?</h4>
              <p class="text-xs text-slate-300 mb-4 leading-relaxed">
                Asesoría 100% personalizada por guías locales en español, inglés y portugués.
              </p>
              <a
                href="https://wa.me/51943491959"
                target="_blank"
                rel="noopener"
                class="w-full py-2 px-3 rounded-xl bg-gradient-to-r from-[#c9a84c] to-[#f6d06a] hover:from-[#d8b556] hover:to-[#fae086] text-slate-950 font-bold text-xs tracking-wide inline-flex items-center justify-center gap-2 transition-all shadow"
              >
                <i class="bi bi-whatsapp"></i> Hablar con un Experto
              </a>
            </div>
          </aside>
        )}

        <!-- ── ARTÍCULO PRINCIPAL ── -->
        <article class:list={[
          "w-full min-w-0 bg-white rounded-3xl p-6 sm:p-10 md:p-12 border border-slate-200/80 shadow-sm",
          hasToc ? "lg:col-span-8" : "lg:col-span-12"
        ]}>

          <!-- TOC Colapsable en Móvil -->
          {hasToc && (
            <div class="block lg:hidden mb-8">
              <details class="bg-amber-50/60 border border-amber-200/80 rounded-2xl p-4">
                <summary class="font-bold text-sm text-slate-900 cursor-pointer flex items-center justify-between">
                  <span class="flex items-center gap-2">
                    <i class="bi bi-list-nested text-[#c9a84c]"></i>
                    {tocTitle}
                  </span>
                  <span class="text-xs text-[#9a7625] font-semibold">Mostrar / Ocultar</span>
                </summary>
                <nav class="mt-3 pt-3 border-t border-amber-200/60 space-y-1.5 text-xs">
                  {numberedHeadings.map((h) => (
                    <a
                      href={`#${h.slug}`}
                      class={`block py-1 ${
                        h.depth === 2
                          ? 'font-bold text-slate-900'
                          : 'pl-4 text-slate-600'
                      }`}
                    >
                      <span class="text-[#c9a84c] mr-1">{h.number}</span>
                      {h.text}
                    </a>
                  ))}
                </nav>
              </details>
            </div>
          )}

          <!-- Quick Stats / Trail Stats Summary Card (Estilo Salkantay Trekking) -->
          {blog.quickStats && (
            <section class="mb-10 bg-gradient-to-br from-[#fbf9f4] to-[#f5eedf] border border-[#e8d9b0] rounded-2xl p-6 shadow-sm">
              <div class="flex items-center gap-2 pb-3 mb-4 border-b border-[#e5d5a7]">
                <i class="bi bi-card-checklist text-xl text-[#9a7625]"></i>
                <h3 class="font-serif text-lg font-bold text-[#1a1208]">
                  {lang === 'pt' ? 'Resumo da Rota · Ficha Técnica' : lang === 'en' ? 'Trail Stats · At a Glance' : 'Ficha Técnica · Resumen de la Ruta'}
                </h3>
              </div>

              <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs">
                {typeof blog.quickStats === 'object' && !Array.isArray(blog.quickStats) ? (
                  Object.entries(blog.quickStats).map(([key, val]) => (
                    <div class="bg-white/80 p-3 rounded-xl border border-[#ece0c3]">
                      <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-0.5">
                        {key === 'duracion' ? '⏱️ Duración' :
                         key === 'altitud' ? '⛰️ Altitud Máx.' :
                         key === 'dificultad' ? '⚡ Dificultad' :
                         key === 'mejorEpoca' ? '☀️ Mejor Época' :
                         key === 'ubicacion' ? '📍 Ubicación' :
                         key === 'precio' ? '🎟️ Precio / Entradas' : key}
                      </span>
                      <span class="font-bold text-slate-900 text-sm">{val}</span>
                    </div>
                  ))
                ) : Array.isArray(blog.quickStats) ? (
                  blog.quickStats.map((item: any) => (
                    <div class="bg-white/80 p-3 rounded-xl border border-[#ece0c3]">
                      <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-0.5">
                        {item.label}
                      </span>
                      <span class="font-bold text-slate-900 text-sm">{item.value}</span>
                    </div>
                  ))
                ) : null}
              </div>
            </section>
          )}

          <!-- Contenido Renderizado: Markdown o Secciones -->
          {Content ? (
            <div class="prose-blog w-full">
              <Content />
            </div>
          ) : (
            <div class="space-y-8 w-full">
              {blog.sections?.map((section: any, idx: number) => (
                <div id={`seccion-${idx + 1}`} class="scroll-mt-24 space-y-4">
                  {section.heading && (
                    <h2 class="text-2xl font-serif font-bold text-slate-900 border-l-4 border-[#c9a84c] pl-3.5 py-0.5 mt-8 mb-4">
                      {section.heading}
                    </h2>
                  )}
                  {section.paragraphs?.map((p: string) => (
                    <p class="text-slate-700 leading-relaxed text-base sm:text-lg font-normal mb-4">
                      {p}
                    </p>
                  ))}
                  {section.highlight && (
                    <blockquote class="bg-amber-50/70 border-l-4 border-[#c9a84c] p-4 sm:p-5 rounded-r-xl my-6 text-slate-800 font-serif italic text-base">
                      {section.highlight}
                    </blockquote>
                  )}
                  {section.image && (
                    <figure class="my-6 rounded-2xl overflow-hidden shadow-md">
                      <img src={section.image} alt={section.imageCaption || ''} class="w-full h-auto object-cover max-h-[460px]" loading="lazy" />
                      {section.imageCaption && (
                        <figcaption class="p-3 bg-slate-50 text-center text-xs text-slate-500 italic border-t border-slate-100">
                          {section.imageCaption}
                        </figcaption>
                      )}
                    </figure>
                  )}
                </div>
              ))}

              {blog.tips && blog.tips.length > 0 && (
                <div class="bg-amber-50/80 border border-amber-200/80 rounded-2xl p-6 my-8">
                  <h3 class="font-bold text-slate-900 mb-3 flex items-center gap-2">
                    <i class="bi bi-lightbulb-fill text-amber-500"></i>
                    {t['blog.tips_heading'] || 'Consejos para el Viajero'}
                  </h3>
                  <ul class="space-y-2 text-sm text-slate-700">
                    {blog.tips.map((tip: string) => (
                      <li class="flex items-start gap-2">
                        <i class="bi bi-check2 text-emerald-600 font-bold mt-0.5"></i>
                        <span>{tip}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {blog.conclusion && (
                <div class="mt-8 pt-6 border-t border-slate-200 text-slate-800 text-base leading-relaxed italic">
                  <p>{blog.conclusion}</p>
                </div>
              )}
            </div>
          )}

          <!-- In-Content CTA Banner -->
          <div class="my-12 p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-[#0D1B2E] via-[#152843] to-[#0D1B2E] text-white shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="space-y-2 text-center sm:text-left">
              <span class="text-xs font-bold uppercase tracking-wider text-[#f6d06a]">¿Listo para vivirlo en persona?</span>
              <h3 class="text-xl sm:text-2xl font-serif font-bold text-white">
                Reserva tu experiencia garantizada con Peru Beyond
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 max-w-lg">
                Boletos oficiales, traslados privados, guías certificados y asistencia 24/7 en español, inglés y portugués.
              </p>
            </div>
            <a
              href="https://wa.me/51943491959?text=Hola,%20leí%20su%20guía%20y%20deseo%20organizar%20mi%20viaje%20a%20Perú"
              target="_blank"
              rel="noopener"
              class="px-6 py-3 rounded-2xl bg-gradient-to-r from-[#c9a84c] to-[#f6d06a] hover:from-[#d8b556] hover:to-[#fae086] text-slate-950 font-bold text-sm tracking-wide shadow-lg inline-flex items-center gap-2 flex-shrink-0 transition-transform transform hover:-translate-y-0.5"
            >
              <i class="bi bi-whatsapp text-lg"></i>
              <span>Consultar por WhatsApp</span>
            </a>
          </div>

          <!-- Acordeón de FAQs -->
          {blog.faqs && blog.faqs.length > 0 && (
            <section id="faqs-section" class="my-12 scroll-mt-24 pt-8 border-t border-slate-200">
              <div class="flex items-center gap-2 mb-6">
                <i class="bi bi-question-circle-fill text-[#c9a84c] text-2xl"></i>
                <h2 class="text-2xl font-serif font-bold text-slate-900">
                  {faqsTitle}
                </h2>
              </div>

              <div class="space-y-3">
                {blog.faqs.map((faq: any, idx: number) => (
                  <details class="group bg-slate-50 border border-slate-200/80 rounded-2xl overflow-hidden transition-all duration-200 hover:border-[#c9a84c]/50">
                    <summary class="flex items-center justify-between p-4 sm:p-5 font-semibold text-sm sm:text-base text-slate-900 cursor-pointer list-none select-none">
                      <span class="flex items-center gap-2.5 pr-4">
                        <span class="w-6 h-6 rounded-full bg-amber-100 text-[#9a7625] text-xs font-bold flex items-center justify-center flex-shrink-0">
                          {idx + 1}
                        </span>
                        {faq.question}
                      </span>
                      <i class="bi bi-chevron-down text-slate-400 group-open:rotate-180 transition-transform duration-200"></i>
                    </summary>
                    <div class="px-5 pb-5 pt-1 text-slate-600 text-sm leading-relaxed border-t border-slate-100 bg-white">
                      {faq.answer}
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )}

          <!-- Categorías para explorar -->
          <div class="mt-12 pt-8 border-t border-slate-200">
            <BlogCategories lang={lang} current={categorySlug} mode="links" />
          </div>

        </article>
      </div>

      <!-- ── BLOQUE DE TOURS RELACIONADOS (CONVERSIÓN DIRECTA) ── -->
      {matchedTours.length > 0 && (
        <section class="mt-16 pt-12 border-t border-slate-200">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-xs font-bold uppercase tracking-widest text-[#c9a84c]">{t['blog.home'] || 'Peru Beyond'}</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 mt-1">
              {relatedToursTitle}
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-2">
              Tours diseñados por locales para que disfrutes cada rincón sin preocupaciones de logística ni entradas.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {matchedTours.map((tItem: any) => {
              const parts = tItem.id.split('/');
              const cat = parts[1];
              const tSlug = parts.slice(2).join('/');
              const tourUrl = `/${lang}/tours/${cat}/${tSlug}`;
              return (
                <div class="bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col group">
                  <div class="relative h-48 overflow-hidden">
                    <img
                      src={tItem.data.image}
                      alt={tItem.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-slate-950/80 text-white font-bold text-xs backdrop-blur-sm">
                      {tItem.data.price}
                    </div>
                    {tItem.data.duration && (
                      <div class="absolute bottom-3 left-3 px-2.5 py-1 rounded-full bg-black/60 text-white text-[11px] backdrop-blur-sm flex items-center gap-1">
                        <i class="bi bi-clock"></i> {tItem.data.duration}
                      </div>
                    )}
                  </div>
                  <div class="p-5 flex-1 flex flex-col justify-between">
                    <div>
                      <h3 class="font-bold text-slate-900 text-base group-hover:text-[#9a7625] transition-colors leading-snug line-clamp-2">
                        {tItem.data.title}
                      </h3>
                      {tItem.data.difficulty && (
                        <p class="text-xs text-slate-400 mt-2 flex items-center gap-1">
                          <i class="bi bi-activity text-[#c9a84c]"></i>
                          Dificultad: <span class="font-medium text-slate-600">{tItem.data.difficulty}</span>
                        </p>
                      )}
                    </div>
                    <a
                      href={tourUrl}
                      class="mt-4 w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-[#c9a84c] text-white hover:text-slate-950 text-xs font-bold text-center transition-colors inline-flex items-center justify-center gap-1.5"
                    >
                      <span>Ver Detalles del Tour</span>
                      <i class="bi bi-arrow-right"></i>
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      )}

      <!-- ── BLOQUE DE ARTÍCULOS RELACIONADOS ── -->
      {relatedPosts.length > 0 && (
        <section class="mt-16 pt-12 border-t border-slate-200">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-xl sm:text-2xl font-serif font-bold text-slate-900">
              {relatedPostsTitle}
            </h2>
            <a href={`/${lang}/blog`} class="text-xs font-bold text-[#9a7625] hover:underline flex items-center gap-1">
              Ver todos <i class="bi bi-arrow-right"></i>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
            {relatedPosts.map((p) => (
              <a href={p.href} class="group bg-white rounded-2xl overflow-hidden border border-slate-200/80 hover:shadow-lg transition-all flex flex-col">
                <div class="h-40 overflow-hidden relative">
                  <img src={p.image} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-slate-950/80 text-white text-[10px] font-bold uppercase tracking-wider backdrop-blur-sm">
                    {p.category}
                  </span>
                </div>
                <div class="p-4 flex-1 flex flex-col justify-between">
                  <h3 class="font-bold text-slate-900 text-sm leading-snug group-hover:text-[#9a7625] transition-colors line-clamp-2">
                    {p.title}
                  </h3>
                  <span class="text-[11px] text-slate-400 mt-3 block">{p.date}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>

  </main>

  <Footer lang={lang} />
</Layout>

