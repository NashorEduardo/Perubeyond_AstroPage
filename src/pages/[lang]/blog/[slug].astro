    margin-bottom: 1.1rem;
    border-left: 4px solid #c9a84c;
    padding-left: 0.85rem;
    scroll-margin-top: 6rem;
    line-height: 1.35;
  }
  .prose-blog h3 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #1e293b;
