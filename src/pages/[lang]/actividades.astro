---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { imageAlts } from '../../i18n/imageAlts';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}
const { lang } = Astro.params as { lang: 'es' | 'en' | 'pt' };

const piscoHighlights = [
  'Historia del Pisco Sour: origen en Lima, años 1920',
  'Ingredientes clave: pisco, limón, clara de huevo y almíbar',
  'Demostración profesional por bartender experto',
  'Prepara tu propio cóctel: sencillo, doble o "Catedral"',
  'Degustación de variedades de piscos peruanos',
  'Sesión de preguntas y respuestas al final',
];

const toritosExperience = [
  'Conocer la historia y el significado del Torito de Pucará',
  'Aprender técnicas básicas de pintura artesanal',
  'Decorar tu propio torito con colores y diseños personalizados',
  'Llevarte una pieza creada por ti como recuerdo especial',
];

const toritosSymbols = [
  { label: 'Protección', desc: 'del hogar',          icon: 'bi-shield-check' },
  { label: 'Prosperidad', desc: 'y abundancia',       icon: 'bi-stars'        },
  { label: 'Fertilidad', desc: 'y crecimiento',       icon: 'bi-flower1'      },
  { label: 'Conexión',   desc: 'con la cultura andina', icon: 'bi-heart'      },
];
---

<Layout
  title="Actividades Culturales y Gastronómicas | PeruBeyond"
  description="Vive la auténtica cultura peruana con talleres de gastronomía, clases de Pisco Sour y arte andino. Experiencias únicas con PeruBeyond en Cusco."
  lang={lang}
>
  <Header lang={lang} />

  <main class="min-h-screen">

    <!-- ── Hero ── -->
    <section class="act-hero relative flex flex-col items-center justify-center text-center text-white px-4 pt-20">
      <img src="/images/Actividades/Platillo_01.webp" alt={imageAlts.andeanPlate[lang]} class="hero-bg-img" />
      <div class="hero-overlay"></div>
      <div class="relative z-10 max-w-3xl">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-gold mb-4 bg-gold/10 border border-gold/30 px-4 py-1.5 rounded-full">
          Cultura & Gastronomía
        </span>
        <h1 class="act-hero-title">
          Descubre el Perú a través de su <span class="text-gold">Cultura</span>
        </h1>
        <p class="act-hero-sub">
          Talleres gastronómicos, coctelería artesanal y arte andino: experiencias auténticas que conectan con el alma del Perú.
        </p>

        <!-- Stats -->
        <div class="flex items-center justify-center gap-8 mt-8">
          <div class="text-center">
            <span class="text-gold text-3xl font-black block leading-none">3</span>
            <span class="text-white/55 text-xs uppercase tracking-wider mt-1 block">Experiencias</span>
          </div>
          <div class="w-px h-10 bg-white/20"></div>
          <div class="text-center">
            <span class="text-gold text-3xl font-black block leading-none">100%</span>
            <span class="text-white/55 text-xs uppercase tracking-wider mt-1 block">Auténtico</span>
          </div>
          <div class="w-px h-10 bg-white/20"></div>
          <div class="text-center">
            <span class="text-gold text-3xl font-black block leading-none">Cusco</span>
            <span class="text-white/55 text-xs uppercase tracking-wider mt-1 block">Ubicación</span>
          </div>
        </div>

        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-xs text-white/40 mt-8">
          <a href={`/${lang}`} class="hover:text-white transition-colors flex items-center gap-1">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10.707 2.293a1 1 0 0 0-1.414 0l-7 7A1 1 0 0 0 3 11h1v6a1 1 0 0 0 1 1h4v-4h2v4h4a1 1 0 0 0 1-1v-6h1a1 1 0 0 0 .707-1.707l-7-7z"/>
            </svg>
            Inicio
          </a>
          <span class="text-white/20">›</span>
          <span class="text-white/70">Actividades</span>
        </nav>
      </div>
    </section>

    <!-- ── Contenido principal ── -->
    <div class="act-content-bg">
      <div class="max-w-7xl mx-auto px-4 md:px-8 py-16 space-y-28">

        <!-- ══════════════════════════════════════════
             ACTIVIDAD 1 — Clásicos de la Gastronomía
             ══════════════════════════════════════════ -->
        <section id="gastronomia">

          <!-- Header de sección -->
          <div class="flex items-center gap-4 mb-10">
            <div class="w-12 h-12 rounded-2xl bg-amber-500 flex items-center justify-center shadow-lg flex-shrink-0">
              <i class="bi bi-stars text-white text-xl"></i>
            </div>
            <div>
              <h2 class="act-section-title">Clásicos de la Gastronomía Peruana</h2>
              <p class="act-section-sub">Taller gastronómico · 2 horas · Cusco</p>
            </div>
            <div class="flex-1 h-px bg-gray-200 ml-4 hidden sm:block"></div>
          </div>

          <!-- Layout principal: imágenes izq. · texto der. -->
          <div class="grid lg:grid-cols-2 gap-10 items-start mb-12">

            <!-- Imágenes -->
            <div class="grid grid-cols-2 gap-3">
              <img
                src="/images/Actividades/Platillo_01.webp"
                alt={imageAlts.andeanPlate[lang]}
                class="act-img col-span-2 h-72 object-cover rounded-2xl"
                loading="lazy"
              />
              <img
                src="/images/Actividades/Platillo_02.webp"
                alt={imageAlts.grilledMeatDish[lang]}
                class="act-img h-48 object-cover rounded-2xl"
                loading="lazy"
              />
              <div class="bg-amber-50 border border-amber-100 rounded-2xl h-48 flex flex-col items-center justify-center p-6">
                <i class="bi bi-clock text-amber-500 text-3xl mb-2"></i>
                <span class="text-navy font-bold text-xl">2 horas</span>
                <span class="text-gray-400 text-sm text-center mt-1">de experiencia gastronómica</span>
              </div>
            </div>

            <!-- Texto -->
            <div>
              <p class="act-desc mb-4">
                Nuestro evento comienza con una bienvenida seguida de una introducción al pisco, explorando su historia y variedades. Los participantes aprenderán a preparar un auténtico pisco sour bajo la guía de nuestro experto bartender, con la oportunidad de degustar su propia creación.
              </p>
              <p class="act-desc mb-4">
                Continuaremos con un taller práctico de causa limeña, donde cada uno personalizará y preparará su versión de este plato tradicional. La experiencia culminará con una sesión interactiva de cocina para preparar lomo saltado, aprendiendo técnicas de salteado antes de disfrutar del plato que han cocinado.
              </p>
              <p class="act-desc mb-8">
                El evento concluye con una sesión de preguntas y respuestas, proporcionando una oportunidad para discutir lo aprendido y compartir impresiones sobre la experiencia gastronómica.
              </p>
              <div class="flex flex-wrap gap-3">
                <a
                  href={`https://wa.me/51943491959?text=${encodeURIComponent('Hola, me interesa la actividad: Clásicos de la Gastronomía Peruana')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="act-main-cta"
                >
                  <i class="bi bi-whatsapp text-base"></i>
                  Reservar experiencia
                </a>
                <a href={`/${lang}/actividades/gastronomia`} class="act-secondary-cta">
                  Ver página completa
                  <i class="bi bi-arrow-right text-sm"></i>
                </a>
              </div>
            </div>
          </div>

          <!-- Tarjetas de platos -->
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-5">Qué se prepara</p>
            <div class="grid sm:grid-cols-3 gap-5">

              <div class="dish-card">
                <div class="dish-icon bg-amber-100 text-amber-600">
                  <i class="bi bi-layers text-xl"></i>
                </div>
                <h3 class="dish-name">Causita Limeña</h3>
                <p class="dish-desc">Capas de puré de papa amarilla aliñado con sal, pimienta y limón, rellenas de pollo, vegetales o quinua. Un clásico de la gastronomía peruana.</p>
              </div>

              <div class="dish-card">
                <div class="dish-icon bg-red-100 text-red-500">
                  <i class="bi bi-fire text-xl"></i>
                </div>
                <h3 class="dish-name">Lomo Saltado</h3>
                <p class="dish-desc">Carne de lomo fino salteada en wok con cebolla, tomates y ají amarillo, servida sobre papas fritas y acompañada de arroz.</p>
              </div>

              <div class="dish-card">
                <div class="dish-icon bg-yellow-100 text-yellow-600">
                  <i class="bi bi-egg-fried text-xl"></i>
                </div>
                <h3 class="dish-name">Crepe de Quinua y Kiwicha</h3>
                <p class="dish-desc">Delicioso crepe en base de quinua y kiwicha acompañado de crema de durazno o mango.</p>
              </div>

            </div>
          </div>
        </section>

        <div class="act-divider"></div>

        <!-- ══════════════════════════════════════════
             ACTIVIDAD 2 — Making Sour + Pisco Tasting
             ══════════════════════════════════════════ -->
        <section id="pisco">

          <!-- Header de sección -->
          <div class="flex items-center gap-4 mb-10">
            <div class="w-12 h-12 rounded-2xl bg-gold flex items-center justify-center shadow-lg flex-shrink-0">
              <i class="bi bi-cup-straw text-navy text-xl"></i>
            </div>
            <div>
              <h2 class="act-section-title">Making Sour + Pisco Tasting</h2>
              <p class="act-section-sub">Coctelería artesanal · 2–3 horas · Cusco</p>
            </div>
            <div class="flex-1 h-px bg-gray-200 ml-4 hidden sm:block"></div>
          </div>

          <!-- Layout: texto izq. · imagen der. -->
          <div class="grid lg:grid-cols-2 gap-10 items-start">

            <!-- Texto -->
            <div class="order-2 lg:order-1">
              <p class="act-desc mb-4">
                En la clase "Making Sour", los participantes comenzarán con una cálida bienvenida en nuestra ubicación designada. Nuestro experto bartender introducirá la historia del Pisco Sour, destacando su origen en Lima en los años 1920 y cómo se ha convertido en uno de los cócteles más emblemáticos de Perú.
              </p>
              <p class="act-desc mb-6">
                Se explicará a los asistentes los componentes clave del Pisco Sour: pisco, jugo de limón, clara de huevo y almíbar de azúcar. Los participantes tendrán la oportunidad de preparar su propio cóctel eligiendo entre sencillo, doble o "Catedral", y posteriormente compartirán impresiones con el grupo. La actividad cierra con degustación de variedades de piscos peruanos.
              </p>

              <!-- Lista de highlights -->
              <ul class="space-y-3 mb-8">
                {piscoHighlights.map(item => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-gold/20 flex items-center justify-center mt-0.5">
                      <i class="bi bi-check text-gold text-xs font-bold"></i>
                    </span>
                    <span class="text-sm text-gray-600">{item}</span>
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-3">
                <a
                  href={`https://wa.me/51943491959?text=${encodeURIComponent('Hola, me interesa la actividad: Making Sour + Pisco Tasting')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="act-main-cta"
                >
                  <i class="bi bi-whatsapp text-base"></i>
                  Reservar experiencia
                </a>
                <a href={`/${lang}/actividades/pisco`} class="act-secondary-cta">
                  Ver página completa
                  <i class="bi bi-arrow-right text-sm"></i>
                </a>
              </div>
            </div>

            <!-- Imagen -->
            <div class="order-1 lg:order-2">
              <img
                src="/images/Actividades/Pisco.webp"
                alt={imageAlts.piscoSour[lang]}
                class="act-img w-full h-[460px] object-cover rounded-2xl"
                loading="lazy"
              />
            </div>
          </div>
        </section>

        <div class="act-divider"></div>

        <!-- ══════════════════════════════════════════
             ACTIVIDAD 3 — Pintado de Toritos de Pucará
             ══════════════════════════════════════════ -->
        <section id="toritos">

          <!-- Header de sección -->
          <div class="flex items-center gap-4 mb-10">
            <div class="w-12 h-12 rounded-2xl bg-red-500 flex items-center justify-center shadow-lg flex-shrink-0">
              <i class="bi bi-palette text-white text-xl"></i>
            </div>
            <div>
              <h2 class="act-section-title">Pintado de Toritos de Pucará</h2>
              <p class="act-section-sub">Arte & Cultura andina · 1.5–2 horas · Cusco</p>
            </div>
            <div class="flex-1 h-px bg-gray-200 ml-4 hidden sm:block"></div>
          </div>

          <!-- Introducción -->
          <p class="act-desc max-w-3xl mb-10">
            El Torito de Pucará es una de las expresiones más representativas del arte andino peruano. Elaborado en cerámica y decorado a mano, simboliza protección, prosperidad, fertilidad y buena fortuna para los hogares. Esta emblemática artesanía tiene sus raíces en las tradiciones del altiplano peruano y, con el paso del tiempo, se convirtió en un símbolo cultural reconocido en todo el país.
          </p>

          <!-- Galería + Contenido -->
          <div class="grid lg:grid-cols-2 gap-10 items-start">

            <!-- Galería de imágenes -->
            <div class="grid grid-cols-2 gap-2">
              <img src="/images/Actividades/Toritos_01.webp" alt={imageAlts.toritos01[lang]} class="act-img col-span-2 h-64 object-cover rounded-xl" loading="lazy" />
              <img src="/images/Actividades/Toritos_02.webp" alt={imageAlts.toritos02[lang]} class="act-img h-40 object-cover rounded-xl" loading="lazy" />
              <img src="/images/Actividades/Toritos_03.webp" alt={imageAlts.toritos03[lang]} class="act-img h-40 object-cover rounded-xl" loading="lazy" />
              <img src="/images/Actividades/Toritos_04.webp" alt={imageAlts.toritos04[lang]} class="act-img h-40 object-cover rounded-xl" loading="lazy" />
              <img src="/images/Actividades/Toritos_05.webp" alt={imageAlts.toritos05[lang]} class="act-img h-40 object-cover rounded-xl" loading="lazy" />
              <img src="/images/Actividades/Toritos_06.webp" alt={imageAlts.toritos06[lang]} class="act-img h-40 object-cover rounded-xl" loading="lazy" />
              <img src="/images/Actividades/Toritos_07.webp" alt={imageAlts.toritos07[lang]} class="act-img h-40 object-cover rounded-xl" loading="lazy" />
            </div>

            <!-- Contenido -->
            <div>

              <!-- Tu experiencia -->
              <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">Tu experiencia</p>
              <ul class="space-y-3 mb-8">
                {toritosExperience.map(item => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-red-100 flex items-center justify-center mt-0.5">
                      <i class="bi bi-check text-red-500 text-xs font-bold"></i>
                    </span>
                    <span class="text-sm text-gray-600">{item}</span>
                  </li>
                ))}
              </ul>

              <!-- ¿Qué representa? -->
              <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">¿Qué representa?</p>
              <div class="grid grid-cols-2 gap-3 mb-8">
                {toritosSymbols.map(sym => (
                  <div class="symbol-card">
                    <i class={`bi ${sym.icon} text-red-500 text-2xl mb-1`}></i>
                    <span class="font-bold text-navy text-sm">{sym.label}</span>
                    <span class="text-gray-400 text-xs">{sym.desc}</span>
                  </div>
                ))}
              </div>

              <div class="flex flex-wrap gap-3">
                <a
                  href={`https://wa.me/51943491959?text=${encodeURIComponent('Hola, me interesa la actividad: Pintado de Toritos de Pucará')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="act-main-cta"
                >
                  <i class="bi bi-whatsapp text-base"></i>
                  Reservar experiencia
                </a>
                <a href={`/${lang}/actividades/toritos`} class="act-secondary-cta">
                  Ver página completa
                  <i class="bi bi-arrow-right text-sm"></i>
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- ── CTA Banner ── -->
        <section class="act-cta-banner relative overflow-hidden rounded-3xl">
          <img src="/images/Actividades/Platillo_02.webp" alt={imageAlts.grilledMeatDish[lang]} class="absolute inset-0 w-full h-full object-cover object-center" loading="lazy" />
          <div class="absolute inset-0 bg-navy/80"></div>
          <div class="relative z-10 text-center py-16 px-6">
            <span class="text-gold text-xs font-bold uppercase tracking-widest block mb-3">¿Listo para vivir el Perú?</span>
            <h2 class="cta-banner-title">Diseñamos tu experiencia a medida</h2>
            <p class="cta-banner-sub">
              Nuestro equipo te asesora sin costo para combinar las actividades culturales y gastronómicas que más te apasionen.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-4 mt-8">
              <a
                href="https://wa.me/51943491959?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20actividades%20culturales%20y%20gastron%C3%B3micas"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white font-bold text-sm px-6 py-3 rounded-full transition-all shadow-lg hover:-translate-y-0.5"
              >
                <i class="bi bi-whatsapp text-base"></i>
                WhatsApp directo
              </a>
              <a
                href={`/${lang}/contacto`}
                class="inline-flex items-center gap-2 bg-gold hover:bg-yellow-400 text-navy font-bold text-sm px-6 py-3 rounded-full transition-all shadow-lg hover:-translate-y-0.5"
              >
                Consultar ahora
                <i class="bi bi-arrow-right"></i>
              </a>
            </div>
          </div>
        </section>

      </div>
    </div>

  </main>

  <Footer lang={lang} />
</Layout>

<style>
  /* ── Variables ── */
  :root {
    --navy: #0d1b2e;
    --gold:  #f6d06a;
  }

  /* ── Hero ── */
  .act-hero {
    height: 70vh;
    min-height: 560px;
    overflow: hidden;
  }
  .hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(13,27,46,0.55) 0%, rgba(13,27,46,0.80) 100%);
  }
  .act-hero-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 1rem;
    text-shadow: 0 2px 24px rgba(0,0,0,0.45);
  }
  .act-hero-sub {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.72);
    line-height: 1.65;
    max-width: 560px;
    margin: 0 auto;
  }

  /* ── Fondo general ── */
  .act-content-bg {
    background-color: #f8f6f3;
  }

  /* ── Encabezados de sección ── */
  .act-section-title {
    font-family: Georgia, serif;
    font-size: 1.65rem;
    font-weight: 800;
    color: #0d1b2e;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }
  .act-section-sub {
    font-size: 0.8rem;
    color: #9ca3af;
    font-weight: 500;
    margin-top: 0.25rem;
  }

  /* ── Texto descriptivo ── */
  .act-desc {
    font-size: 0.9rem;
    color: #4b5563;
    line-height: 1.75;
  }

  /* ── Imágenes ── */
  .act-img {
    transition: transform 0.4s ease;
  }
  .act-img:hover {
    transform: scale(1.02);
  }

  /* ── Botón secundario ── */
  .act-secondary-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: #0d1b2e;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.7rem 1.5rem;
    border-radius: 9999px;
    border: 2px solid #0d1b2e;
    letter-spacing: 0.04em;
    transition: background 0.2s, color 0.2s, transform 0.2s;
    text-decoration: none;
  }
  .act-secondary-cta:hover {
    background: #0d1b2e;
    color: #f6d06a;
    transform: translateY(-2px);
  }

  /* ── Botón CTA principal ── */
  .act-main-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #0d1b2e;
    color: #f6d06a;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.7rem 1.5rem;
    border-radius: 9999px;
    letter-spacing: 0.04em;
    transition: background 0.2s, color 0.2s, transform 0.2s;
    text-decoration: none;
  }
  .act-main-cta:hover {
    background: #c9a84c;
    color: #0d1b2e;
    transform: translateY(-2px);
  }

  /* ── Tarjetas de platos ── */
  .dish-card {
    background: #ffffff;
    border-radius: 1.25rem;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .dish-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(0,0,0,0.12);
  }
  .dish-icon {
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.25rem;
  }
  .dish-name {
    font-family: Georgia, serif;
    font-size: 1rem;
    font-weight: 700;
    color: #0d1b2e;
  }
  .dish-desc {
    font-size: 0.8rem;
    color: #6b7280;
    line-height: 1.65;
  }

  /* ── Tarjetas de símbolos (Toritos) ── */
  .symbol-card {
    background: #ffffff;
    border-radius: 1rem;
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid #fde8e8;
  }

