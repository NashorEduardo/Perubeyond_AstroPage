<!-- Carrusel y FAQ scripts -->
<script>
  // ── CARRUSEL ──
  const track = document.getElementById('carousel-track');
  const dots = document.querySelectorAll('.carousel-dot');
  let currentSlide = 0;

  function getSlideWidth() {
    const slide = document.querySelector('.carousel-slide');
    return slide ? slide.offsetWidth + 24 : 0; // 24 = gap
  }

  function goToSlide(index) {
    if (!track) return;
    const slideWidth = getSlideWidth();
    track.scrollTo({ left: index * slideWidth, behavior: 'smooth' });
    dots.forEach((d, i) => d.classList.toggle('active', i === index));
    currentSlide = index;
  }

  document.getElementById('next-slide')?.addEventListener('click', () => {
    const slides = document.querySelectorAll('.carousel-slide').length;
    goToSlide((currentSlide + 1) % slides);
  });

  document.getElementById('prev-slide')?.addEventListener('click', () => {
    const slides = document.querySelectorAll('.carousel-slide').length;
    goToSlide((currentSlide - 1 + slides) % slides);
  });

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => goToSlide(i));
  });

  // Sincronizar dots al hacer scroll manual
  track?.addEventListener('scroll', () => {
    const slideWidth = getSlideWidth();
    if (!slideWidth) return;
    const newIndex = Math.round((track.scrollLeft) / slideWidth);
    if (newIndex !== currentSlide) {
      currentSlide = newIndex;
      dots.forEach((d, i) => d.classList.toggle('active', i === newIndex));
    }
  });

  // ── FAQ ACCORDION ──
  (window as any).toggleFaq = function(index: number) {
    const item = document.querySelector(`.faq-item[data-index="${index}"]`);
    const answer = item?.querySelector('.faq-answer') as HTMLElement | null;
    const chevron = item?.querySelector('.faq-chevron') as HTMLElement | null;
    const isOpen = item?.classList.contains('open');
    
    // Cerrar todos
    document.querySelectorAll('.faq-item').forEach(el => {
      el.classList.remove('open');
      const a = el.querySelector('.faq-answer') as HTMLElement | null;
      const c = el.querySelector('.faq-chevron') as HTMLElement | null;
      if (a) a.style.maxHeight = '0';
      if (c) c.style.transform = 'rotate(0deg)';
    });
    
    // Abrir el actual si estaba cerrado
    if (!isOpen && item && answer && chevron) {
      item.classList.add('open');
      answer.style.maxHeight = answer.scrollHeight + 'px';
      chevron.style.transform = 'rotate(180deg)';
    }
  };
</script>

