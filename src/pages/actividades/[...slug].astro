---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Testimonials from '../../components/Testimonials.astro';

export async function getStaticPaths() {
  const allEntries = await getCollection('tours');
  const paths = [];
  for (const entry of allEntries) {
    const parts = entry.id.split('/');
    const lang = parts[0];
    const slug = parts.slice(1).join('/');
    if (!slug.startsWith('actividades/')) continue;
    const actSlug = slug.replace('actividades/', '');
    if (lang === 'es') {
      paths.push({ params: { slug: actSlug }, props: { entry } });
    }
    paths.push({ params: { slug: `${lang}/${actSlug}` }, props: { entry } });
  }
  return paths;
}

const slugParam = Astro.params.slug ?? '';
let lang = 'es';
if (slugParam.startsWith('en/') || slugParam.startsWith('pt/')) {
  lang = slugParam.split('/')[0];
}

const { entry } = Astro.props;
const {
  title, image, price, duration, description,
  availability, frequency, difficulty,
  includes, excludes, itinerary, gallery, faq, wetravelUuid,
} = entry.data;
const { Content } = await render(entry);

const actIcon = "🎨";
const itineraryImages = [
  "/itinerario/CUZCO/cusco03.webp",
  "/itinerario/CUZCO/cusco07.webp",
  image,
];
---

<Layout
  title={`${title} – Peru Beyond`}
  description={description ?? 'Vive la experiencia artística y cultural en Cusco con Peru Beyond.'}
  ogImage={image}
>
  <Header />

  <!-- ═══════════════════════════════════
        HERO: IMAGEN OSCURA + LAYOUT 2 COLUMNAS
  ═══════════════════════════════════ -->
  <section class="relative min-h-[92vh] flex items-center overflow-hidden pt-24">

    <!-- FONDO: imagen oscura y borrosa -->
    <div class="absolute inset-0">
      <img src={image} alt={title} class="w-full h-full object-cover scale-105 blur-sm brightness-[0.35]" />
      <!-- Overlay de color esmeralda suave para darle identidad -->
      <div class="absolute inset-0 bg-gradient-to-br from-emerald-950/60 via-transparent to-teal-900/40"></div>
      <!-- Patrón andino sutil -->
      <div class="absolute inset-0 andean-pattern opacity-[0.06]"></div>
    </div>

    <!-- CONTENIDO: grid 2 columnas -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 py-14">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

        <!-- Columna izquierda: Texto -->
        <div class="lg:col-span-5 flex flex-col justify-center">

          <nav class="flex items-center gap-2 text-white/45 text-xs uppercase tracking-widest mb-6 font-medium">
            <a href="/" class="hover:text-emerald-300 transition-colors">Inicio</a>
            <span>•</span>
            <a href="/actividades" class="hover:text-emerald-300 transition-colors">Experiencias</a>
            <span>•</span>
            <span class="text-white/65 truncate">{title}</span>
          </nav>

          <div class="inline-flex items-center gap-2 bg-emerald-400/15 border border-emerald-300/30 backdrop-blur-sm rounded-full px-4 py-1.5 w-fit mb-5">
            <span class="text-base">{actIcon}</span>
            <span class="text-[10px] font-bold tracking-widest text-emerald-200 uppercase">Arte & Gastronomía Peruana</span>
          </div>

          <h1 class="text-4xl md:text-5xl font-serif text-white leading-[1.1] tracking-tight mb-5 drop-shadow-xl">
            {title}
          </h1>

          <p class="text-white/70 text-base leading-relaxed mb-8 font-light">
            {description}
          </p>

          <!-- Stats en tarjetas glassmorphism -->
          <div class="grid grid-cols-3 gap-3 mb-8">
            <div class="glass-stat-col">
              <span class="stat-col-label">Duración</span>
              <span class="stat-col-value">{duration ?? "2 Horas"}</span>
            </div>
            <div class="glass-stat-col">
              <span class="stat-col-label">Horario</span>
              <span class="stat-col-value">3:00 pm</span>
            </div>
            <div class="glass-stat-col emerald-highlight">
              <span class="stat-col-label">Desde</span>
              <span class="stat-col-value price-em">${price ?? "65"} USD</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#reservar" class="btn-hero-primary text-center">
              ✨ Vivir la experiencia
            </a>
            <a
              href={`https://wa.me/51943491959?text=Hola, me interesa la experiencia de: ${title}`}
              target="_blank"
              class="btn-hero-secondary flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </a>
          </div>
        </div>

        <!-- Columna derecha: composición de imágenes -->
        <div class="lg:col-span-7 grid grid-cols-12 gap-4 relative h-[500px] md:h-[580px]">
          <!-- Imagen principal grande -->
          <div class="col-span-8 h-full rounded-2xl overflow-hidden shadow-2xl shadow-black/40 relative group">
            <img
              src={image}
              alt={title}
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>
            <!-- Badge sobre la imagen principal -->
            <div class="absolute bottom-4 left-4 right-4">
              <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl px-4 py-2.5">
                <p class="text-white text-xs font-semibold">{title}</p>
                <p class="text-emerald-300 text-[10px] tracking-wide">Arte ancestral andino • Cusco, Perú</p>
              </div>
            </div>
          </div>

          <!-- Imágenes secundarias apiladas -->
          <div class="col-span-4 flex flex-col gap-4 h-full">
            <div class="h-[48%] rounded-xl overflow-hidden shadow-xl shadow-black/30 group relative">
              <img
                src="/itinerario/CUZCO/cusco03.webp"
                alt="Taller cultural"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-emerald-900/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="text-white text-xl font-light drop-shadow">＋</span>
              </div>
            </div>
            <div class="h-[48%] rounded-xl overflow-hidden shadow-xl shadow-black/30 group relative">
              <img
                src="/itinerario/CUZCO/cusco07.webp"
                alt="Gastronomía peruana"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-emerald-900/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="text-white text-xl font-light drop-shadow">＋</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Flecha abajo -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 animate-bounce">
      <svg class="w-6 h-6 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
    </div>
  </section>

  <!-- ═══════════════════════════════════
        STICKY NAV
  ═══════════════════════════════════ -->
  <nav class="sticky top-0 z-40 bg-emerald-50/95 backdrop-blur-md border-b border-emerald-200/50 shadow-sm">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center gap-8 h-full overflow-x-auto no-scrollbar">
          <a href="#experiencia" class="nav-link active">La Experiencia</a>
          <a href="#itinerario" class="nav-link">El Taller</a>
          <a href="#detalles" class="nav-link">¿Qué Incluye?</a>
          <a href="#faq" class="nav-link">Preguntas</a>
        </div>
        <a href="#reservar" class="hidden sm:inline-block bg-emerald-600 text-white text-xs font-bold tracking-widest uppercase px-6 py-3 rounded-lg hover:bg-emerald-700 transition-colors shadow-md">
          Reservar Cupo
        </a>
      </div>
    </div>
  </nav>

  <!-- ═══════════════════════════════════
        SECCIÓN: EXPERIENCIA (Alegre e interactiva)
  ═══════════════════════════════════ -->
  <section id="experiencia" class="bg-gradient-to-b from-amber-50 to-orange-50 py-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Encabezado -->
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="inline-block bg-emerald-100 text-emerald-700 text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4">Taller Inmersivo</span>
        <h2 class="text-4xl font-serif-display text-stone-900 mb-4">Más que un recuerdo,<br/>una obra de arte tuya</h2>
        <p class="text-stone-600 text-base leading-relaxed font-light">El Torito de Pucará ha protegido hogares andinos por siglos. Hoy, tú creas el tuyo.</p>
      </div>

      <!-- Tarjetas de experiencia con íconos grandes y colores festivos -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        <div class="exp-card exp-card-orange">
          <div class="exp-icon">🎨</div>
          <h3 class="exp-title">Arte Ancestral</h3>
          <p class="exp-desc">Aprende las técnicas de pintura artesanal andina y los significados de cada color y trazo en la cerámica del altiplano peruano.</p>
        </div>
        <div class="exp-card exp-card-amber">
          <div class="exp-icon">🍽️</div>
          <h3 class="exp-title">Gastronomía en Vivo</h3>
          <p class="exp-desc">Un chef y bartender profesionales preparan lomo saltado, causita limeña y el mejor pisco sour mientras tú pintas tu obra.</p>
        </div>
        <div class="exp-card exp-card-terracota">
          <div class="exp-icon">🏺</div>
          <h3 class="exp-title">Tu Obra para Siempre</h3>
          <p class="exp-desc">Te llevas a casa una pieza de cerámica pintada con tus propias manos: un recuerdo único e irrepetible de tu paso por el Perú.</p>
        </div>
      </div>

      <!-- Bloque descriptivo con imagen lateral -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-amber-900/15 h-[400px]">
          <img src={image} alt={title} class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-amber-900/40 to-transparent"></div>
          <!-- Badge flotante sobre la imagen -->
          <div class="absolute bottom-6 left-6 right-6">
            <div class="bg-white/90 backdrop-blur-sm rounded-2xl p-4 shadow-xl">
              <div class="flex items-center gap-3">
                <span class="text-3xl">🐂</span>
                <div>
                  <p class="font-semibold text-stone-900 text-sm">El Torito de Pucará</p>
                  <p class="text-stone-500 text-xs">Símbolo andino de protección y prosperidad</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div>
          <span class="text-emerald-600 text-xs font-bold uppercase tracking-widest block mb-3">¿Qué representa este símbolo?</span>
          <h3 class="text-3xl font-serif-display text-stone-900 mb-6">Una tradición milenaria en tus manos</h3>
          
          <div class="space-y-5">
            <div class="symbol-card">
              <div class="symbol-icon bg-amber-100 text-amber-600">🏠</div>
              <div>
                <h4 class="font-semibold text-stone-800 text-sm mb-1">Protección del Hogar</h4>
                <p class="text-stone-500 text-sm leading-relaxed">Defensa espiritual contra las adversidades. El torito en el techo del hogar protege a toda la familia.</p>
              </div>
            </div>
            <div class="symbol-card">
              <div class="symbol-icon bg-orange-100 text-orange-600">🌟</div>
              <div>
                <h4 class="font-semibold text-stone-800 text-sm mb-1">Prosperidad & Abundancia</h4>
                <p class="text-stone-500 text-sm leading-relaxed">Atrae la buena fortuna y el éxito. Sus colores vivos son un canto a la alegría andina.</p>
              </div>
            </div>
            <div class="symbol-card">
              <div class="symbol-icon bg-red-100 text-red-600">🏔️</div>
              <div>
                <h4 class="font-semibold text-stone-800 text-sm mb-1">Conexión con el Altiplano</h4>
                <p class="text-stone-500 text-sm leading-relaxed">Originario de Pucará, Puno. Una pieza que conecta directamente con las técnicas milenarias de cerámica andina.</p>
              </div>
            </div>
          </div>

          <div class="mt-8 p-5 bg-white rounded-2xl border border-amber-100 shadow-sm">
            <div class="prose prose-sm text-stone-600 prose-p:leading-relaxed">
              <Content />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
        ITINERARIO COMO CARRUSEL
  ═══════════════════════════════════ -->
  <section id="itinerario" class="bg-gradient-to-br from-emerald-600 via-teal-500 to-cyan-400 py-24 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <span class="inline-block bg-white/20 text-white text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4 backdrop-blur-sm">Tu Tarde en el Taller</span>
        <h2 class="text-4xl font-serif-display text-white drop-shadow-md mb-3">¿Cómo se vive esta experiencia?</h2>
        <p class="text-white/80 text-base font-light">Una tarde perfecta entre arte, historia y la mejor gastronomía peruana.</p>
      </div>

      <!-- Carrusel container -->
      <div class="relative">
        <!-- Track deslizable -->
        <div id="carousel-track" class="flex gap-6 overflow-x-auto snap-x snap-mandatory no-scrollbar pb-4">

          <!-- Slide 1 -->
          <div class="carousel-slide snap-start">
            <div class="slide-image-container">
              <img src="/itinerario/CUZCO/cusco03.webp" alt="Llegada al taller" class="slide-img" />
              <div class="slide-img-overlay"></div>
              <div class="slide-time-badge">3:00 PM</div>
            </div>
            <div class="slide-content">
              <div class="slide-step">Paso 1</div>
              <h3 class="slide-title">Llegada & Bienvenida</h3>
              <p class="slide-desc">Llegas al taller y eres recibido con un auténtico <strong>Pisco Sour</strong> preparado en vivo por nuestro bartender. El ambiente ya huele a cerámica y cultura.</p>
            </div>
          </div>

          <!-- Slide 2 -->
          <div class="carousel-slide snap-start">
            <div class="slide-image-container">
              <img src="/itinerario/CUZCO/cusco07.webp" alt="Historia del Torito" class="slide-img" />
              <div class="slide-img-overlay"></div>
              <div class="slide-time-badge">3:20 PM</div>
            </div>
            <div class="slide-content">
              <div class="slide-step">Paso 2</div>
              <h3 class="slide-title">Historia & Simbolismo</h3>
              <p class="slide-desc">Tu guía bilingüe te sumerge en el origen del Torito de Pucará: su viaje desde el altiplano hasta convertirse en ícono nacional, y el significado de cada color y forma.</p>
            </div>
          </div>

          <!-- Slide 3 -->
          <div class="carousel-slide snap-start">
            <div class="slide-image-container">
              <img src={image} alt="Taller de pintura" class="slide-img" />
              <div class="slide-img-overlay"></div>
              <div class="slide-time-badge">3:45 PM</div>
            </div>
            <div class="slide-content">
              <div class="slide-step">Paso 3</div>
              <h3 class="slide-title">¡Manos a la Obra!</h3>
              <p class="slide-desc">Con pinceles en mano y libertad total, decoras tu propio torito de cerámica. El guía te enseña las técnicas artesanales y te acompaña en cada trazo.</p>
            </div>
          </div>

          <!-- Slide 4 -->
          <div class="carousel-slide snap-start">
            <div class="slide-image-container">
              <img src="/itinerario/CUZCO/cusco03.webp" alt="Gastronomía peruana" class="slide-img" />
              <div class="slide-img-overlay"></div>
              <div class="slide-time-badge">4:30 PM</div>
            </div>
            <div class="slide-content">
              <div class="slide-step">Paso 4</div>
              <h3 class="slide-title">Festín Peruano en Vivo</h3>
              <p class="slide-desc">Mientras tu obra toma forma, el chef prepara <strong>Causita Limeña</strong> y el icónico <strong>Lomo Saltado</strong> en vivo. Arte y gastronomía en perfecta sincronía.</p>
            </div>
          </div>

          <!-- Slide 5 -->
          <div class="carousel-slide snap-start">
            <div class="slide-image-container">
              <img src="/itinerario/CUZCO/cusco07.webp" alt="Tu obra lista" class="slide-img" />
              <div class="slide-img-overlay"></div>
              <div class="slide-time-badge">5:30 PM</div>
            </div>
            <div class="slide-content">
              <div class="slide-step">Paso 5</div>
              <h3 class="slide-title">Tu Obra Lista para Viajar</h3>
              <p class="slide-desc">Empacamos tu torito con cuidado para que llegue sano y salvo a tu hogar. Te vas con las manos llenas de arte y el corazón lleno de Cusco.</p>
            </div>
          </div>

        </div>

        <!-- Botones de navegación del carrusel -->
        <button id="prev-slide" class="carousel-btn carousel-btn-left" aria-label="Anterior">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button id="next-slide" class="carousel-btn carousel-btn-right" aria-label="Siguiente">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>

      <!-- Dots indicadores -->
      <div id="carousel-dots" class="flex justify-center gap-2 mt-8">
        {[0,1,2,3,4].map((i) => (
          <button class={`carousel-dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Ir al paso ${i+1}`}></button>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
        INCLUYE / NO INCLUYE
  ═══════════════════════════════════ -->
  <section id="detalles" class="bg-gradient-to-b from-amber-50 to-white py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-xl mx-auto mb-14">
        <span class="inline-block bg-emerald-100 text-emerald-700 text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4">Todo Detallado</span>
        <h2 class="text-3xl font-serif-display text-stone-900">¿Qué incluye tu experiencia?</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Incluye -->
        <div class="bg-white rounded-3xl p-8 shadow-xl shadow-emerald-900/5 border border-emerald-100">
          <div class="flex items-center gap-3 mb-7">
            <div class="w-10 h-10 bg-emerald-500 rounded-xl flex items-center justify-center shadow-md">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
            <h3 class="font-serif-display text-xl text-stone-900">Todo Incluido</h3>
          </div>
          <ul class="space-y-3">
            {includes && includes.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 w-5 h-5 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">✓</span>
                <span class="text-stone-700 text-sm leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- No incluye -->
        <div class="bg-white rounded-3xl p-8 shadow-xl shadow-stone-900/5 border border-stone-100">
          <div class="flex items-center gap-3 mb-7">
            <div class="w-10 h-10 bg-stone-200 rounded-xl flex items-center justify-center shadow-md">
              <svg class="w-5 h-5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
            </div>
            <h3 class="font-serif-display text-xl text-stone-900">No Incluye</h3>
          </div>
          <ul class="space-y-3">
            {excludes && excludes.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 w-5 h-5 bg-stone-100 text-stone-400 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">✕</span>
                <span class="text-stone-500 text-sm leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>

          <!-- Info adicional -->
          <div class="mt-8 p-4 bg-amber-50 rounded-2xl border border-amber-100">
            <p class="text-amber-800 text-xs leading-relaxed">
              💡 <strong>¿Necesitas transporte?</strong> Podemos indicarte cómo llegar fácilmente desde el centro de Cusco. ¡Pregúntanos!
            </p>
          </div>
        </div>
      </div>
